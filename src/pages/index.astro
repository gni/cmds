---
import '../styles/global.css';
import { COMMANDS } from '../data/commands';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CommandList from '../components/CommandList.astro';
import CommandPalette from '../components/CommandPalette.astro';
import ExportModal from '../components/ExportModal.astro';
import Footer from '../components/Footer.astro';

const totalCount = COMMANDS.length;
const linuxCount = COMMANDS.filter(c => c.platforms.includes('linux') || c.platforms.includes('all')).length;
const macosCount = COMMANDS.filter(c => c.platforms.includes('macos') || c.platforms.includes('all')).length;
const windowsCount = COMMANDS.filter(c => c.platforms.includes('windows') || c.platforms.includes('all')).length;

const baseUrl = import.meta.env.BASE_URL;
const pageTitle = "cmds — terminal commands reference";
const pageDescription = "Curated terminal commands for Linux, macOS, and Windows. Fast lookup, search, and click to copy.";
const siteUrl = "https://cmds.dev";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`.replace('//', '/')} />
  
  <!-- Primary Meta Tags -->
  <title>{pageTitle}</title>
  <meta name="title" content={pageTitle} />
  <meta name="description" content={pageDescription} />
  <meta name="author" content="cmds" />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />

  <!-- Preconnect to Google Fonts for Inter and JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>

<body class="bg-[var(--bg)] text-[var(--text-primary)]">
  <!-- Top Navigation Header -->
  <Header totalCommands={totalCount} />

  <!-- Page Header & Filter -->
  <Hero
    totalCount={totalCount}
    linuxCount={linuxCount}
    macosCount={macosCount}
    windowsCount={windowsCount}
  />

  <!-- Main Documentation Layout -->
  <CommandList />

  <!-- Global Command Palette (Cmd+K / /) -->
  <CommandPalette />

  <!-- Export Modal -->
  <ExportModal />

  <!-- Footer -->
  <Footer />

  <script is:inline>
    // Quick shortcut '/' to focus search input
    window.addEventListener('keydown', (e) => {
      const searchInput = document.getElementById('main-search-input');
      const isInput = document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'TEXTAREA';
      if (e.key === '/' && !isInput && searchInput) {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      }
    });

    // Deep link anchor navigation
    if (window.location.hash) {
      const targetId = window.location.hash.substring(1);
      const entry = document.getElementById(targetId);
      if (entry) {
        setTimeout(() => {
          entry.scrollIntoView({ behavior: 'smooth', block: 'center' });
          entry.classList.add('border-[var(--border-focus)]');
          setTimeout(() => entry.classList.remove('border-[var(--border-focus)]'), 2000);
        }, 150);
      }
    }
  </script>
</body>
</html>
