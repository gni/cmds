---
import { COMMANDS } from '../data/commands';
---

<div
  id="command-palette-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center pt-20 px-4 bg-black/50 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
>
  <div
    id="palette-dialog"
    class="w-full max-w-2xl bg-[var(--brain-surface-primary)] border border-[var(--brain-border-default)] shadow-xl overflow-hidden flex flex-col max-h-[75vh]"
  >
    <!-- Search Bar in Palette -->
    <div class="flex items-center px-4 py-3 border-b border-[var(--brain-border-subtle)] gap-3">
      <input
        id="palette-input"
        type="text"
        placeholder="Type command name, tool, or flag to filter..."
        class="w-full bg-transparent text-[var(--brain-text-primary)] placeholder-[var(--brain-text-tertiary)] text-sm font-mono outline-none border-none"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="px-1.5 py-0.5 text-[10px] font-mono text-[var(--brain-text-tertiary)] border border-[var(--brain-border-subtle)] rounded">
        ESC
      </kbd>
    </div>

    <!-- Quick Scope Filters -->
    <div class="flex items-center gap-2 px-4 py-2 border-b border-[var(--brain-border-subtle)] bg-[var(--brain-surface-secondary)] text-xs font-mono">
      <span class="text-[var(--brain-text-tertiary)]">Filter:</span>
      <button type="button" class="palette-filter-pill active font-medium text-[var(--brain-text-primary)] underline underline-offset-4 cursor-pointer" data-filter="all">All</button>
      <button type="button" class="palette-filter-pill text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] cursor-pointer" data-filter="linux">Linux</button>
      <button type="button" class="palette-filter-pill text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] cursor-pointer" data-filter="macos">macOS</button>
      <button type="button" class="palette-filter-pill text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] cursor-pointer" data-filter="windows">Windows</button>
    </div>

    <!-- Results List -->
    <div id="palette-results-list" class="overflow-y-auto p-1 divide-y divide-[var(--brain-border-subtle)]">
      {COMMANDS.map((cmd, idx) => (
        <div
          class={`palette-item flex items-center justify-between p-3 hover:bg-[var(--brain-surface-secondary)] cursor-pointer transition-colors ${idx === 0 ? 'bg-[var(--brain-surface-secondary)]' : ''}`}
          data-id={cmd.id}
          data-title={cmd.title.toLowerCase()}
          data-description={cmd.description.toLowerCase()}
          data-command={cmd.command}
          data-platforms={JSON.stringify(cmd.platforms)}
          data-tags={JSON.stringify(cmd.tags)}
        >
          <div class="flex-1 min-w-0 pr-3">
            <div class="flex items-baseline gap-2 mb-0.5">
              <span class="text-xs font-medium text-[var(--brain-text-primary)] truncate">
                {cmd.title}
              </span>
              <span class="text-[10px] font-mono text-[var(--brain-text-tertiary)]">
                {cmd.category}
              </span>
            </div>
            <div class="font-mono text-xs text-[var(--brain-text-secondary)] truncate">
              $ {cmd.command}
            </div>
          </div>

          <span class="text-[10px] font-mono text-[var(--brain-text-tertiary)] shrink-0">
            Enter to copy
          </span>
        </div>
      ))}
    </div>

    <!-- Palette Footer -->
    <div class="flex items-center justify-between px-4 py-2 bg-[var(--brain-surface-secondary)] border-t border-[var(--brain-border-subtle)] text-[11px] font-mono text-[var(--brain-text-secondary)]">
      <div class="flex items-center gap-3">
        <span><kbd class="text-[var(--brain-text-primary)]">↑↓</kbd> navigate</span>
        <span><kbd class="text-[var(--brain-text-primary)]">↵</kbd> copy</span>
        <span><kbd class="text-[var(--brain-text-primary)]">esc</kbd> close</span>
      </div>
      <div class="text-[var(--brain-text-tertiary)]">
        loop.brain.fr/cmds
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const modal = document.getElementById('command-palette-modal');
    const input = document.getElementById('palette-input');
    const filterPills = document.querySelectorAll('.palette-filter-pill');
    let items = Array.from(document.querySelectorAll('.palette-item'));
    let activeIndex = 0;
    let currentFilter = 'all';

    function openPalette() {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => {
        input?.focus();
        input?.select();
      }, 30);
      filterPalette();
    }

    function closePalette() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    window.openPalette = openPalette;
    window.closePalette = closePalette;

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal && !modal.classList.contains('hidden')) {
          closePalette();
        } else {
          openPalette();
        }
      } else if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closePalette();
      }
    });

    document.getElementById('header-palette-btn')?.addEventListener('click', openPalette);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closePalette();
      }
    });

    function filterPalette() {
      const q = (input?.value || '').toLowerCase().trim();
      items.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-description') || '';
        const cmd = item.getAttribute('data-command') || '';
        const tags = item.getAttribute('data-tags') || '';
        const platforms = JSON.parse(item.getAttribute('data-platforms') || '[]');

        const matchQuery = !q || title.includes(q) || desc.includes(q) || cmd.includes(q) || tags.includes(q);
        const matchPlatform = currentFilter === 'all' || platforms.includes('all') || platforms.includes(currentFilter);

        if (matchQuery && matchPlatform) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });

      const visibleItems = items.filter(el => !el.classList.contains('hidden'));
      items.forEach(el => el.classList.remove('bg-[var(--brain-surface-secondary)]'));
      activeIndex = 0;
      if (visibleItems[0]) {
        visibleItems[0].classList.add('bg-[var(--brain-surface-secondary)]');
      }
    }

    input?.addEventListener('input', filterPalette);

    input?.addEventListener('keydown', (e) => {
      const visibleItems = items.filter(el => !el.classList.contains('hidden'));
      if (visibleItems.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        visibleItems[activeIndex]?.classList.remove('bg-[var(--brain-surface-secondary)]');
        activeIndex = (activeIndex + 1) % visibleItems.length;
        visibleItems[activeIndex]?.classList.add('bg-[var(--brain-surface-secondary)]');
        visibleItems[activeIndex]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        visibleItems[activeIndex]?.classList.remove('bg-[var(--brain-surface-secondary)]');
        activeIndex = (activeIndex - 1 + visibleItems.length) % visibleItems.length;
        visibleItems[activeIndex]?.classList.add('bg-[var(--brain-surface-secondary)]');
        visibleItems[activeIndex]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const selected = visibleItems[activeIndex];
        if (selected) {
          const cmd = selected.getAttribute('data-command') || '';
          navigator.clipboard.writeText(cmd).then(() => {
            closePalette();
            window.showToast?.('Copied to clipboard', cmd);
            const id = selected.getAttribute('data-id');
            const row = document.getElementById(`row-${id}`);
            if (row) {
              row.click();
              row.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          });
        }
      }
    });

    items.forEach(item => {
      item.addEventListener('click', () => {
        const cmd = item.getAttribute('data-command') || '';
        navigator.clipboard.writeText(cmd).then(() => {
          closePalette();
          window.showToast?.('Copied to clipboard', cmd);
          const id = item.getAttribute('data-id');
          const row = document.getElementById(`row-${id}`);
          if (row) {
            row.click();
            row.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });
    });

    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => {
          p.classList.remove('active', 'font-medium', 'text-[var(--brain-text-primary)]', 'underline', 'underline-offset-4');
          p.classList.add('text-[var(--brain-text-secondary)]');
        });
        pill.classList.add('active', 'font-medium', 'text-[var(--brain-text-primary)]', 'underline', 'underline-offset-4');
        pill.classList.remove('text-[var(--brain-text-secondary)]');
        currentFilter = pill.getAttribute('data-filter') || 'all';
        filterPalette();
      });
    });
  })();
</script>
