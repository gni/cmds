---
import { COMMANDS } from '../data/commands';
import type { CommandParam } from '../data/types';

function resolveCommandDefaults(template: string, params?: CommandParam[]): string {
  return template.replace(/\{\{([^}]+)\}\}/g, (_, name) => {
    const p = params?.find(param => param.name === name);
    return p?.default || p?.placeholder || name;
  });
}
---

<div
  id="command-palette-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center pt-20 px-4 bg-black/60 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
>
  <div
    id="palette-dialog"
    class="w-full max-w-2xl bg-[var(--bg)] border border-[var(--border)] shadow-2xl rounded-lg overflow-hidden flex flex-col max-h-[75vh]"
  >
    <!-- Search Bar in Palette -->
    <div class="flex items-center px-4 py-3 border-b border-[var(--border)] gap-3">
      <svg class="w-4 h-4 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="palette-input"
        type="text"
        placeholder="Type command name, tool, or flag to filter..."
        class="w-full bg-transparent text-[var(--text-primary)] placeholder-[var(--text-muted)] text-sm font-mono outline-none border-none"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="px-1.5 py-0.5 text-[10px] font-mono text-[var(--text-muted)] border border-[var(--border)] rounded bg-[var(--bg-subtle)]">
        Esc
      </kbd>
    </div>

    <!-- Quick Scope Filters -->
    <div class="flex items-center gap-1.5 px-4 py-2 border-b border-[var(--border)] bg-[var(--bg-subtle)] text-xs font-mono">
      <span class="text-[var(--text-muted)]">Filter:</span>
      <button type="button" class="palette-filter-pill active px-2 py-0.5 rounded font-medium bg-[var(--accent)] text-[var(--accent-text)] cursor-pointer" data-filter="all">All</button>
      <button type="button" class="palette-filter-pill px-2 py-0.5 rounded text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer" data-filter="linux">Linux</button>
      <button type="button" class="palette-filter-pill px-2 py-0.5 rounded text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer" data-filter="macos">macOS</button>
      <button type="button" class="palette-filter-pill px-2 py-0.5 rounded text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer" data-filter="windows">Windows</button>
    </div>

    <!-- Results List -->
    <div id="palette-results-list" class="overflow-y-auto p-1 divide-y divide-[var(--border-muted)]">
      {COMMANDS.map((cmd, idx) => {
        const resolvedCmd = resolveCommandDefaults(cmd.command, cmd.params);
        return (
          <div
            class={`palette-item flex items-center justify-between p-3 hover:bg-[var(--bg-subtle)] cursor-pointer transition-colors rounded ${idx === 0 ? 'bg-[var(--bg-subtle)]' : ''}`}
            data-id={cmd.id}
            data-title={cmd.title.toLowerCase()}
            data-description={cmd.description.toLowerCase()}
            data-command={resolvedCmd}
            data-platforms={JSON.stringify(cmd.platforms)}
            data-tags={JSON.stringify(cmd.tags)}
            data-danger={cmd.dangerLevel}
          >
            <div class="flex-1 min-w-0 pr-3">
              <div class="flex items-baseline gap-2 mb-0.5">
                <span class="text-xs font-medium text-[var(--text-primary)] truncate">
                  {cmd.title}
                </span>
                <span class="text-[10px] font-mono text-[var(--text-muted)]">
                  {cmd.category}
                </span>
                {cmd.dangerLevel === 'dangerous' && (
                  <span class="text-[9px] font-mono px-1 py-0.2 rounded bg-red-950/70 border border-red-800/80 text-red-400 font-semibold">
                    Dangerous
                  </span>
                )}
              </div>
              <div class="font-mono text-xs text-[var(--text-secondary)] truncate">
                $ {resolvedCmd}
              </div>
            </div>

            <div class="flex items-center gap-1.5 shrink-0">
              <button
                type="button"
                class="palette-sim-btn p-1.5 rounded border border-[var(--border)] hover:border-[var(--border-hover)] bg-[var(--bg-subtle)] hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-slate-900 dark:hover:text-slate-200 transition-colors cursor-pointer inline-flex items-center justify-center"
                title="Simulate in terminal"
                data-command={resolvedCmd}
                data-output={cmd.outputExample || ''}
                data-title={cmd.title}
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>
            <button
              type="button"
              class="palette-fav-btn p-1.5 rounded bg-transparent hover:bg-slate-800/40 text-slate-400 hover:text-slate-200 transition-colors cursor-pointer inline-flex items-center justify-center"
              title="Bookmark command (alt+s)"
              aria-label="Bookmark command"
              data-id={cmd.id}
            >
              <svg class="pal-fav-icon w-3.5 h-3.5 text-slate-400 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
              </svg>
            </button>
            <span class="palette-copy-hint text-[10px] font-mono text-[var(--text-muted)]">
              ↵ Copy
            </span>
          </div>
        </div>
        );
      })}
    </div>

    <!-- Palette Footer -->
    <div class="flex items-center justify-between px-4 py-2 bg-[var(--bg-subtle)] border-t border-[var(--border)] text-[11px] font-mono text-[var(--text-muted)]">
      <div class="flex items-center gap-3">
        <span><kbd class="text-[var(--text-secondary)]">↑↓</kbd> navigate</span>
        <span><kbd class="text-[var(--text-secondary)]">↵</kbd> copy</span>
        <span><kbd class="text-[var(--text-secondary)]">alt+s</kbd> bookmark</span>
        <span><kbd class="text-[var(--text-secondary)]">esc</kbd> close</span>
      </div>
      <div>
        cmds
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const modal = document.getElementById('command-palette-modal');
    const input = document.getElementById('palette-input');
    const filterPills = document.querySelectorAll('.palette-filter-pill');
    let items = Array.from(document.querySelectorAll('.palette-item'));
    let activeIndex = 0;
    let currentFilter = 'all';

    function updatePaletteFavorites() {
      let favs = [];
      try {
        favs = JSON.parse(localStorage.getItem('cmds_favorites') || localStorage.getItem('brain_cmds_favorites') || '[]');
      } catch (e) {}

      document.querySelectorAll('.palette-item').forEach(item => {
        const id = item.getAttribute('data-id');
        const isFav = favs.includes(id);
        const btn = item.querySelector('.palette-fav-btn');
        const icon = item.querySelector('.pal-fav-icon');

        if (btn) {
          if (isFav) {
            btn.setAttribute('title', 'Remove from favorites (alt+s)');
            if (icon) {
              icon.classList.add('text-blue-400');
              icon.classList.remove('text-slate-400');
            }
          } else {
            btn.setAttribute('title', 'Bookmark command (alt+s)');
            if (icon) {
              icon.classList.remove('text-blue-400');
              icon.classList.add('text-slate-400');
            }
          }
        }
      });
    }

    window.addEventListener('cmds_fav_updated', updatePaletteFavorites);
    window.addEventListener('brain_cmds_fav_updated', updatePaletteFavorites);

    function openPalette() {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      updatePaletteFavorites();
      setTimeout(() => {
        input?.focus();
        input?.select();
      }, 30);
      filterPalette();
    }

    function closePalette() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    window.openPalette = openPalette;
    window.closePalette = closePalette;

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal && !modal.classList.contains('hidden')) {
          closePalette();
        } else {
          openPalette();
        }
      } else if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closePalette();
      }
    });

    document.getElementById('header-search-btn')?.addEventListener('click', openPalette);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closePalette();
      }
    });

    function filterPalette() {
      const q = (input?.value || '').toLowerCase().trim();
      items.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-description') || '';
        const cmd = item.getAttribute('data-command') || '';
        const tags = item.getAttribute('data-tags') || '';
        const platforms = JSON.parse(item.getAttribute('data-platforms') || '[]');

        const matchQuery = !q || title.includes(q) || desc.includes(q) || cmd.includes(q) || tags.includes(q);
        const matchPlatform = currentFilter === 'all' || platforms.includes('all') || platforms.includes(currentFilter);

        if (matchQuery && matchPlatform) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });

      const visibleItems = items.filter(el => !el.classList.contains('hidden'));
      items.forEach(el => el.classList.remove('bg-[var(--bg-subtle)]'));
      activeIndex = 0;
      if (visibleItems[0]) {
        visibleItems[0].classList.add('bg-[var(--bg-subtle)]');
      }
    }

    input?.addEventListener('input', filterPalette);

    input?.addEventListener('keydown', (e) => {
      const visibleItems = items.filter(el => !el.classList.contains('hidden'));
      if (visibleItems.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        visibleItems[activeIndex]?.classList.remove('bg-[var(--bg-subtle)]');
        activeIndex = (activeIndex + 1) % visibleItems.length;
        visibleItems[activeIndex]?.classList.add('bg-[var(--bg-subtle)]');
        visibleItems[activeIndex]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        visibleItems[activeIndex]?.classList.remove('bg-[var(--bg-subtle)]');
        activeIndex = (activeIndex - 1 + visibleItems.length) % visibleItems.length;
        visibleItems[activeIndex]?.classList.add('bg-[var(--bg-subtle)]');
        visibleItems[activeIndex]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const selected = visibleItems[activeIndex];
        if (selected) {
          const isDangerous = selected.getAttribute('data-danger') === 'dangerous';
          const copyHint = selected.querySelector('.palette-copy-hint');

          if (isDangerous && !selected.hasAttribute('data-confirmed')) {
            selected.setAttribute('data-confirmed', 'true');
            selected.classList.add('ring-1', 'ring-red-500', 'bg-red-950/40');
            if (copyHint) copyHint.textContent = '⚠️ Press ↵ again to confirm';

            setTimeout(() => {
              selected.removeAttribute('data-confirmed');
              selected.classList.remove('ring-1', 'ring-red-500', 'bg-red-950/40');
              if (copyHint) copyHint.textContent = '↵ Copy';
            }, 3500);
            return;
          }

          selected.removeAttribute('data-confirmed');
          selected.classList.remove('ring-1', 'ring-red-500', 'bg-red-950/40');
          if (copyHint) copyHint.textContent = '↵ Copy';

          const cmd = selected.getAttribute('data-command') || '';
          navigator.clipboard.writeText(cmd).then(() => {
            closePalette();
            const id = selected.getAttribute('data-id');
            const entry = document.getElementById(id);
            if (entry) {
              entry.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          });
        }
      } else if (e.altKey && e.key.toLowerCase() === 's') {
        e.preventDefault();
        const selected = visibleItems[activeIndex];
        if (selected) {
          const favBtn = selected.querySelector('.palette-fav-btn');
          favBtn?.click();
        }
      }
    });

    // Bookmark buttons in palette
    document.querySelectorAll('.palette-fav-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        if (!id) return;
        let favs = [];
        try {
          favs = JSON.parse(localStorage.getItem('cmds_favorites') || localStorage.getItem('brain_cmds_favorites') || '[]');
        } catch (err) {}
        const isFav = favs.includes(id);
        if (isFav) {
          favs = favs.filter(f => f !== id);
        } else {
          favs.push(id);
        }
        try {
          localStorage.setItem('cmds_favorites', JSON.stringify(favs));
        } catch (err) {}
        updatePaletteFavorites();
        window.dispatchEvent(new CustomEvent('cmds_fav_updated', { detail: { id, isFav: !isFav } }));
        window.dispatchEvent(new CustomEvent('brain_cmds_fav_updated', { detail: { id, isFav: !isFav } }));
      });
    });

    // Simulate buttons in palette
    document.querySelectorAll('.palette-sim-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        closePalette();
        const cmd = btn.getAttribute('data-command') || '';
        const output = btn.getAttribute('data-output') || '';
        const title = btn.getAttribute('data-title') || '';
        if (typeof window.simulateCommand === 'function') {
          window.simulateCommand(cmd, output, title);
        }
      });
    });

    items.forEach(item => {
      item.addEventListener('click', () => {
        const isDangerous = item.getAttribute('data-danger') === 'dangerous';
        const copyHint = item.querySelector('.palette-copy-hint');

        if (isDangerous && !item.hasAttribute('data-confirmed')) {
          item.setAttribute('data-confirmed', 'true');
          item.classList.add('ring-1', 'ring-red-500', 'bg-red-950/40');
          if (copyHint) copyHint.textContent = '⚠️ Click again to confirm';

          setTimeout(() => {
            item.removeAttribute('data-confirmed');
            item.classList.remove('ring-1', 'ring-red-500', 'bg-red-950/40');
            if (copyHint) copyHint.textContent = '↵ Copy';
          }, 3500);
          return;
        }

        item.removeAttribute('data-confirmed');
        const cmd = item.getAttribute('data-command') || '';
        navigator.clipboard.writeText(cmd).then(() => {
          closePalette();
          const id = item.getAttribute('data-id');
          const entry = document.getElementById(id);
          if (entry) {
            entry.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });
    });

    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => {
          p.classList.remove('active', 'bg-[var(--accent)]', 'text-[var(--accent-text)]');
          p.classList.add('text-[var(--text-secondary)]');
        });
        pill.classList.add('active', 'bg-[var(--accent)]', 'text-[var(--accent-text)]');
        pill.classList.remove('text-[var(--text-secondary)]');
        currentFilter = pill.getAttribute('data-filter') || 'all';
        filterPalette();
      });
    });
  })();
</script>
