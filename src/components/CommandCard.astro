---
import type { TerminalCommand } from '../data/types';
import { CATEGORIES } from '../data/categories';

interface Props {
  command: TerminalCommand;
}

const { command } = Astro.props;

const categoryInfo = CATEGORIES.find(c => c.id === command.category);
const dangerStyles = {
  safe: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
  caution: 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  dangerous: 'bg-rose-500/10 text-rose-400 border-rose-500/20 animate-pulse'
}[command.dangerLevel];

const dangerLabels = {
  safe: 'Safe',
  caution: 'Caution',
  dangerous: 'Destructive / Root'
}[command.dangerLevel];
---

<div
  id={command.id}
  class="command-card group relative rounded-2xl bg-white/[0.02] hover:bg-white/[0.04] border border-white/[0.08] hover:border-white/[0.18] p-5 sm:p-6 transition-all duration-300 card-shimmer flex flex-col justify-between shadow-lg shadow-black/20 hover:shadow-indigo-950/20"
  data-id={command.id}
  data-platforms={JSON.stringify(command.platforms)}
  data-category={command.category}
  data-title={command.title.toLowerCase()}
  data-description={command.description.toLowerCase()}
  data-tags={JSON.stringify(command.tags)}
  data-command-raw={command.command}
  data-danger={command.dangerLevel}
>
  <!-- Card Header -->
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <!-- Category & Platforms -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-white/[0.04] border border-white/[0.08] text-zinc-300">
          <span>{categoryInfo?.icon || '⚡'}</span>
          <span>{categoryInfo?.name || command.category}</span>
        </span>

        {command.platforms.includes('all') ? (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">
            🌐 Cross-platform
          </span>
        ) : (
          command.platforms.map(p => (
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono bg-white/[0.04] text-zinc-400 border border-white/[0.06]">
              {p === 'linux' && '🐧 Linux'}
              {p === 'macos' && '🍎 macOS'}
              {p === 'windows' && '🪟 Windows'}
            </span>
          ))
        )}

        <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono border ${dangerStyles}`}>
          {dangerLabels}
        </span>
      </div>

      <!-- Bookmark / Star Button -->
      <button
        type="button"
        class="star-toggle-btn p-1.5 rounded-lg text-zinc-500 hover:text-amber-400 hover:bg-amber-400/10 transition-colors cursor-pointer"
        title="Save to favorites"
        data-id={command.id}
      >
        <svg class="w-4 h-4 star-icon-empty" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
        <svg class="w-4 h-4 star-icon-filled text-amber-400 hidden" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
        </svg>
      </button>
    </div>

    <!-- Title & Description -->
    <h3 class="text-base sm:text-lg font-semibold text-white tracking-tight mb-2 flex items-center gap-2">
      <a href={`#${command.id}`} class="hover:text-indigo-400 transition-colors">
        {command.title}
      </a>
    </h3>
    <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-4">
      {command.description}
    </p>

    <!-- Alternative Platform Tabs (if applicable) -->
    {command.alternatives && command.alternatives.length > 0 && (
      <div class="flex items-center gap-2 mb-3 text-xs font-mono">
        <span class="text-zinc-500 text-[11px]">Syntax:</span>
        <button
          type="button"
          class="syntax-tab-btn active px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-medium"
          data-type="default"
        >
          Default
        </button>
        {command.alternatives.map((alt, idx) => (
          <button
            type="button"
            class="syntax-tab-btn px-2 py-0.5 rounded bg-white/[0.04] hover:bg-white/[0.08] text-zinc-400 hover:text-zinc-200 border border-white/[0.06]"
            data-type={`alt-${idx}`}
            data-alt-command={alt.command}
            data-alt-platform={alt.platform}
            data-alt-note={alt.note || ''}
          >
            {alt.platform === 'windows' && '🪟 PowerShell'}
            {alt.platform === 'macos' && '🍎 macOS'}
            {alt.platform === 'linux' && '🐧 Linux'}
            {alt.platform === 'all' && '🌐 Universal'}
          </button>
        ))}
      </div>
    )}

    <!-- Interactive Terminal Command Block -->
    <div class="relative rounded-xl bg-[#090b12] border border-white/[0.1] group-hover:border-indigo-500/40 transition-colors p-3.5 sm:p-4 font-mono text-xs sm:text-sm overflow-hidden mb-4 shadow-inner">
      <div class="flex items-start justify-between gap-3">
        <div class="flex-1 overflow-x-auto select-all text-zinc-200 leading-relaxed whitespace-pre-wrap break-all command-display-container">
          <span class="text-emerald-400 font-bold select-none mr-2">$</span>
          <span class="command-text-render" data-template={command.command}>
            {command.command}
          </span>
        </div>

        <!-- Copy Action Button -->
        <button
          type="button"
          class="card-copy-btn shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.07] hover:bg-indigo-600 hover:text-white border border-white/[0.1] hover:border-indigo-400/60 text-zinc-300 text-xs font-mono font-medium transition-all active:scale-95 cursor-pointer shadow-sm"
          title="Copy to clipboard"
        >
          <svg class="w-3.5 h-3.5 copy-icon-normal" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <svg class="w-3.5 h-3.5 copy-icon-success hidden text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span class="copy-label">Copy</span>
        </button>
      </div>

      <!-- Inline Parameter Customizer (if command has params) -->
      {command.params && command.params.length > 0 && (
        <div class="mt-3 pt-3 border-t border-white/[0.06] flex flex-wrap items-center gap-2 text-xs">
          <span class="text-zinc-500 text-[11px] select-none">Tune variables:</span>
          {command.params.map(param => (
            <label class="flex items-center gap-1.5 px-2 py-1 rounded bg-white/[0.04] border border-white/[0.08] text-zinc-300">
              <span class="text-indigo-400 font-mono text-[11px]">{param.label}:</span>
              <input
                type="text"
                class="param-input bg-black/40 border border-white/[0.15] focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400/40 rounded px-1.5 py-0.5 text-white font-mono text-[11px] outline-none w-24 sm:w-28 transition-all"
                data-param-name={param.name}
                value={param.default}
                placeholder={param.placeholder || param.default}
              />
            </label>
          ))}
        </div>
      )}
    </div>

    <!-- Pro-Tip Box (if present) -->
    {command.proTip && (
      <div class="rounded-xl bg-amber-500/[0.05] border border-amber-500/20 p-3 text-xs text-amber-200/90 font-mono mb-3 flex items-start gap-2.5">
        <span class="text-amber-400 shrink-0 text-sm">💡</span>
        <div class="leading-relaxed">
          <span class="font-semibold text-amber-300">Pro-Tip: </span>
          {command.proTip}
        </div>
      </div>
    )}

    <!-- Output Preview (if present) -->
    {command.outputExample && (
      <details class="group/output mb-3">
        <summary class="text-[11px] font-mono text-zinc-500 hover:text-zinc-300 cursor-pointer flex items-center gap-1 select-none transition-colors">
          <svg class="w-3 h-3 group-open/output:rotate-90 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span>Simulated Terminal Output</span>
        </summary>
        <div class="mt-2 p-3 rounded-lg bg-[#050609] border border-white/[0.06] font-mono text-[11px] text-zinc-400 whitespace-pre-wrap leading-relaxed overflow-x-auto">
          {command.outputExample}
        </div>
      </details>
    )}
  </div>

  <!-- Card Footer: Tags & Terminal Playground Runner -->
  <div class="pt-3 border-t border-white/[0.05] flex items-center justify-between gap-2 mt-2">
    <!-- Tags -->
    <div class="flex flex-wrap items-center gap-1.5">
      {command.tags.slice(0, 4).map(tag => (
        <button
          type="button"
          class="tag-pill text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.03] hover:bg-white/[0.08] text-zinc-400 hover:text-zinc-200 border border-white/[0.05] transition-colors cursor-pointer"
          data-tag={tag}
        >
          #{tag}
        </button>
      ))}
    </div>

    <!-- Playground Action -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        class="card-run-playground-btn text-[11px] font-mono text-indigo-400 hover:text-indigo-300 flex items-center gap-1 hover:underline cursor-pointer transition-colors"
        data-id={command.id}
      >
        <span>Simulate</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  </div>
</div>
