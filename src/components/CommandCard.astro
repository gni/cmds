---
import type { TerminalCommand } from '../data/types';
import { CATEGORIES } from '../data/categories';

interface Props {
  command: TerminalCommand;
}

const { command } = Astro.props;
const categoryInfo = CATEGORIES.find(c => c.id === command.category);

const platformNames = {
  all: 'Universal',
  linux: 'Linux',
  macos: 'macOS',
  windows: 'Windows'
};
---

<article
  id={command.id}
  class="command-card border border-[var(--brain-border-subtle)] hover:border-[var(--brain-border-default)] bg-[var(--brain-surface-primary)] p-4 sm:p-5 rounded-md transition-colors flex flex-col justify-between"
  data-id={command.id}
  data-platforms={JSON.stringify(command.platforms)}
  data-category={command.category}
  data-title={command.title.toLowerCase()}
  data-description={command.description.toLowerCase()}
  data-tags={JSON.stringify(command.tags)}
  data-command-raw={command.command}
  data-danger={command.dangerLevel}
>
  <div>
    <!-- Top Metadata Row -->
    <div class="flex items-center justify-between gap-2 mb-1.5 text-xs font-mono text-[var(--brain-text-secondary)]">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="text-[var(--brain-text-primary)] font-medium">{categoryInfo?.name || command.category}</span>
        <span class="text-[var(--brain-border-default)]">/</span>
        <span>
          {command.platforms.map(p => platformNames[p] || p).join(', ')}
        </span>

        {command.dangerLevel !== 'safe' && (
          <>
            <span class="text-[var(--brain-border-default)]">/</span>
            <span class="text-[var(--brain-amber)] font-medium">
              {command.dangerLevel === 'dangerous' ? 'Root' : 'Caution'}
            </span>
          </>
        )}
      </div>

      <button
        type="button"
        class="star-toggle-btn text-xs font-mono text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] cursor-pointer transition-colors"
        data-id={command.id}
      >
        <span class="star-label-unsaved">Save</span>
        <span class="star-label-saved hidden font-semibold text-[var(--brain-amber)]">Saved</span>
      </button>
    </div>

    <!-- Title & Description -->
    <h3 class="text-sm sm:text-base font-semibold text-[var(--brain-text-primary)] tracking-tight mb-1">
      <a href={`#${command.id}`} class="hover:underline">
        {command.title}
      </a>
    </h3>
    <p class="text-xs text-[var(--brain-text-secondary)] leading-relaxed mb-3">
      {command.description}
    </p>

    <!-- Alternative Syntax Tabs (if available) -->
    {command.alternatives && command.alternatives.length > 0 && (
      <div class="flex items-center gap-1 mb-2 text-xs font-mono">
        <span class="text-[var(--brain-text-tertiary)] text-[11px]">Variant:</span>
        <button
          type="button"
          class="syntax-tab-btn active px-1.5 py-0.5 rounded text-[11px] font-medium bg-[var(--brain-surface-subtle)] text-[var(--brain-text-primary)] cursor-pointer"
          data-type="default"
        >
          Default
        </button>
        {command.alternatives.map((alt, idx) => (
          <button
            type="button"
            class="syntax-tab-btn px-1.5 py-0.5 rounded text-[11px] text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] cursor-pointer"
            data-type={`alt-${idx}`}
            data-alt-command={alt.command}
            data-alt-platform={alt.platform}
            data-alt-note={alt.note || ''}
          >
            {alt.platform === 'windows' ? 'PowerShell' : alt.platform === 'macos' ? 'macOS BSD' : alt.platform}
          </button>
        ))}
      </div>
    )}

    <!-- Command Snippet & Copy Action -->
    <div class="border border-[var(--brain-code-border)] bg-[var(--brain-code-bg)] p-3 rounded text-xs font-mono mb-2.5">
      <div class="flex items-start justify-between gap-2">
        <div class="flex-1 select-all overflow-x-auto text-[var(--brain-text-primary)] leading-relaxed whitespace-pre-wrap break-all">
          <span class="text-[var(--brain-text-tertiary)] select-none mr-1.5 font-bold">$</span>
          <span class="command-text-render font-medium" data-template={command.command}>
            {command.command}
          </span>
        </div>

        <button
          type="button"
          class="card-copy-btn shrink-0 px-2.5 py-1 rounded border border-[var(--brain-border-default)] hover:border-[var(--brain-border-strong)] bg-[var(--brain-surface-primary)] text-[var(--brain-text-primary)] text-xs font-mono transition-colors cursor-pointer"
          title="Copy command"
        >
          <span class="copy-label">Copy</span>
        </button>
      </div>

      <!-- Compact Inline Parameter Inputs -->
      {command.params && command.params.length > 0 && (
        <div class="mt-2.5 pt-2 border-t border-[var(--brain-border-subtle)] flex flex-wrap items-center gap-2 text-xs font-mono">
          <span class="text-[var(--brain-text-tertiary)] text-[11px]">Tune:</span>
          {command.params.map(param => (
            <div class="flex items-center gap-1 bg-[var(--brain-surface-primary)] border border-[var(--brain-border-default)] px-1.5 py-0.5 rounded">
              <label for={`param-${command.id}-${param.name}`} class="text-[var(--brain-text-tertiary)] text-[11px]">{param.label}:</label>
              <input
                id={`param-${command.id}-${param.name}`}
                type="text"
                class="param-input bg-transparent text-[var(--brain-text-primary)] font-mono text-xs outline-none w-20 sm:w-24 font-medium"
                data-param-name={param.name}
                value={param.default}
                placeholder={param.placeholder || param.default}
              />
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Pro-tip Note -->
    {command.proTip && (
      <p class="text-xs font-mono text-[var(--brain-text-secondary)] mb-2 pl-2 border-l border-[var(--brain-border-strong)]">
        <span class="text-[var(--brain-text-primary)] font-medium">Tip:</span> {command.proTip}
      </p>
    )}
  </div>

  <!-- Bottom Actions: Tags & Run in Preview -->
  <div class="pt-2 border-t border-[var(--brain-border-subtle)] flex items-center justify-between gap-2 mt-1 text-xs font-mono">
    <div class="flex items-center gap-1.5 flex-wrap">
      {command.tags.slice(0, 3).map(tag => (
        <button
          type="button"
          class="tag-pill text-[11px] text-[var(--brain-text-tertiary)] hover:text-[var(--brain-text-primary)] transition-colors cursor-pointer"
          data-tag={tag}
        >
          #{tag}
        </button>
      ))}
    </div>

    <button
      type="button"
      class="card-simulate-btn text-xs font-medium text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] hover:underline flex items-center gap-1 cursor-pointer transition-colors"
      data-id={command.id}
      title="Test in terminal preview above"
    >
      <span>Simulate</span>
      <span aria-hidden="true">&rarr;</span>
    </button>
  </div>
</article>
