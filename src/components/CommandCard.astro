---
import type { TerminalCommand } from '../data/types';
import { CATEGORIES } from '../data/categories';

interface Props {
  command: TerminalCommand;
}

const { command } = Astro.props;
const categoryInfo = CATEGORIES.find(c => c.id === command.category);

const platformNames = {
  all: 'Universal',
  linux: 'Linux',
  macos: 'macOS',
  windows: 'Windows'
};
---

<article
  id={command.id}
  class="command-card border border-[var(--brain-border-subtle)] hover:border-[var(--brain-border-default)] bg-[var(--brain-surface-secondary)] p-5 rounded-lg transition-colors flex flex-col justify-between shadow-xs"
  data-id={command.id}
  data-platforms={JSON.stringify(command.platforms)}
  data-category={command.category}
  data-title={command.title.toLowerCase()}
  data-description={command.description.toLowerCase()}
  data-tags={JSON.stringify(command.tags)}
  data-command-raw={command.command}
  data-danger={command.dangerLevel}
>
  <div>
    <!-- Metadata Row -->
    <div class="flex items-center justify-between gap-2 mb-2 text-xs font-mono text-[var(--brain-text-secondary)]">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-[var(--brain-text-primary)] font-medium">{categoryInfo?.name || command.category}</span>
        <span class="text-[var(--brain-border-default)]">/</span>
        <span>
          {command.platforms.map(p => platformNames[p] || p).join(', ')}
        </span>

        {command.dangerLevel !== 'safe' && (
          <>
            <span class="text-[var(--brain-border-default)]">/</span>
            <span class="text-[var(--brain-amber)] font-medium">
              {command.dangerLevel === 'dangerous' ? 'Root / Destructive' : 'Caution'}
            </span>
          </>
        )}
      </div>

      <!-- Bookmark / Star Button -->
      <button
        type="button"
        class="star-toggle-btn p-1 rounded hover:bg-[var(--brain-surface-subtle)] text-[var(--brain-text-tertiary)] hover:text-[var(--brain-amber)] transition-colors cursor-pointer"
        title="Toggle favorite bookmark"
        data-id={command.id}
      >
        <svg class="w-4 h-4 star-icon-empty" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
        <svg class="w-4 h-4 star-icon-filled text-[var(--brain-amber)] hidden" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
        </svg>
      </button>
    </div>

    <!-- Title and Description -->
    <h3 class="text-base font-semibold text-[var(--brain-text-primary)] tracking-tight mb-1.5">
      <a href={`#${command.id}`} class="hover:underline">
        {command.title}
      </a>
    </h3>
    <p class="text-xs text-[var(--brain-text-secondary)] leading-relaxed mb-3">
      {command.description}
    </p>

    <!-- Alternative platform syntax switchers -->
    {command.alternatives && command.alternatives.length > 0 && (
      <div class="flex items-center gap-1.5 mb-2.5 text-xs font-mono">
        <span class="text-[var(--brain-text-tertiary)] text-[11px]">Variant:</span>
        <button
          type="button"
          class="syntax-tab-btn active px-2 py-0.5 rounded border border-[var(--brain-border-strong)] bg-[var(--brain-surface-subtle)] text-[var(--brain-text-primary)] font-medium cursor-pointer"
          data-type="default"
        >
          Default
        </button>
        {command.alternatives.map((alt, idx) => (
          <button
            type="button"
            class="syntax-tab-btn px-2 py-0.5 rounded border border-[var(--brain-border-subtle)] bg-[var(--brain-surface-primary)] hover:border-[var(--brain-border-default)] text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] cursor-pointer transition-colors"
            data-type={`alt-${idx}`}
            data-alt-command={alt.command}
            data-alt-platform={alt.platform}
            data-alt-note={alt.note || ''}
          >
            {alt.platform === 'windows' ? 'PowerShell' : alt.platform === 'macos' ? 'macOS BSD' : alt.platform}
          </button>
        ))}
      </div>
    )}

    <!-- Command Snippet & Copy Action -->
    <div class="border border-[var(--brain-code-border)] bg-[var(--brain-code-bg)] p-3.5 rounded-md text-xs font-mono mb-3">
      <div class="flex items-start justify-between gap-3">
        <div class="flex-1 select-all overflow-x-auto text-[var(--brain-text-primary)] leading-relaxed whitespace-pre-wrap break-all">
          <span class="text-[var(--brain-text-tertiary)] select-none mr-2 font-bold">$</span>
          <span class="command-text-render font-medium" data-template={command.command}>
            {command.command}
          </span>
        </div>

        <!-- Styled Copy Button with Clear Affordance -->
        <button
          type="button"
          class="card-copy-btn shrink-0 flex items-center gap-1.5 px-3 py-1 rounded-md border border-[var(--brain-border-default)] hover:border-[var(--brain-border-strong)] bg-[var(--brain-surface-primary)] text-[var(--brain-text-primary)] text-xs font-mono font-medium transition-all active:scale-[0.98] cursor-pointer shadow-2xs"
          title="Copy to clipboard"
        >
          <svg class="w-3.5 h-3.5 copy-icon-normal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <svg class="w-3.5 h-3.5 copy-icon-success hidden text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span class="copy-label">Copy</span>
        </button>
      </div>

      <!-- Inline configurable parameters -->
      {command.params && command.params.length > 0 && (
        <div class="mt-3 pt-2.5 border-t border-[var(--brain-border-subtle)] flex flex-wrap items-center gap-2 text-xs font-mono">
          <span class="text-[var(--brain-text-tertiary)] select-none text-[11px]">Tune parameters:</span>
          {command.params.map(param => (
            <div class="flex items-center gap-1.5 bg-[var(--brain-surface-primary)] border border-[var(--brain-border-default)] px-2 py-1 rounded-md">
              <label for={`param-${command.id}-${param.name}`} class="text-[var(--brain-text-secondary)] text-[11px] font-medium">{param.label}:</label>
              <input
                id={`param-${command.id}-${param.name}`}
                type="text"
                class="param-input bg-transparent text-[var(--brain-text-primary)] font-mono text-xs outline-none w-24 sm:w-28 font-semibold"
                data-param-name={param.name}
                value={param.default}
                placeholder={param.placeholder || param.default}
              />
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- ProTip / Note -->
    {command.proTip && (
      <div class="text-xs font-mono text-[var(--brain-text-secondary)] mb-3 pl-2.5 border-l-2 border-[var(--brain-border-strong)]">
        <span class="text-[var(--brain-text-primary)] font-medium">Pro-tip:</span> {command.proTip}
      </div>
    )}

    <!-- Output preview -->
    {command.outputExample && (
      <details class="mb-2 text-xs font-mono">
        <summary class="text-[var(--brain-text-tertiary)] hover:text-[var(--brain-text-primary)] cursor-pointer select-none">
          View simulated output
        </summary>
        <pre class="mt-1.5 p-2.5 bg-[var(--brain-code-bg)] text-[var(--brain-text-secondary)] border border-[var(--brain-border-subtle)] rounded-md overflow-x-auto whitespace-pre leading-relaxed">{command.outputExample}</pre>
      </details>
    )}
  </div>

  <!-- Bottom Row: Tags & Simulate in Terminal Button -->
  <div class="pt-3 border-t border-[var(--brain-border-subtle)] flex items-center justify-between gap-2 mt-1 text-xs font-mono">
    <div class="flex items-center gap-1.5 flex-wrap">
      {command.tags.slice(0, 4).map(tag => (
        <button
          type="button"
          class="tag-pill px-1.5 py-0.5 rounded bg-[var(--brain-surface-subtle)] text-[var(--brain-text-tertiary)] hover:text-[var(--brain-text-primary)] transition-colors cursor-pointer"
          data-tag={tag}
        >
          #{tag}
        </button>
      ))}
    </div>

    <!-- Live Terminal Preview Simulation Trigger -->
    <button
      type="button"
      class="card-simulate-btn flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-medium text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] hover:bg-[var(--brain-surface-subtle)] transition-colors cursor-pointer"
      data-id={command.id}
      title="Run in live terminal preview above"
    >
      <svg class="w-3.5 h-3.5 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>Simulate</span>
    </button>
  </div>
</article>
