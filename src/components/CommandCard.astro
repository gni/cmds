---
import type { TerminalCommand } from '../data/types';
import { CATEGORIES } from '../data/categories';

interface Props {
  command: TerminalCommand;
}

const { command } = Astro.props;
const categoryInfo = CATEGORIES.find(c => c.id === command.category);

const platformNames = {
  all: 'Universal',
  linux: 'Linux',
  macos: 'macOS',
  windows: 'Windows'
};
---

<article
  id={command.id}
  class="command-card border border-[var(--brain-border-subtle)] bg-[var(--brain-surface-secondary)] p-5 transition-colors flex flex-col justify-between"
  data-id={command.id}
  data-platforms={JSON.stringify(command.platforms)}
  data-category={command.category}
  data-title={command.title.toLowerCase()}
  data-description={command.description.toLowerCase()}
  data-tags={JSON.stringify(command.tags)}
  data-command-raw={command.command}
  data-danger={command.dangerLevel}
>
  <div>
    <!-- Metadata Row -->
    <div class="flex items-baseline justify-between gap-2 mb-2.5 text-xs font-mono text-[var(--brain-text-secondary)]">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-[var(--brain-text-primary)] font-medium">{categoryInfo?.name || command.category}</span>
        <span class="text-[var(--brain-border-default)]">/</span>
        <span>
          {command.platforms.map(p => platformNames[p] || p).join(', ')}
        </span>

        {command.dangerLevel !== 'safe' && (
          <>
            <span class="text-[var(--brain-border-default)]">/</span>
            <span class="text-[var(--brain-text-primary)] font-medium">
              {command.dangerLevel === 'dangerous' ? 'Root / Destructive' : 'Caution'}
            </span>
          </>
        )}
      </div>

      <!-- Bookmark button -->
      <button
        type="button"
        class="star-toggle-btn text-xs font-mono text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] transition-colors cursor-pointer"
        data-id={command.id}
      >
        <span class="star-label-unsaved">Save</span>
        <span class="star-label-saved hidden font-semibold">Saved</span>
      </button>
    </div>

    <!-- Title and Description -->
    <h3 class="text-base font-medium text-[var(--brain-text-primary)] tracking-tight mb-1.5">
      <a href={`#${command.id}`} class="hover:underline">
        {command.title}
      </a>
    </h3>
    <p class="text-xs text-[var(--brain-text-secondary)] leading-relaxed mb-4">
      {command.description}
    </p>

    <!-- Alternative platform syntax switchers -->
    {command.alternatives && command.alternatives.length > 0 && (
      <div class="flex items-center gap-2 mb-2 text-xs font-mono">
        <span class="text-[var(--brain-text-tertiary)]">Syntax:</span>
        <button
          type="button"
          class="syntax-tab-btn active text-[var(--brain-text-primary)] font-medium underline underline-offset-4 cursor-pointer"
          data-type="default"
        >
          Default
        </button>
        {command.alternatives.map((alt, idx) => (
          <button
            type="button"
            class="syntax-tab-btn text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] cursor-pointer"
            data-type={`alt-${idx}`}
            data-alt-command={alt.command}
            data-alt-platform={alt.platform}
            data-alt-note={alt.note || ''}
          >
            {alt.platform === 'windows' ? 'PowerShell' : alt.platform === 'macos' ? 'macOS BSD' : alt.platform}
          </button>
        ))}
      </div>
    )}

    <!-- Command Snippet & Copy Action -->
    <div class="border border-[var(--brain-border-subtle)] bg-[var(--brain-code-bg)] p-3 rounded text-xs font-mono mb-3">
      <div class="flex items-start justify-between gap-3">
        <div class="flex-1 select-all overflow-x-auto text-[var(--brain-text-primary)] leading-relaxed whitespace-pre-wrap break-all">
          <span class="text-[var(--brain-text-tertiary)] select-none mr-2">$</span>
          <span class="command-text-render" data-template={command.command}>
            {command.command}
          </span>
        </div>

        <button
          type="button"
          class="card-copy-btn shrink-0 px-2 py-1 rounded border border-[var(--brain-border-default)] hover:border-[var(--brain-border-strong)] bg-[var(--brain-surface-primary)] text-[var(--brain-text-primary)] text-xs font-mono transition-colors cursor-pointer"
        >
          <span class="copy-label">Copy</span>
        </button>
      </div>

      <!-- Inline configurable parameters -->
      {command.params && command.params.length > 0 && (
        <div class="mt-3 pt-2.5 border-t border-[var(--brain-border-subtle)] flex flex-wrap items-center gap-2 text-xs font-mono">
          <span class="text-[var(--brain-text-tertiary)] select-none">Variables:</span>
          {command.params.map(param => (
            <div class="flex items-center gap-1 bg-[var(--brain-surface-primary)] border border-[var(--brain-border-subtle)] px-2 py-0.5 rounded">
              <label for={`param-${command.id}-${param.name}`} class="text-[var(--brain-text-secondary)]">{param.label}:</label>
              <input
                id={`param-${command.id}-${param.name}`}
                type="text"
                class="param-input bg-transparent text-[var(--brain-text-primary)] font-mono text-xs outline-none w-24"
                data-param-name={param.name}
                value={param.default}
                placeholder={param.placeholder || param.default}
              />
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- ProTip / Caveat / Note -->
    {command.proTip && (
      <div class="text-xs font-mono text-[var(--brain-text-secondary)] mb-3 pl-2.5 border-l border-[var(--brain-border-default)]">
        <span class="text-[var(--brain-text-primary)] font-medium">Note:</span> {command.proTip}
      </div>
    )}

    <!-- Output preview -->
    {command.outputExample && (
      <details class="mb-2 text-xs font-mono">
        <summary class="text-[var(--brain-text-tertiary)] hover:text-[var(--brain-text-primary)] cursor-pointer select-none">
          Example output
        </summary>
        <pre class="mt-1.5 p-2 bg-[var(--brain-code-bg)] text-[var(--brain-text-secondary)] border border-[var(--brain-border-subtle)] rounded overflow-x-auto whitespace-pre leading-relaxed">{command.outputExample}</pre>
      </details>
    )}
  </div>

  <!-- Tags -->
  <div class="pt-3 border-t border-[var(--brain-border-subtle)] flex items-center justify-between text-xs font-mono text-[var(--brain-text-tertiary)] mt-1">
    <div class="flex items-center gap-2 flex-wrap">
      {command.tags.slice(0, 4).map(tag => (
        <button
          type="button"
          class="tag-pill hover:text-[var(--brain-text-primary)] transition-colors cursor-pointer"
          data-tag={tag}
        >
          #{tag}
        </button>
      ))}
    </div>
  </div>
</article>
