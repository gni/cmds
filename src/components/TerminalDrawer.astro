---
// TerminalDrawer.astro - Docked interactive terminal simulator
---

<!-- Fixed Docked Terminal Simulator -->
<div
  id="terminal-drawer"
  class="fixed bottom-0 left-0 right-0 z-50 transform translate-y-full transition-all duration-200 ease-out border-t border-[var(--border)] bg-[#090d14]/95 backdrop-blur-md font-mono text-xs shadow-2xl flex flex-col h-64 max-h-[70vh]"
  role="region"
  aria-label="Interactive Terminal Simulator"
>
  <!-- Window Title & Controls Bar -->
  <div class="flex items-center justify-between px-4 py-2 border-b border-slate-800 bg-slate-950 select-none text-[11px] shrink-0">
    <div class="flex items-center gap-2">
      <span class="text-slate-300 font-medium">Terminal</span>
    </div>

    <!-- Window Actions -->
    <div class="flex items-center gap-3 text-slate-400">
      <button
        id="term-clear-btn"
        type="button"
        class="hover:text-slate-200 cursor-pointer text-[11px] transition-colors"
        title="Clear terminal screen"
      >
        Clear
      </button>

      <button
        id="term-size-toggle-btn"
        type="button"
        class="hover:text-slate-200 cursor-pointer text-[11px] transition-colors"
        title="Toggle terminal height"
      >
        Expand
      </button>

      <button
        id="term-close-btn"
        type="button"
        class="hover:text-slate-200 cursor-pointer text-sm font-bold transition-colors px-1"
        title="Close terminal (Esc)"
        aria-label="Close terminal"
      >
        ✕
      </button>
    </div>
  </div>

  <!-- Terminal Output Stream -->
  <div
    id="term-body"
    class="flex-1 p-4 overflow-y-auto space-y-4 select-text text-slate-300 text-[11px] leading-relaxed font-mono scrollbar-thin"
  >
    <div class="terminal-welcome text-slate-500 text-[11px] pb-2 border-b border-slate-900">
      Run a command to inspect output. Press <kbd class="px-1 py-0.5 rounded border border-slate-800 bg-slate-900 text-slate-300 text-[10px]">Esc</kbd> to close.
    </div>
  </div>
</div>

<!-- Floating Terminal Dock Button (Shown when terminal is closed and has history) -->
<div id="term-dock-pill-container" class="fixed bottom-4 right-4 z-40">
  <button
    id="term-reopen-pill"
    type="button"
    class="hidden items-center gap-2 px-3 py-1.5 rounded border border-slate-700 bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white text-xs font-mono transition-colors cursor-pointer select-none"
    title="Toggle terminal (`)"
  >
    <span>Terminal</span>
    <span id="term-command-count" class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 text-[10px]">0</span>
  </button>
</div>

<script is:inline>
  (() => {
    const drawer = document.getElementById('terminal-drawer');
    const body = document.getElementById('term-body');
    const closeBtn = document.getElementById('term-close-btn');
    const clearBtn = document.getElementById('term-clear-btn');
    const sizeToggleBtn = document.getElementById('term-size-toggle-btn');
    const reopenPill = document.getElementById('term-reopen-pill');
    const commandCountBadge = document.getElementById('term-command-count');

    let isOpen = false;
    let isExpanded = false;
    let commandCounter = 0;

    function openTerminal() {
      if (!drawer) return;
      drawer.classList.remove('translate-y-full');
      isOpen = true;
      if (reopenPill) reopenPill.classList.add('hidden');
    }

    function closeTerminal() {
      if (!drawer) return;
      drawer.classList.add('translate-y-full');
      isOpen = false;
      if (reopenPill && commandCounter > 0) {
        reopenPill.classList.remove('hidden');
        reopenPill.classList.add('flex');
      }
    }

    function toggleExpand() {
      if (!drawer) return;
      isExpanded = !isExpanded;
      if (isExpanded) {
        drawer.classList.remove('h-64');
        drawer.classList.add('h-[70vh]');
        if (sizeToggleBtn) sizeToggleBtn.textContent = 'Collapse';
      } else {
        drawer.classList.remove('h-[70vh]');
        drawer.classList.add('h-64');
        if (sizeToggleBtn) sizeToggleBtn.textContent = 'Expand';
      }
    }

    closeBtn?.addEventListener('click', closeTerminal);
    reopenPill?.addEventListener('click', openTerminal);
    sizeToggleBtn?.addEventListener('click', toggleExpand);

    clearBtn?.addEventListener('click', () => {
      if (body) {
        body.innerHTML = `
          <div class="terminal-welcome text-slate-500 text-[11px] pb-2 border-b border-slate-900/60">
            Terminal cleared. Ready for next simulation.
          </div>
        `;
      }
    });

    // Keyboard shortcuts: Esc to close, Backtick (`) to toggle
    window.addEventListener('keydown', (e) => {
      const isInput = ['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '');
      if (e.key === 'Escape' && isOpen) {
        closeTerminal();
      }
      if (e.key === '`' && !isInput) {
        e.preventDefault();
        isOpen ? closeTerminal() : openTerminal();
      }
    });

    // Escape helper
    function escapeHtml(str) {
      return (str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    // Global simulator entry point
    window.simulateCommand = function(cmd, outputExample, title) {
      openTerminal();
      commandCounter++;
      if (commandCountBadge) commandCountBadge.textContent = String(commandCounter);

      if (!body) return;

      // Remove existing trailing prompt if present
      const oldPrompt = body.querySelector('.term-active-prompt');
      if (oldPrompt) oldPrompt.remove();

      const output = outputExample && outputExample.trim()
        ? outputExample.trim()
        : `✓ Process exited successfully with status code 0\nCompleted execution in 0.06s.`;

      const block = document.createElement('div');
      block.className = 'terminal-entry-log pb-3 border-b border-slate-900/60';

      block.innerHTML = `
        <div class="flex items-center gap-2 mb-1 text-slate-500 text-[10px]">
          <span class="text-slate-400 font-medium">${title ? escapeHtml(title) : 'command'}</span>
          <span>·</span>
          <span>${new Date().toLocaleTimeString()}</span>
        </div>
        <div class="flex items-center gap-2 mb-1.5 text-slate-200">
          <span class="text-slate-500 select-none font-bold">$</span>
          <span class="font-mono break-all font-medium">${escapeHtml(cmd)}</span>
        </div>
        <pre class="text-slate-300 font-mono text-[11px] whitespace-pre-wrap leading-relaxed overflow-x-auto p-2.5 rounded bg-black/40 border border-slate-800">${escapeHtml(output)}</pre>
      `;

      body.appendChild(block);

      // Trailing prompt
      const newPrompt = document.createElement('div');
      newPrompt.className = 'term-active-prompt flex items-center gap-2 text-slate-500 pt-1 select-none';
      newPrompt.innerHTML = `
        <span class="font-bold">$</span>
        <span class="inline-block w-2 h-3.5 bg-slate-500"></span>
      `;
      body.appendChild(newPrompt);

      body.scrollTop = body.scrollHeight;
    };
  })();
</script>
