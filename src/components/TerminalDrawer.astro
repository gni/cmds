---
// TerminalDrawer.astro - Docked interactive terminal simulator with interactive command line
import { COMMANDS } from '../data/commands';

const registry = COMMANDS.map(cmd => {
  let cleanCmd = cmd.command;
  if (cmd.params) {
    cmd.params.forEach(p => {
      cleanCmd = cleanCmd.replaceAll(`{{${p.name}}}`, p.default || p.placeholder || p.name);
    });
  }
  return {
    id: cmd.id,
    title: cmd.title,
    rawTemplate: cmd.command,
    concreteCommand: cleanCmd,
    outputExample: cmd.outputExample || ''
  };
});
---

<!-- Serialized command registry for client autocomplete -->
<script type="application/json" id="term-registry-data" set:html={JSON.stringify(registry)} />

<!-- Fixed Docked Terminal Simulator -->
<div
  id="terminal-drawer"
  class="fixed bottom-0 left-0 right-0 z-50 transform translate-y-full transition-all duration-200 ease-out border-t border-[var(--border)] bg-[#090d14]/95 backdrop-blur-md font-mono text-xs shadow-2xl flex flex-col h-64 max-h-[70vh]"
  role="region"
  aria-label="Interactive Terminal Simulator"
>
  <!-- Window Title & Controls Bar -->
  <div class="flex items-center justify-between px-4 py-2 border-b border-slate-800 bg-slate-950 select-none text-[11px] shrink-0">
    <div class="flex items-center gap-2">
      <span class="text-slate-300 font-medium">Terminal</span>
    </div>

    <!-- Window Actions -->
    <div class="flex items-center gap-3 text-slate-400">
      <button
        id="term-clear-btn"
        type="button"
        class="hover:text-slate-200 cursor-pointer text-[11px] transition-colors"
        title="Clear terminal screen"
      >
        Clear
      </button>

      <button
        id="term-size-toggle-btn"
        type="button"
        class="hover:text-slate-200 cursor-pointer text-[11px] transition-colors"
        title="Toggle terminal height"
      >
        Expand
      </button>

      <button
        id="term-close-btn"
        type="button"
        class="hover:text-slate-200 cursor-pointer text-sm font-bold transition-colors px-1"
        title="Close terminal (Esc)"
        aria-label="Close terminal"
      >
        ✕
      </button>
    </div>
  </div>

  <!-- Terminal Output Stream -->
  <div
    id="term-body"
    class="flex-1 p-4 overflow-y-auto space-y-3 select-text text-slate-300 text-[11px] leading-relaxed font-mono scrollbar-thin flex flex-col"
  >
    <div id="term-logs" class="space-y-3 flex-1">
      <div class="terminal-welcome text-slate-500 text-[11px] pb-2 border-b border-slate-900">
        Type a command below or click Simulate on any card. Press <kbd class="px-1 py-0.5 rounded border border-slate-800 bg-slate-900 text-slate-300 text-[10px]">Esc</kbd> to close.
      </div>
    </div>

    <!-- Active Interactive Command Line -->
    <div id="term-cli-container" class="relative pt-2 shrink-0">
      <!-- Autocomplete Dropdown Box -->
      <div
        id="term-autocomplete-dropdown"
        class="hidden absolute bottom-full left-0 right-0 mb-2 rounded border border-slate-800 bg-slate-950/98 shadow-2xl overflow-hidden max-h-48 overflow-y-auto z-20 divide-y divide-slate-900"
      >
      </div>

      <!-- Active Input Row -->
      <div id="term-input-row" class="flex items-center gap-2 text-slate-200">
        <span class="text-slate-500 select-none font-bold text-xs shrink-0">$</span>
        <div class="relative flex-1 flex items-center min-w-0 font-mono text-[11px]">
          <input
            id="term-cli-input"
            type="text"
            class="w-full bg-transparent text-slate-100 font-mono text-[11px] outline-none border-none p-0 m-0 relative z-10 caret-slate-200 placeholder:text-slate-600 focus:ring-0"
            placeholder="Type command (e.g. git, python3, uv, docker, clear)..."
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          />
          <div
            id="term-ghost-text"
            class="absolute inset-0 pointer-events-none font-mono text-[11px] select-none whitespace-pre overflow-hidden flex items-center"
          ></div>
        </div>
        <span
          id="term-tab-hint"
          class="hidden text-[10px] text-slate-500 font-mono select-none px-1.5 py-0.5 rounded border border-slate-800 bg-slate-900/80 shrink-0"
        >Tab ⇥</span>
      </div>
    </div>
  </div>
</div>

<!-- Floating Quick Actions (Discreet terminal toggle with numbers + Scroll to top) -->
<div id="floating-actions-cluster" class="fixed bottom-5 right-5 z-40 flex items-center gap-2 font-mono">
  <!-- Discreet Terminal Trigger with Numbers -->
  <button
    id="term-reopen-pill"
    type="button"
    class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-[var(--border)] bg-[var(--bg)]/95 hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs font-mono backdrop-blur-md shadow-md transition-all cursor-pointer select-none"
    title="Toggle terminal simulator (`)"
    aria-label="Toggle terminal simulator"
  >
    <svg class="w-3.5 h-3.5 text-current shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="4 17 10 11 4 5"></polyline>
      <line x1="12" y1="19" x2="20" y2="19"></line>
    </svg>
    <span
      id="term-command-count"
      class="text-[10px] font-mono font-medium px-1 rounded bg-[var(--bg-muted)] text-[var(--text-secondary)] border border-[var(--border)] leading-tight"
    >0</span>
  </button>

  <!-- Scroll To Top Button -->
  <button
    id="scroll-to-top-btn"
    type="button"
    class="opacity-0 pointer-events-none translate-y-2 inline-flex items-center justify-center w-8 h-8 rounded-md border border-[var(--border)] bg-[var(--bg)]/95 hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs font-mono backdrop-blur-md shadow-md transition-all duration-200 cursor-pointer select-none"
    title="Scroll to top"
    aria-label="Scroll to top"
  >
    <svg class="w-3.5 h-3.5 text-current" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
  </button>
</div>

<script is:inline>
  (() => {
    const drawer = document.getElementById('terminal-drawer');
    const body = document.getElementById('term-body');
    const logs = document.getElementById('term-logs');
    const closeBtn = document.getElementById('term-close-btn');
    const clearBtn = document.getElementById('term-clear-btn');
    const sizeToggleBtn = document.getElementById('term-size-toggle-btn');
    const reopenPill = document.getElementById('term-reopen-pill');
    const commandCountBadge = document.getElementById('term-command-count');
    const scrollToTopBtn = document.getElementById('scroll-to-top-btn');

    const cliInput = document.getElementById('term-cli-input');
    const ghostText = document.getElementById('term-ghost-text');
    const tabHint = document.getElementById('term-tab-hint');
    const autocompleteBox = document.getElementById('term-autocomplete-dropdown');

    let registry = [];
    try {
      const dataEl = document.getElementById('term-registry-data');
      if (dataEl && dataEl.textContent) {
        registry = JSON.parse(dataEl.textContent);
      }
    } catch (e) {
      registry = [];
    }

    let isOpen = false;
    let isExpanded = false;
    let commandCounter = 0;
    const history = [];
    let historyIndex = -1;
    let currentMatches = [];
    let selectedMatchIndex = -1;

    function openTerminal() {
      if (!drawer) return;
      drawer.classList.remove('translate-y-full');
      isOpen = true;
      if (reopenPill) {
        reopenPill.classList.add('border-[var(--text-primary)]', 'text-[var(--text-primary)]');
      }
      setTimeout(() => {
        if (cliInput) {
          cliInput.focus();
        }
      }, 80);
    }

    function closeTerminal() {
      if (!drawer) return;
      drawer.classList.add('translate-y-full');
      isOpen = false;
      closeAutocomplete();
      if (reopenPill) {
        reopenPill.classList.remove('border-[var(--text-primary)]', 'text-[var(--text-primary)]');
      }
    }

    function toggleExpand() {
      if (!drawer) return;
      isExpanded = !isExpanded;
      if (isExpanded) {
        drawer.classList.remove('h-64');
        drawer.classList.add('h-[70vh]');
        if (sizeToggleBtn) sizeToggleBtn.textContent = 'Collapse';
      } else {
        drawer.classList.remove('h-[70vh]');
        drawer.classList.add('h-64');
        if (sizeToggleBtn) sizeToggleBtn.textContent = 'Expand';
      }
    }

    closeBtn?.addEventListener('click', closeTerminal);
    reopenPill?.addEventListener('click', () => {
      if (isOpen) {
        closeTerminal();
      } else {
        openTerminal();
      }
    });
    sizeToggleBtn?.addEventListener('click', toggleExpand);

    clearBtn?.addEventListener('click', () => {
      commandCounter = 0;
      if (commandCountBadge) commandCountBadge.textContent = '0';
      if (logs) {
        logs.innerHTML = `
          <div class="terminal-welcome text-slate-500 text-[11px] pb-2 border-b border-slate-900/60">
            Run a command to inspect output. Press <kbd class="px-1 py-0.5 rounded border border-slate-800 bg-slate-900 text-slate-300 text-[10px]">Esc</kbd> to close.
          </div>
        `;
      }
      closeTerminal();
    });

    // Scroll to top controller
    function updateScrollToTopVisibility() {
      if (!scrollToTopBtn) return;
      if (window.scrollY > 300) {
        scrollToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
        scrollToTopBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        scrollToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
        scrollToTopBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    }

    window.addEventListener('scroll', updateScrollToTopVisibility, { passive: true });
    updateScrollToTopVisibility();

    scrollToTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Click terminal body to focus input
    body?.addEventListener('click', (e) => {
      const selection = window.getSelection();
      if (selection && selection.toString().length > 0) return;
      if (e.target.closest('button, a, input, pre')) return;
      cliInput?.focus();
    });

    // Escape helper
    function escapeHtml(str) {
      return (str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function closeAutocomplete() {
      if (autocompleteBox) {
        autocompleteBox.classList.add('hidden');
        autocompleteBox.innerHTML = '';
      }
      if (ghostText) {
        ghostText.innerHTML = '';
      }
      if (tabHint) {
        tabHint.classList.add('hidden');
      }
      currentMatches = [];
      selectedMatchIndex = -1;
    }

    function renderAutocomplete(matches, query) {
      currentMatches = matches;
      selectedMatchIndex = -1;

      if (!autocompleteBox || matches.length === 0) {
        closeAutocomplete();
        return;
      }

      // Ghost text preview for top match
      const topMatch = matches[0];
      const topCmd = topMatch.concreteCommand || topMatch.rawTemplate;
      if (topCmd.toLowerCase().startsWith(query.toLowerCase()) && ghostText) {
        const typedLen = query.length;
        const remainder = topCmd.slice(typedLen);
        ghostText.innerHTML = `<span class="opacity-0">${escapeHtml(query)}</span><span class="text-slate-500">${escapeHtml(remainder)}</span>`;
        if (tabHint) tabHint.classList.remove('hidden');
      } else {
        if (ghostText) ghostText.innerHTML = '';
        if (tabHint) tabHint.classList.add('hidden');
      }

      // Dropdown items
      autocompleteBox.innerHTML = matches.map((m, idx) => {
        const cmdText = m.concreteCommand || m.rawTemplate;
        return `
          <div
            class="term-suggestion-item px-3 py-1.5 flex items-center justify-between gap-3 hover:bg-slate-900 cursor-pointer transition-colors text-[11px] font-mono select-none"
            data-index="${idx}"
            data-command="${escapeHtml(cmdText)}"
          >
            <div class="flex items-center gap-1.5 truncate">
              <span class="text-sky-400 font-bold">$</span>
              <span class="text-slate-200 font-medium truncate">${escapeHtml(cmdText)}</span>
            </div>
            <span class="text-slate-500 text-[10px] truncate shrink-0">${escapeHtml(m.title)}</span>
          </div>
        `;
      }).join('');

      autocompleteBox.querySelectorAll('.term-suggestion-item').forEach(item => {
        item.addEventListener('click', () => {
          const cmd = item.getAttribute('data-command') || '';
          if (cliInput) {
            cliInput.value = cmd;
            executeCommand(cmd);
          }
        });
      });

      autocompleteBox.classList.remove('hidden');
    }

    function updateGhostOnly(query) {
      if (!query) {
        closeAutocomplete();
        return;
      }

      const q = query.toLowerCase();
      const exactPrefix = [];
      const wordPrefix = [];
      const substring = [];

      for (let i = 0; i < registry.length; i++) {
        const item = registry[i];
        const cmdStr = (item.concreteCommand || item.rawTemplate).toLowerCase();
        const titleStr = item.title.toLowerCase();

        if (cmdStr.startsWith(q)) {
          exactPrefix.push(item);
        } else if (cmdStr.includes(' ' + q) || cmdStr.includes('-' + q)) {
          wordPrefix.push(item);
        } else if (cmdStr.includes(q) || titleStr.includes(q)) {
          substring.push(item);
        }
      }

      const matches = [...exactPrefix, ...wordPrefix, ...substring].slice(0, 5);
      renderAutocomplete(matches, query);
    }

    cliInput?.addEventListener('input', () => {
      const val = cliInput.value;
      if (!val.trim()) {
        closeAutocomplete();
        return;
      }
      updateGhostOnly(val);
    });

    cliInput?.addEventListener('keydown', (e) => {
      // Tab: Accept suggestion
      if (e.key === 'Tab') {
        if (currentMatches.length > 0) {
          e.preventDefault();
          const target = selectedMatchIndex >= 0 ? currentMatches[selectedMatchIndex] : currentMatches[0];
          cliInput.value = target.concreteCommand || target.rawTemplate;
          closeAutocomplete();
          return;
        }
      }

      // ArrowRight: Accept ghost text if cursor at end of input
      if (e.key === 'ArrowRight') {
        if (cliInput.selectionStart === cliInput.value.length && currentMatches.length > 0) {
          const top = currentMatches[0];
          const topCmd = top.concreteCommand || top.rawTemplate;
          if (topCmd.toLowerCase().startsWith(cliInput.value.toLowerCase())) {
            cliInput.value = topCmd;
            closeAutocomplete();
            return;
          }
        }
      }

      // ArrowUp / ArrowDown: navigate suggestions or history
      if (e.key === 'ArrowDown') {
        if (currentMatches.length > 0 && autocompleteBox && !autocompleteBox.classList.contains('hidden')) {
          e.preventDefault();
          selectedMatchIndex = (selectedMatchIndex + 1) % currentMatches.length;
          highlightDropdown();
          return;
        }
        // History down
        if (history.length > 0 && historyIndex < history.length - 1) {
          e.preventDefault();
          historyIndex++;
          cliInput.value = history[historyIndex];
          closeAutocomplete();
        } else if (historyIndex === history.length - 1) {
          historyIndex = history.length;
          cliInput.value = '';
          closeAutocomplete();
        }
      }

      if (e.key === 'ArrowUp') {
        if (currentMatches.length > 0 && autocompleteBox && !autocompleteBox.classList.contains('hidden')) {
          e.preventDefault();
          selectedMatchIndex = selectedMatchIndex <= 0 ? currentMatches.length - 1 : selectedMatchIndex - 1;
          highlightDropdown();
          return;
        }
        // History up
        if (history.length > 0) {
          e.preventDefault();
          if (historyIndex === -1) historyIndex = history.length;
          if (historyIndex > 0) {
            historyIndex--;
            cliInput.value = history[historyIndex];
            closeAutocomplete();
          }
        }
      }

      // Escape: Close dropdown first, then drawer
      if (e.key === 'Escape') {
        if (autocompleteBox && !autocompleteBox.classList.contains('hidden')) {
          e.preventDefault();
          e.stopPropagation();
          closeAutocomplete();
          return;
        }
      }

      // Enter: Execute command
      if (e.key === 'Enter') {
        e.preventDefault();
        let cmdToRun = cliInput.value.trim();
        if (selectedMatchIndex >= 0 && currentMatches[selectedMatchIndex]) {
          cmdToRun = currentMatches[selectedMatchIndex].concreteCommand || currentMatches[selectedMatchIndex].rawTemplate;
        }
        if (cmdToRun) {
          executeCommand(cmdToRun);
        }
      }
    });

    function highlightDropdown() {
      const items = autocompleteBox?.querySelectorAll('.term-suggestion-item') || [];
      items.forEach((item, idx) => {
        if (idx === selectedMatchIndex) {
          item.classList.add('bg-slate-800', 'text-white');
        } else {
          item.classList.remove('bg-slate-800', 'text-white');
        }
      });
    }

    function appendLog(cmd, output, title, isError) {
      if (!logs) return;
      const block = document.createElement('div');
      block.className = 'terminal-entry-log pb-3 border-b border-slate-900/60';

      const statusColor = isError ? 'text-rose-400' : 'text-slate-400';
      const outputClass = isError
        ? 'text-rose-300 bg-rose-950/25 border border-rose-900/40'
        : 'text-slate-300 bg-black/40 border border-slate-800';

      block.innerHTML = `
        <div class="flex items-center gap-2 mb-1 text-slate-500 text-[10px]">
          <span class="${statusColor} font-medium">${title ? escapeHtml(title) : 'command'}</span>
          <span>·</span>
          <span>${new Date().toLocaleTimeString()}</span>
        </div>
        <div class="flex items-center gap-2 mb-1.5 text-slate-200">
          <span class="text-slate-500 select-none font-bold">$</span>
          <span class="font-mono break-all font-medium">${escapeHtml(cmd)}</span>
        </div>
        <pre class="${outputClass} font-mono text-[11px] whitespace-pre-wrap leading-relaxed overflow-x-auto p-2.5 rounded">${escapeHtml(output)}</pre>
      `;

      logs.appendChild(block);
      if (body) {
        body.scrollTop = body.scrollHeight;
      }
    }

    function executeCommand(rawCmd) {
      const trimmed = rawCmd.trim();
      if (!trimmed) return;

      history.push(trimmed);
      historyIndex = history.length;
      if (cliInput) cliInput.value = '';
      closeAutocomplete();

      const lower = trimmed.toLowerCase();

      // Built-in commands
      if (lower === 'clear') {
        if (logs) {
          logs.innerHTML = `
            <div class="terminal-welcome text-slate-500 text-[11px] pb-2 border-b border-slate-900/60">
              Terminal cleared. Ready for next simulation.
            </div>
          `;
        }
        return;
      }

      if (lower === 'exit' || lower === 'quit') {
        closeTerminal();
        return;
      }

      if (lower === 'help') {
        appendLog('help', `cmds Terminal Interactive Simulator
Built-in commands:
  help      Print this help summary
  clear     Clear output scrollback
  history   List executed commands in session
  exit      Dismiss terminal drawer

Navigation:
  Type command names or keywords for autocomplete suggestions
  Press Tab or Right Arrow to accept ghost text suggestion
  Press Up/Down arrow keys to navigate history or suggestions
  Press Esc to close terminal drawer`, 'System Reference', false);
        return;
      }

      if (lower === 'history') {
        const histText = history.map((h, i) => `  ${String(i + 1).padStart(3, ' ')}  ${h}`).join('\n');
        appendLog('history', histText || 'No history recorded yet.', 'Session History', false);
        return;
      }

      if (lower === 'pwd') {
        appendLog('pwd', '/workspace/cmds', 'Filesystem', false);
        return;
      }

      if (lower === 'whoami') {
        appendLog('whoami', 'developer', 'Identity', false);
        return;
      }

      if (lower === 'date') {
        appendLog('date', new Date().toUTCString(), 'System Time', false);
        return;
      }

      // Search matching command in catalog
      let match = registry.find(r => (r.concreteCommand || '').toLowerCase() === lower || (r.rawTemplate || '').toLowerCase() === lower);

      if (!match) {
        match = registry.find(r => (r.concreteCommand || '').toLowerCase().startsWith(lower) || (r.rawTemplate || '').toLowerCase().startsWith(lower));
      }

      if (!match) {
        match = registry.find(r => (r.concreteCommand || '').toLowerCase().includes(lower));
      }

      commandCounter++;
      if (commandCountBadge) commandCountBadge.textContent = String(commandCounter);

      if (match) {
        const out = match.outputExample && match.outputExample.trim()
          ? match.outputExample.trim()
          : '✓ Process exited successfully with status code 0\nExecution completed in 0.04s.';
        appendLog(trimmed, out, match.title, false);
      } else {
        const baseCmd = trimmed.split(' ')[0];
        appendLog(
          trimmed,
          `bash: ${baseCmd}: command not found (exit code 127)\nType "help" or start typing a catalog command to review available syntax.`,
          'Command Not Found',
          true
        );
      }
    }

    // Global simulator entry point
    window.simulateCommand = function(cmd, outputExample, title) {
      openTerminal();
      commandCounter++;
      if (commandCountBadge) commandCountBadge.textContent = String(commandCounter);

      const output = outputExample && outputExample.trim()
        ? outputExample.trim()
        : '✓ Process exited successfully with status code 0\nCompleted execution in 0.06s.';

      appendLog(cmd, output, title, false);
    };

    // Global keyboard shortcut
    window.addEventListener('keydown', (e) => {
      const isInput = ['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '');
      if (e.key === 'Escape' && isOpen) {
        closeTerminal();
      }
      if (e.key === '`' && !isInput) {
        e.preventDefault();
        if (isOpen) {
          closeTerminal();
        } else {
          openTerminal();
        }
      }
    });
  })();
</script>
