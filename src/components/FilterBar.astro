---
import { CATEGORIES } from '../data/categories';

interface Props {
  totalCount: number;
  linuxCount: number;
  macosCount: number;
  windowsCount: number;
}

const { totalCount, linuxCount, macosCount, windowsCount } = Astro.props;
---

<div id="filter-bar-root" class="sticky top-0 z-30 w-full bg-[var(--brain-surface-primary)] border-b border-[var(--brain-border-subtle)] py-2.5">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-2.5">
    <!-- Top Row: Search Input + Platform Selector -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <!-- Search Field -->
      <div class="relative flex-1">
        <input
          id="search-input"
          type="search"
          placeholder="Filter commands by keyword, tool, or flag (press / to focus)..."
          class="w-full pl-3 pr-20 py-1.5 rounded border border-[var(--brain-border-default)] focus:border-[var(--brain-border-strong)] bg-[var(--brain-surface-secondary)] text-[var(--brain-text-primary)] placeholder-[var(--brain-text-tertiary)] text-xs font-mono outline-none transition-colors"
        />
        <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center gap-1.5">
          <button
            id="clear-search-btn"
            type="button"
            class="hidden text-[var(--brain-text-tertiary)] hover:text-[var(--brain-text-primary)] text-xs font-mono px-1 py-0.5 rounded cursor-pointer"
            title="Clear search"
          >
            Clear
          </button>
          <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono text-[var(--brain-text-tertiary)] border border-[var(--brain-border-default)] bg-[var(--brain-surface-primary)] rounded">
            /
          </kbd>
        </div>
      </div>

      <!-- Platform Segments -->
      <div class="flex items-center gap-1 p-0.5 rounded border border-[var(--brain-border-default)] bg-[var(--brain-surface-secondary)] text-xs font-mono overflow-x-auto shrink-0">
        <button
          type="button"
          class="platform-tab px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer bg-[var(--brain-accent)] text-[var(--brain-accent-text)]"
          data-platform="all"
        >
          All ({totalCount})
        </button>

        <button
          type="button"
          class="platform-tab px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)]"
          data-platform="linux"
        >
          Linux ({linuxCount})
        </button>

        <button
          type="button"
          class="platform-tab px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)]"
          data-platform="macos"
        >
          macOS ({macosCount})
        </button>

        <button
          type="button"
          class="platform-tab px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)]"
          data-platform="windows"
        >
          Windows ({windowsCount})
        </button>

        <button
          type="button"
          id="favorites-tab-btn"
          class="platform-tab px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)]"
          data-platform="favorites"
        >
          Saved (<span id="favorites-badge-count">0</span>)
        </button>
      </div>
    </div>

    <!-- Bottom Row: Clean Category Links -->
    <div class="flex items-center justify-between gap-4">
      <div id="category-scroll-container" class="flex items-center gap-1 overflow-x-auto text-xs font-mono scrollbar-none w-full py-0.5">
        <button
          type="button"
          class="category-chip shrink-0 px-2.5 py-0.5 rounded transition-colors cursor-pointer bg-[var(--brain-surface-subtle)] text-[var(--brain-text-primary)] font-medium"
          data-category="all"
        >
          All
        </button>

        {CATEGORIES.map((cat) => (
          <button
            type="button"
            class="category-chip shrink-0 px-2 py-0.5 rounded transition-colors cursor-pointer text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] hover:bg-[var(--brain-surface-subtle)]"
            data-category={cat.id}
          >
            {cat.name}
          </button>
        ))}
      </div>

      <!-- Result Count -->
      <div class="hidden lg:flex items-center gap-2 shrink-0 text-xs font-mono text-[var(--brain-text-tertiary)] pl-4 border-l border-[var(--brain-border-subtle)]">
        <span id="results-count-text">{totalCount} commands</span>
        <button
          id="reset-filters-btn"
          type="button"
          class="hidden text-[var(--brain-text-primary)] underline cursor-pointer"
        >
          Reset
        </button>
      </div>
    </div>
  </div>
</div>
