---
import { CATEGORIES } from '../data/categories';

interface Props {
  totalCount: number;
  linuxCount: number;
  macosCount: number;
  windowsCount: number;
}

const { totalCount, linuxCount, macosCount, windowsCount } = Astro.props;
---

<div id="filter-bar-root" class="sticky top-16 z-30 w-full bg-[#06070a]/90 backdrop-blur-xl border-b border-white/[0.08] py-4 transition-all shadow-xl shadow-black/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
    <!-- Top Row: Main Search + OS Switcher + Reset -->
    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
      <!-- Search Input Box -->
      <div class="relative flex-1 group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400 group-focus-within:text-indigo-400 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          id="search-input"
          type="text"
          placeholder="Search 104+ commands by keyword, tool, or flag (e.g., port, git undo, ssl, ffmpeg, lsof)..."
          class="w-full pl-10 pr-24 py-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.08] focus:bg-[#0c0e18] border border-white/[0.1] focus:border-indigo-500/80 focus:ring-2 focus:ring-indigo-500/20 text-white placeholder-zinc-500 text-sm font-mono transition-all outline-none"
        />
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center gap-1.5">
          <button
            id="clear-search-btn"
            type="button"
            class="hidden text-zinc-500 hover:text-white p-1 transition-colors cursor-pointer"
            title="Clear search"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
          <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[11px] font-mono text-zinc-400 bg-white/[0.06] rounded border border-white/[0.1] select-none">
            /
          </kbd>
        </div>
      </div>

      <!-- OS Switcher Tabs -->
      <div class="flex items-center gap-1 p-1 rounded-xl bg-white/[0.04] border border-white/[0.08] font-mono text-xs overflow-x-auto self-start md:self-auto scrollbar-none">
        <button
          type="button"
          class="platform-tab px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer bg-indigo-500 text-white font-medium shadow-md shadow-indigo-500/30"
          data-platform="all"
        >
          <span>All OS</span>
          <span class="text-[11px] px-1.5 py-0.2 rounded-full bg-white/20 text-white font-semibold">{totalCount}</span>
        </button>

        <button
          type="button"
          class="platform-tab px-3 py-1.5 rounded-lg text-zinc-400 hover:text-white hover:bg-white/[0.05] transition-all flex items-center gap-1.5 cursor-pointer"
          data-platform="linux"
        >
          <span>🐧 Linux</span>
          <span class="text-[11px] px-1.5 py-0.2 rounded-full bg-white/[0.08] text-zinc-300">{linuxCount}</span>
        </button>

        <button
          type="button"
          class="platform-tab px-3 py-1.5 rounded-lg text-zinc-400 hover:text-white hover:bg-white/[0.05] transition-all flex items-center gap-1.5 cursor-pointer"
          data-platform="macos"
        >
          <span>🍎 macOS</span>
          <span class="text-[11px] px-1.5 py-0.2 rounded-full bg-white/[0.08] text-zinc-300">{macosCount}</span>
        </button>

        <button
          type="button"
          class="platform-tab px-3 py-1.5 rounded-lg text-zinc-400 hover:text-white hover:bg-white/[0.05] transition-all flex items-center gap-1.5 cursor-pointer"
          data-platform="windows"
        >
          <span>🪟 Windows</span>
          <span class="text-[11px] px-1.5 py-0.2 rounded-full bg-white/[0.08] text-zinc-300">{windowsCount}</span>
        </button>

        <button
          type="button"
          id="favorites-tab-btn"
          class="platform-tab px-3 py-1.5 rounded-lg text-amber-400 hover:text-amber-300 hover:bg-amber-400/10 transition-all flex items-center gap-1.5 cursor-pointer"
          data-platform="favorites"
        >
          <span>★ Saved</span>
          <span id="favorites-badge-count" class="text-[11px] px-1.5 py-0.2 rounded-full bg-amber-400/20 text-amber-300">0</span>
        </button>
      </div>
    </div>

    <!-- Bottom Row: Category Horizontal Scroller -->
    <div class="relative flex items-center">
      <div id="category-scroll-container" class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none scroll-smooth w-full pr-8">
        <button
          type="button"
          class="category-chip shrink-0 px-3 py-1.5 rounded-lg text-xs font-mono transition-all flex items-center gap-1.5 cursor-pointer bg-white/[0.1] text-white border border-white/[0.2] shadow-sm"
          data-category="all"
        >
          <span>✨</span>
          <span>All Categories</span>
        </button>

        {CATEGORIES.map((cat) => (
          <button
            type="button"
            class="category-chip shrink-0 px-3 py-1.5 rounded-lg text-xs font-mono transition-all flex items-center gap-1.5 cursor-pointer bg-white/[0.03] hover:bg-white/[0.07] text-zinc-400 hover:text-zinc-200 border border-white/[0.06] hover:border-white/[0.14]"
            data-category={cat.id}
          >
            <span>{cat.icon}</span>
            <span>{cat.name}</span>
          </button>
        ))}
      </div>

      <!-- Result Counter & Clear All -->
      <div class="hidden lg:flex items-center gap-2 pl-4 ml-auto shrink-0 border-l border-white/[0.08]">
        <span id="results-count-text" class="text-xs font-mono text-zinc-400 whitespace-nowrap">
          {totalCount} commands
        </span>
        <button
          id="reset-filters-btn"
          type="button"
          class="hidden text-[11px] font-mono text-rose-400 hover:text-rose-300 underline cursor-pointer"
        >
          Reset
        </button>
      </div>
    </div>
  </div>
</div>
