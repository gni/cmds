---
---

<div
  id="global-toast"
  class="fixed bottom-6 right-6 z-50 pointer-events-none transform translate-y-8 opacity-0 transition-all duration-200 ease-out"
  role="status"
  aria-live="polite"
>
  <div class="flex items-center gap-3 px-4 py-2.5 rounded-md bg-[var(--c-surface)] border border-[var(--c-border-strong)] text-[var(--c-text-primary)] shadow-2xl font-mono text-xs backdrop-blur-md">
    <div class="w-2 h-2 rounded-xs bg-[var(--c-success)]"></div>
    <span id="toast-message" class="font-medium">Copied command to clipboard</span>
    <span id="toast-length" class="text-[var(--c-text-muted)] text-[10px]"></span>
  </div>
</div>

<script is:inline>
  let toastTimeout = null;
  window.showToast = function(message, snippet) {
    const toast = document.getElementById('global-toast');
    const msgEl = document.getElementById('toast-message');
    const lenEl = document.getElementById('toast-length');
    if (!toast || !msgEl) return;

    msgEl.textContent = message || 'Copied to clipboard';
    if (lenEl && snippet) {
      lenEl.textContent = `[${snippet.length} chars]`;
    }

    toast.classList.remove('translate-y-8', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');

    if (toastTimeout) clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-8', 'opacity-0');
    }, 1800);
  };
</script>
