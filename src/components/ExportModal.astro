---
---

<div
  id="export-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
>
  <div class="w-full max-w-2xl bg-[var(--bg)] border border-[var(--border)] shadow-2xl rounded-lg overflow-hidden flex flex-col max-h-[85vh]">
    <!-- Header -->
    <div class="flex items-center justify-between px-5 py-3.5 border-b border-[var(--border)] bg-[var(--bg-subtle)]">
      <div>
        <h3 class="text-sm font-semibold text-[var(--text-primary)]">Export command catalog</h3>
        <p class="text-xs text-[var(--text-secondary)] font-mono">Select target format and export scope</p>
      </div>
      <button
        id="close-export-modal-btn"
        type="button"
        class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs font-mono p-1 cursor-pointer"
      >
        Close
      </button>
    </div>

    <!-- Configuration Options -->
    <div class="p-5 space-y-4 overflow-y-auto">
      <!-- Formats -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
        <button
          type="button"
          class="export-format-btn active p-3 rounded-md border border-[var(--border-focus)] bg-[var(--bg-muted)] text-left cursor-pointer transition-colors"
          data-format="markdown"
        >
          <div class="font-mono text-xs font-medium text-[var(--text-primary)] mb-1">Markdown</div>
          <div class="text-[11px] text-[var(--text-secondary)]">Document and table format</div>
        </button>

        <button
          type="button"
          class="export-format-btn p-3 rounded-md border border-[var(--border)] hover:border-[var(--text-primary)] bg-[var(--bg)] text-left cursor-pointer transition-colors"
          data-format="aliases"
        >
          <div class="font-mono text-xs font-medium text-[var(--text-primary)] mb-1">Shell aliases</div>
          <div class="text-[11px] text-[var(--text-secondary)]">Bash and Zsh profile scripts</div>
        </button>

        <button
          type="button"
          class="export-format-btn p-3 rounded-md border border-[var(--border)] hover:border-[var(--text-primary)] bg-[var(--bg)] text-left cursor-pointer transition-colors"
          data-format="json"
        >
          <div class="font-mono text-xs font-medium text-[var(--text-primary)] mb-1">Raw JSON</div>
          <div class="text-[11px] text-[var(--text-secondary)]">Full command schema</div>
        </button>
      </div>

      <!-- Scope -->
      <div class="flex items-center justify-between text-xs font-mono text-[var(--text-secondary)] pt-1">
        <span>Scope:</span>
        <div class="flex items-center gap-4">
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="export-scope" value="all" checked class="accent-[var(--text-primary)]" />
            <span class="text-[var(--text-primary)]">All commands</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="export-scope" value="favorites" class="accent-[var(--text-primary)]" />
            <span class="text-[var(--text-primary)]">Saved only</span>
          </label>
        </div>
      </div>

      <!-- Preview code textarea -->
      <textarea
        id="export-preview-box"
        readonly
        rows="9"
        class="w-full p-3 rounded-md bg-[var(--code-bg)] text-[var(--code-text)] border border-[var(--code-border)] font-mono text-xs select-all outline-none resize-none leading-relaxed"
      ></textarea>
    </div>

    <!-- Modal Footer -->
    <div class="flex items-center justify-between px-5 py-3 bg-[var(--bg-subtle)] border-t border-[var(--border)]">
      <span id="export-copied-status" class="text-xs font-mono text-emerald-600 dark:text-emerald-400 hidden">
        Copied to clipboard
      </span>
      <div class="flex items-center gap-2 ml-auto">
        <button
          id="export-copy-btn"
          type="button"
          class="px-3 py-1.5 rounded-md border border-[var(--border)] hover:border-[var(--text-primary)] bg-[var(--bg)] text-[var(--text-primary)] font-mono text-xs cursor-pointer"
        >
          Copy
        </button>
        <button
          id="export-download-btn"
          type="button"
          class="px-3 py-1.5 rounded-md bg-[var(--accent)] text-[var(--accent-text)] font-mono text-xs font-medium cursor-pointer"
        >
          Download
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const modal = document.getElementById('export-modal');
    const openBtn = document.getElementById('export-trigger-btn');
    const closeBtn = document.getElementById('close-export-modal-btn');
    const previewBox = document.getElementById('export-preview-box');
    const formatBtns = document.querySelectorAll('.export-format-btn');
    const scopeRadios = document.querySelectorAll('input[name="export-scope"]');
    const copyBtn = document.getElementById('export-copy-btn');
    const downloadBtn = document.getElementById('export-download-btn');
    const copiedStatus = document.getElementById('export-copied-status');

    let currentFormat = 'markdown';
    let currentScope = 'all';

    function getCommandsData() {
      const entries = Array.from(document.querySelectorAll('.command-entry'));
      let favs = [];
      try {
        favs = JSON.parse(localStorage.getItem('brain_cmds_favorites') || '[]');
      } catch (e) {}

      return entries
        .filter(entry => {
          if (currentScope === 'favorites') {
            return favs.includes(entry.getAttribute('data-id'));
          }
          return true;
        })
        .map(entry => {
          const id = entry.getAttribute('data-id');
          const title = entry.querySelector('h2')?.textContent?.trim() || '';
          const desc = entry.querySelector('p')?.textContent?.trim() || '';
          const cmd = entry.querySelector('.command-text-content')?.textContent?.trim() || '';
          const category = entry.getAttribute('data-category');
          const platforms = JSON.parse(entry.getAttribute('data-platforms') || '[]');
          return { id, title, desc, cmd, category, platforms };
        });
    }

    function generateContent() {
      const data = getCommandsData();
      if (currentFormat === 'json') {
        return JSON.stringify(data, null, 2);
      }

      if (currentFormat === 'aliases') {
        let out = `# Shell aliases generated by Brain cmds (https://loop.brain.fr/cmds)\n\n`;
        data.forEach(item => {
          const cleanId = item.id.replace(/[^a-zA-Z0-9]/g, '_');
          out += `# ${item.title}\n`;
          out += `alias cmd_${cleanId}="${item.cmd.replace(/"/g, '\\"')}"\n\n`;
        });
        return out;
      }

      let md = `# Terminal commands reference\nSource: https://loop.brain.fr/cmds\n\n`;
      let currentCat = '';
      data.forEach(item => {
        if (item.category !== currentCat) {
          currentCat = item.category;
          md += `\n## ${currentCat}\n\n`;
        }
        md += `### ${item.title}\n${item.desc}\n\n\`\`\`bash\n${item.cmd}\n\`\`\`\n\n`;
      });
      return md;
    }

    function updatePreview() {
      if (previewBox) {
        previewBox.value = generateContent();
      }
    }

    openBtn?.addEventListener('click', () => {
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      updatePreview();
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    formatBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        formatBtns.forEach(b => {
          b.classList.remove('active', 'border-[var(--border-focus)]', 'bg-[var(--bg-muted)]');
          b.classList.add('border-[var(--border)]', 'bg-[var(--bg)]');
        });
        btn.classList.add('active', 'border-[var(--border-focus)]', 'bg-[var(--bg-muted)]');
        btn.classList.remove('border-[var(--border)]', 'bg-[var(--bg)]');
        currentFormat = btn.getAttribute('data-format') || 'markdown';
        updatePreview();
      });
    });

    scopeRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        currentScope = e.target.value;
        updatePreview();
      });
    });

    copyBtn?.addEventListener('click', () => {
      if (previewBox) {
        navigator.clipboard.writeText(previewBox.value).then(() => {
          if (copiedStatus) {
            copiedStatus.classList.remove('hidden');
            setTimeout(() => copiedStatus.classList.add('hidden'), 1500);
          }
        });
      }
    });

    downloadBtn?.addEventListener('click', () => {
      const content = previewBox?.value || '';
      const extensions = { markdown: 'md', aliases: 'sh', json: 'json' };
      const filename = `brain-cmds.${extensions[currentFormat] || 'txt'}`;
      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  })();
</script>
