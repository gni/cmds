---
import { COMMANDS } from '../data/commands';
import { CATEGORIES } from '../data/categories';

const platformCode = {
  all: 'UNIV',
  linux: 'LNX',
  macos: 'MAC',
  windows: 'WIN'
};
---

<section id="workbench-root" class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
  <!-- Top Category Rail -->
  <div class="flex items-center gap-1 overflow-x-auto pb-3 mb-4 border-b border-[var(--c-border-subtle)] text-xs font-mono scrollbar-none">
    <button
      type="button"
      class="cat-filter-btn active px-3 py-1 rounded-md bg-[var(--c-surface-active)] text-[var(--c-text-primary)] font-medium border border-[var(--c-border-strong)] cursor-pointer shrink-0 transition-colors"
      data-category="all"
    >
      All Categories ({COMMANDS.length})
    </button>
    {CATEGORIES.map(cat => (
      <button
        type="button"
        class="cat-filter-btn px-3 py-1 rounded-md text-[var(--c-text-secondary)] hover:text-[var(--c-text-primary)] hover:bg-[var(--c-surface-hover)] border border-transparent cursor-pointer shrink-0 transition-colors"
        data-category={cat.id}
      >
        {cat.name}
      </button>
    ))}
  </div>

  <!-- Main 2-Column Split: Command Stream (Left) + Interactive Inspector (Right) -->
  <div id="workbench-view" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Left: Scrollable Command List (5 cols on lg) -->
    <div class="lg:col-span-6 space-y-2.5 max-h-[calc(100vh-140px)] overflow-y-auto pr-1" id="command-list-container">
      {COMMANDS.map((cmd, idx) => (
        <div
          id={`row-${cmd.id}`}
          class={`command-item-row group p-3.5 rounded-lg border border-[var(--c-border-subtle)] hover:border-[var(--c-border-default)] bg-[var(--c-surface)] cursor-pointer transition-all ${idx === 0 ? 'command-row-active' : ''}`}
          data-id={cmd.id}
          data-index={idx}
          data-platforms={JSON.stringify(cmd.platforms)}
          data-category={cmd.category}
          data-title={cmd.title.toLowerCase()}
          data-description={cmd.description.toLowerCase()}
          data-command={cmd.command}
          data-tags={JSON.stringify(cmd.tags)}
          data-danger={cmd.dangerLevel}
        >
          <div class="flex items-center justify-between gap-2 mb-1.5 text-[11px] font-mono text-[var(--c-text-muted)]">
            <div class="flex items-center gap-2">
              <span class="text-[var(--c-text-secondary)] font-medium">{cmd.category}</span>
              <span class="text-[var(--c-border-default)]">/</span>
              <span class="text-[var(--c-text-muted)]">
                {cmd.platforms.map(p => platformCode[p] || p).join(' • ')}
              </span>
            </div>

            <div class="flex items-center gap-2">
              {cmd.dangerLevel !== 'safe' && (
                <span class="text-[10px] font-semibold text-[var(--c-warning)] uppercase tracking-wider">
                  {cmd.dangerLevel === 'dangerous' ? 'ROOT' : 'CAUTION'}
                </span>
              )}
              <span class="item-fav-icon text-[var(--c-text-muted)] group-hover:text-[var(--c-warning)]" data-id={cmd.id}>
                ★
              </span>
            </div>
          </div>

          <h3 class="text-sm font-semibold text-[var(--c-text-primary)] group-hover:text-white transition-colors mb-1.5 leading-snug">
            {cmd.title}
          </h3>

          <div class="p-2 rounded bg-[var(--c-terminal-bg)] border border-[var(--c-terminal-border)] font-mono text-xs text-[var(--c-text-primary)] flex items-center justify-between gap-2 overflow-hidden">
            <span class="truncate font-medium text-slate-200">$ {cmd.command}</span>
            <span class="text-[10px] text-[var(--c-text-muted)] shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
              Inspect →
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Right: Sticky Command Inspector & Live Terminal Simulator (6 cols on lg) -->
    <div class="lg:col-span-6 sticky top-28 space-y-4" id="inspector-container">
      <div class="rounded-xl border border-[var(--c-border-default)] bg-[var(--c-surface)] p-5 shadow-2xl space-y-5">
        <!-- Inspector Top Header -->
        <div class="flex items-start justify-between gap-3 border-b border-[var(--c-border-subtle)] pb-4">
          <div>
            <div class="flex items-center gap-2 text-xs font-mono text-[var(--c-text-muted)] mb-1">
              <span id="inspector-category" class="font-medium text-[var(--c-text-primary)]">quick-wins</span>
              <span>/</span>
              <span id="inspector-platforms">LINUX • MACOS</span>
              <span>/</span>
              <span id="inspector-danger" class="text-[var(--c-warning)] font-semibold">CAUTION</span>
            </div>
            <h2 id="inspector-title" class="text-lg font-bold text-[var(--c-text-primary)] tracking-tight">
              Kill Process by Port Number
            </h2>
          </div>

          <!-- Quick Action Group -->
          <div class="flex items-center gap-2 shrink-0">
            <button
              id="inspector-star-btn"
              type="button"
              class="p-2 rounded-md border border-[var(--c-border-default)] hover:border-[var(--c-border-strong)] bg-[var(--c-surface-hover)] text-[var(--c-text-secondary)] hover:text-[var(--c-warning)] transition-colors cursor-pointer"
              title="Save to favorites"
            >
              ★
            </button>
            <button
              id="inspector-copy-btn"
              type="button"
              class="px-3.5 py-2 rounded-md bg-[var(--c-accent)] text-[var(--c-accent-fg)] font-mono text-xs font-semibold hover:opacity-90 active:scale-95 transition-all cursor-pointer shadow-sm flex items-center gap-1.5"
            >
              <span>Copy Command</span>
              <kbd class="text-[10px] opacity-70">C</kbd>
            </button>
          </div>
        </div>

        <p id="inspector-description" class="text-xs text-[var(--c-text-secondary)] leading-relaxed">
          Finds and forcefully terminates whichever process is holding a specific TCP port hostage.
        </p>

        <!-- Interactive Terminal Simulator Pane -->
        <div class="rounded-lg border border-[var(--c-terminal-border)] bg-[var(--c-terminal-bg)] text-[var(--c-terminal-text)] overflow-hidden font-mono text-xs">
          <div class="flex items-center justify-between px-3.5 py-2 bg-[var(--c-terminal-header)] border-b border-[var(--c-terminal-border)] select-none">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56] inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e] inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f] inline-block"></span>
              <span class="ml-2 text-xs text-slate-300 font-medium">terminal@loop.brain.fr ~ zsh</span>
            </div>
            <button
              id="inspector-exec-btn"
              type="button"
              class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors cursor-pointer text-[10px]"
            >
              Execute (↵)
            </button>
          </div>

          <div class="p-4 space-y-2 min-h-[120px]">
            <div class="flex items-center gap-2 text-slate-300">
              <span class="text-slate-200 font-semibold">user@brain</span>
              <span class="text-slate-500">:</span>
              <span class="text-sky-400">~</span>
              <span class="text-slate-500">$</span>
              <span id="inspector-command-text" class="text-white font-medium select-all">
                kill -9 $(lsof -t -i:3000)
              </span>
              <span class="w-2 h-4 bg-slate-400 inline-block align-middle ml-0.5"></span>
            </div>
            <pre id="inspector-terminal-output" class="text-slate-300 text-xs pl-3 border-l-2 border-slate-700 whitespace-pre-wrap leading-relaxed">[process 48102 killed: node /workspace/server.js listening on port 3000]
port 3000 is now free.</pre>
          </div>
        </div>

        <!-- Dynamic Parameter Variables -->
        <div id="inspector-params-section" class="space-y-2 pt-2 border-t border-[var(--c-border-subtle)]">
          <span class="text-xs font-mono font-medium text-[var(--c-text-primary)]">Configure Parameters:</span>
          <div id="inspector-params-inputs" class="flex flex-wrap items-center gap-2">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Cross-Platform Alternative -->
        <div id="inspector-alt-section" class="space-y-2 pt-2 border-t border-[var(--c-border-subtle)]">
          <span class="text-xs font-mono font-medium text-[var(--c-text-primary)]">Platform Variants:</span>
          <div id="inspector-alt-tabs" class="space-y-2">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- ProTip and Caveat -->
        <div id="inspector-note-box" class="p-3 rounded-md bg-[var(--c-surface-hover)] border border-[var(--c-border-subtle)] text-xs font-mono text-[var(--c-text-secondary)]">
          <span class="font-semibold text-[var(--c-text-primary)]">Operational Note:</span>
          <span id="inspector-note-text">For Linux systems without lsof installed, use "fuser -k 3000/tcp".</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Grid / Catalog Mode (Alternative View) -->
  <div id="catalog-view" class="hidden grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
    <!-- Populated by CommandCard.astro -->
  </div>
</section>

<!-- Embedded Client Engine for Workbench -->
<script is:inline define:vars={{ COMMANDS }}>
  (function() {
    let activeIndex = 0;
    let currentFilterCategory = 'all';
    let currentFilterPlatform = 'all';
    let searchQuery = '';
    let favorites = [];

    try {
      favorites = JSON.parse(localStorage.getItem('brain_cmds_saved') || '[]');
    } catch (e) {
      favorites = [];
    }

    const rows = Array.from(document.querySelectorAll('.command-item-row'));
    const heroInput = document.getElementById('hero-search-input');
    const heroClear = document.getElementById('hero-clear-search-btn');
    const platformPills = document.querySelectorAll('.platform-pill');
    const catButtons = document.querySelectorAll('.cat-filter-btn');
    const favCountPill = document.getElementById('fav-count-pill');

    const inspCategory = document.getElementById('inspector-category');
    const inspPlatforms = document.getElementById('inspector-platforms');
    const inspDanger = document.getElementById('inspector-danger');
    const inspTitle = document.getElementById('inspector-title');
    const inspDesc = document.getElementById('inspector-description');
    const inspCmdText = document.getElementById('inspector-command-text');
    const inspOutput = document.getElementById('inspector-terminal-output');
    const inspParamsInputs = document.getElementById('inspector-params-inputs');
    const inspAltTabs = document.getElementById('inspector-alt-tabs');
    const inspNoteText = document.getElementById('inspector-note-text');
    const inspNoteBox = document.getElementById('inspector-note-box');
    const inspCopyBtn = document.getElementById('inspector-copy-btn');
    const inspExecBtn = document.getElementById('inspector-exec-btn');
    const inspStarBtn = document.getElementById('inspector-star-btn');

    let paramValues = {};

    function updateFavBadges() {
      if (favCountPill) favCountPill.textContent = String(favorites.length);
      rows.forEach(row => {
        const id = row.getAttribute('data-id');
        const icon = row.querySelector('.item-fav-icon');
        if (icon) {
          if (favorites.includes(id)) {
            icon.classList.add('text-[var(--c-warning)]');
          } else {
            icon.classList.remove('text-[var(--c-warning)]');
          }
        }
      });
    }
    updateFavBadges();

    function renderInspector(cmd) {
      if (!cmd) return;
      inspCategory.textContent = cmd.category;
      inspPlatforms.textContent = cmd.platforms.map(p => p.toUpperCase()).join(' • ');
      
      if (cmd.dangerLevel !== 'safe') {
        inspDanger.textContent = cmd.dangerLevel === 'dangerous' ? 'ROOT' : 'CAUTION';
        inspDanger.classList.remove('hidden');
      } else {
        inspDanger.classList.add('hidden');
      }

      inspTitle.textContent = cmd.title;
      inspDesc.textContent = cmd.description;
      
      // Compute command with current params
      paramValues = {};
      if (cmd.params) {
        cmd.params.forEach(p => {
          paramValues[p.name] = p.default;
        });
      }

      function computeActiveCommand() {
        let text = cmd.command;
        for (const [key, val] of Object.entries(paramValues)) {
          const regex = new RegExp(`\\{\\{${key}\\}\\}`, 'g');
          text = text.replace(regex, val);
        }
        return text;
      }

      inspCmdText.textContent = computeActiveCommand();
      inspOutput.textContent = cmd.outputExample || `[executed] ${computeActiveCommand()}\nstatus: exit code 0 (success)`;

      // Render Parameters Inputs
      inspParamsInputs.innerHTML = '';
      if (cmd.params && cmd.params.length > 0) {
        document.getElementById('inspector-params-section').classList.remove('hidden');
        cmd.params.forEach(p => {
          const wrap = document.createElement('div');
          wrap.className = 'flex items-center gap-1.5 bg-[var(--c-surface-hover)] border border-[var(--c-border-default)] px-2.5 py-1 rounded-md text-xs font-mono';
          wrap.innerHTML = `
            <span class="text-[var(--c-text-muted)]">${p.label}:</span>
            <input type="text" value="${p.default}" class="bg-transparent text-[var(--c-text-primary)] font-semibold outline-none w-24" />
          `;
          const input = wrap.querySelector('input');
          input.addEventListener('input', (e) => {
            paramValues[p.name] = e.target.value;
            inspCmdText.textContent = computeActiveCommand();
          });
          inspParamsInputs.appendChild(wrap);
        });
      } else {
        document.getElementById('inspector-params-section').classList.add('hidden');
      }

      // Render Alternatives
      inspAltTabs.innerHTML = '';
      if (cmd.alternatives && cmd.alternatives.length > 0) {
        document.getElementById('inspector-alt-section').classList.remove('hidden');
        cmd.alternatives.forEach(alt => {
          const altEl = document.createElement('div');
          altEl.className = 'p-2 rounded border border-[var(--c-border-subtle)] bg-[var(--c-terminal-bg)] font-mono text-xs flex items-center justify-between gap-2';
          altEl.innerHTML = `
            <div>
              <span class="text-[10px] font-bold text-[var(--c-text-muted)] uppercase mr-2">[${alt.platform}]</span>
              <span class="text-slate-300 select-all">${alt.command}</span>
            </div>
            <button type="button" class="px-2 py-0.5 rounded border border-slate-700 bg-slate-800 text-[10px] text-slate-300 hover:text-white cursor-pointer shrink-0">
              Copy
            </button>
          `;
          altEl.querySelector('button').addEventListener('click', () => {
            navigator.clipboard.writeText(alt.command).then(() => {
              window.showToast?.(`Copied ${alt.platform} alternative`, alt.command);
            });
          });
          inspAltTabs.appendChild(altEl);
        });
      } else {
        document.getElementById('inspector-alt-section').classList.add('hidden');
      }

      // ProTip Note
      if (cmd.proTip) {
        inspNoteBox.classList.remove('hidden');
        inspNoteText.textContent = cmd.proTip;
      } else {
        inspNoteBox.classList.add('hidden');
      }

      // Star state
      if (favorites.includes(cmd.id)) {
        inspStarBtn.classList.add('text-[var(--c-warning)]');
      } else {
        inspStarBtn.classList.remove('text-[var(--c-warning)]');
      }
    }

    // Initialize with first command
    renderInspector(COMMANDS[0]);

    // Row Click selection
    rows.forEach((row, idx) => {
      row.addEventListener('click', () => {
        rows.forEach(r => r.classList.remove('command-row-active'));
        row.classList.add('command-row-active');
        activeIndex = idx;
        const id = row.getAttribute('data-id');
        const cmd = COMMANDS.find(c => c.id === id);
        renderInspector(cmd);
      });
    });

    // Execute Simulator in Inspector
    let execTimeout = null;
    inspExecBtn?.addEventListener('click', () => {
      const activeCmd = COMMANDS[activeIndex];
      if (!activeCmd) return;
      if (execTimeout) clearTimeout(execTimeout);

      inspOutput.textContent = 'executing...';
      inspOutput.style.opacity = '0.4';

      execTimeout = setTimeout(() => {
        inspOutput.textContent = activeCmd.outputExample || `[executed] ${inspCmdText.textContent}\nexit code: 0 (success)`;
        inspOutput.style.opacity = '1';
      }, 150);
    });

    // Copy from Inspector
    inspCopyBtn?.addEventListener('click', () => {
      const text = inspCmdText.textContent?.trim() || '';
      navigator.clipboard.writeText(text).then(() => {
        window.showToast?.('Copied command to clipboard', text);
      });
    });

    // Star from Inspector
    inspStarBtn?.addEventListener('click', () => {
      const activeCmd = COMMANDS[activeIndex];
      if (!activeCmd) return;
      const isFav = favorites.includes(activeCmd.id);
      if (isFav) {
        favorites = favorites.filter(f => f !== activeCmd.id);
      } else {
        favorites.push(activeCmd.id);
      }
      try {
        localStorage.setItem('brain_cmds_saved', JSON.stringify(favorites));
      } catch (e) {}
      updateFavBadges();
      renderInspector(activeCmd);
    });

    // Filter Logic
    function applyWorkbenchFilters() {
      const q = searchQuery.toLowerCase().trim();
      let visibleRows = [];

      rows.forEach(row => {
        const id = row.getAttribute('data-id');
        const title = row.getAttribute('data-title') || '';
        const desc = row.getAttribute('data-description') || '';
        const cmd = row.getAttribute('data-command') || '';
        const tags = JSON.parse(row.getAttribute('data-tags') || '[]');
        const platforms = JSON.parse(row.getAttribute('data-platforms') || '[]');
        const category = row.getAttribute('data-category');

        const matchQuery = !q || title.includes(q) || desc.includes(q) || cmd.includes(q) || tags.some(t => t.includes(q));
        
        let matchPlatform = false;
        if (currentFilterPlatform === 'all') matchPlatform = true;
        else if (currentFilterPlatform === 'favorites') matchPlatform = favorites.includes(id);
        else matchPlatform = platforms.includes('all') || platforms.includes(currentFilterPlatform);

        const matchCat = (currentFilterCategory === 'all') || (category === currentFilterCategory);

        if (matchQuery && matchPlatform && matchCat) {
          row.classList.remove('hidden');
          visibleRows.push(row);
        } else {
          row.classList.add('hidden');
        }
      });

      // Update active selection to first visible row if needed
      if (visibleRows.length > 0) {
        if (!visibleRows.some(r => r.classList.contains('command-row-active'))) {
          rows.forEach(r => r.classList.remove('command-row-active'));
          visibleRows[0].classList.add('command-row-active');
          const id = visibleRows[0].getAttribute('data-id');
          renderInspector(COMMANDS.find(c => c.id === id));
        }
      }
    }

    // Search input
    heroInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      if (heroClear) {
        if (searchQuery) heroClear.classList.remove('hidden');
        else heroClear.classList.add('hidden');
      }
      applyWorkbenchFilters();
    });

    heroClear?.addEventListener('click', () => {
      if (heroInput) heroInput.value = '';
      searchQuery = '';
      heroClear.classList.add('hidden');
      heroInput?.focus();
      applyWorkbenchFilters();
    });

    // Category Buttons
    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.classList.remove('active', 'bg-[var(--c-surface-active)]', 'text-[var(--c-text-primary)]', 'border-[var(--c-border-strong)]');
          b.classList.add('text-[var(--c-text-secondary)]', 'border-transparent');
        });
        btn.classList.add('active', 'bg-[var(--c-surface-active)]', 'text-[var(--c-text-primary)]', 'border-[var(--c-border-strong)]');
        btn.classList.remove('text-[var(--c-text-secondary)]', 'border-transparent');
        currentFilterCategory = btn.getAttribute('data-category') || 'all';
        applyWorkbenchFilters();
      });
    });

    // Platform Pills
    platformPills.forEach(pill => {
      pill.addEventListener('click', () => {
        platformPills.forEach(p => {
          p.classList.remove('active', 'border-[var(--c-accent)]', 'bg-[var(--c-accent)]', 'text-[var(--c-accent-fg)]');
          p.classList.add('border-[var(--c-border-default)]', 'bg-[var(--c-surface)]', 'text-[var(--c-text-secondary)]');
        });
        pill.classList.add('active', 'border-[var(--c-accent)]', 'bg-[var(--c-accent)]', 'text-[var(--c-accent-fg)]');
        pill.classList.remove('border-[var(--c-border-default)]', 'bg-[var(--c-surface)]', 'text-[var(--c-text-secondary)]');
        currentFilterPlatform = pill.getAttribute('data-platform') || 'all';
        applyWorkbenchFilters();
      });
    });

    // Global Keyboard Nav (`j`, `k`, `c`, `Enter`)
    window.addEventListener('keydown', (e) => {
      const isInput = document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'TEXTAREA';
      if (isInput) return;

      const visible = rows.filter(r => !r.classList.contains('hidden'));
      if (visible.length === 0) return;
      const currentIdx = visible.findIndex(r => r.classList.contains('command-row-active'));

      if (e.key === 'j' || e.key === 'ArrowDown') {
        e.preventDefault();
        const next = (currentIdx + 1) % visible.length;
        visible[currentIdx]?.classList.remove('command-row-active');
        visible[next]?.classList.add('command-row-active');
        visible[next]?.scrollIntoView({ block: 'nearest' });
        const id = visible[next].getAttribute('data-id');
        renderInspector(COMMANDS.find(c => c.id === id));
      } else if (e.key === 'k' || e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = (currentIdx - 1 + visible.length) % visible.length;
        visible[currentIdx]?.classList.remove('command-row-active');
        visible[prev]?.classList.add('command-row-active');
        visible[prev]?.scrollIntoView({ block: 'nearest' });
        const id = visible[prev].getAttribute('data-id');
        renderInspector(COMMANDS.find(c => c.id === id));
      } else if (e.key === 'c' || e.key === 'C') {
        e.preventDefault();
        inspCopyBtn?.click();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        inspExecBtn?.click();
      }
    });

    // View Switcher (Workbench vs Catalog)
    const viewWbBtn = document.getElementById('view-workbench-btn');
    const viewGridBtn = document.getElementById('view-grid-btn');
    const wbView = document.getElementById('workbench-view');
    const catView = document.getElementById('catalog-view');

    viewWbBtn?.addEventListener('click', () => {
      viewWbBtn.classList.add('bg-[var(--c-accent)]', 'text-[var(--c-accent-fg)]');
      viewWbBtn.classList.remove('text-[var(--c-text-secondary)]');
      viewGridBtn.classList.remove('bg-[var(--c-accent)]', 'text-[var(--c-accent-fg)]');
      viewGridBtn.classList.add('text-[var(--c-text-secondary)]');

      wbView.classList.remove('hidden');
      catView.classList.add('hidden');
    });

    viewGridBtn?.addEventListener('click', () => {
      viewGridBtn.classList.add('bg-[var(--c-accent)]', 'text-[var(--c-accent-fg)]');
      viewGridBtn.classList.remove('text-[var(--c-text-secondary)]');
      viewWbBtn.classList.remove('bg-[var(--c-accent)]', 'text-[var(--c-accent-fg)]');
      viewWbBtn.classList.add('text-[var(--c-text-secondary)]');

      wbView.classList.add('hidden');
      catView.classList.remove('hidden');
    });
  })();
</script>
