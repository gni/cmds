---
interface Props {
  totalCommands: number;
}

const { totalCommands } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<header class="sticky top-0 z-40 w-full border-b border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
    <!-- Brand / Logo -->
    <div class="flex items-center gap-3">
      <a href={baseUrl} class="flex items-center gap-2.5 text-[var(--text-primary)] hover:opacity-80 transition-opacity no-underline">
        <svg class="w-5 h-5 text-current shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 3v18" />
          <path d="M3 12h18" />
          <circle cx="12" cy="12" r="4" />
        </svg>
        <span class="font-semibold text-sm tracking-tight">Brain</span>
        <span class="text-xs text-[var(--text-muted)] font-mono">/ cmds</span>
      </a>

      <span class="hidden md:inline-block text-xs text-[var(--text-muted)] border-l border-[var(--border)] pl-3">
        {totalCommands} commands
      </span>
    </div>

    <!-- Center: Search Trigger -->
    <div class="flex-1 max-w-md hidden sm:block">
      <button
        id="header-search-btn"
        type="button"
        class="w-full flex items-center justify-between px-3 py-1.5 rounded-md border border-[var(--border)] bg-[var(--bg-subtle)] hover:bg-[var(--bg-muted)] text-[var(--text-muted)] hover:text-[var(--text-primary)] text-xs transition-colors cursor-pointer"
      >
        <div class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Search commands and flags...</span>
        </div>
        <kbd class="px-1.5 py-0.5 text-[10px] font-mono rounded border border-[var(--border)] bg-[var(--bg)] text-[var(--text-secondary)]">⌘K</kbd>
      </button>
    </div>

    <!-- Right: Export & Repo Link -->
    <div class="flex items-center gap-3 text-xs font-mono">
      <button
        id="export-trigger-btn"
        type="button"
        class="px-2.5 py-1 rounded border border-[var(--border)] hover:border-[var(--text-primary)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
      >
        Export
      </button>

      <a
        href="https://github.com/gni/cmds"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
      >
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>
