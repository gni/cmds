---
interface Props {
  totalCommands: number;
}

const { totalCommands } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<header class="sticky top-0 z-40 w-full border-b border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
    <!-- Brand / Logo -->
    <div class="flex items-center gap-3">
      <a href={baseUrl} class="flex items-center gap-2 text-[var(--text-primary)] hover:opacity-80 transition-opacity no-underline">
        <svg class="w-4 h-4 text-current shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 17 10 11 4 5"></polyline>
          <line x1="12" y1="19" x2="20" y2="19"></line>
        </svg>
        <span class="font-bold text-sm tracking-tight font-mono">cmds</span>
      </a>

      <span class="hidden md:inline-block text-xs text-[var(--text-muted)] border-l border-[var(--border)] pl-3">
        {totalCommands} commands
      </span>
    </div>

    <!-- Center: Search Trigger -->
    <div class="flex-1 max-w-md hidden sm:block">
      <button
        id="header-search-btn"
        type="button"
        class="w-full flex items-center justify-between px-3 py-1.5 rounded-md border border-[var(--border)] bg-[var(--bg-subtle)] hover:bg-[var(--bg-muted)] text-[var(--text-muted)] hover:text-[var(--text-primary)] text-xs transition-colors cursor-pointer"
      >
        <div class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Search commands and flags...</span>
        </div>
        <kbd class="px-1.5 py-0.5 text-[10px] font-mono rounded border border-[var(--border)] bg-[var(--bg)] text-[var(--text-secondary)]">⌘K</kbd>
      </button>
    </div>

    <!-- Right: Export & Repo Link -->
    <div class="flex items-center gap-3 text-xs font-mono">
      <button
        id="export-trigger-btn"
        type="button"
        class="px-2.5 py-1 rounded border border-[var(--border)] hover:border-[var(--text-primary)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
      >
        Export
      </button>

      <a
        href="https://github.com/gni/cmds"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center p-1.5 rounded border border-[var(--border)] hover:border-[var(--text-primary)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
        title="Lucian BLETAN - cmds"
        aria-label="Lucian BLETAN - cmds"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.492 2.492 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z" />
        </svg>
      </a>
    </div>
  </div>
</header>
