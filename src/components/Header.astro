---
interface Props {
  totalCommands: number;
}

const { totalCommands } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 px-4 py-2 bg-[var(--brain-accent)] text-[var(--brain-accent-text)] text-sm font-mono">
  Skip to content
</a>

<header class="w-full border-b border-[var(--brain-border-subtle)] bg-[var(--brain-surface-primary)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Left: Brain Wordmark -->
    <div class="flex items-center gap-6">
      <a href={baseUrl} class="flex items-center gap-2 text-[var(--brain-text-primary)] hover:opacity-80 transition-opacity no-underline">
        <!-- Brain Geometric Mark -->
        <svg class="w-4 h-4 text-current shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 3v18" />
          <path d="M3 12h18" />
          <circle cx="12" cy="12" r="4" />
        </svg>
        <span class="font-semibold text-sm tracking-tight text-[var(--brain-text-primary)]">Brain</span>
        <span class="text-xs text-[var(--brain-text-secondary)] font-mono">/ cmds</span>
      </a>

      <span class="text-xs text-[var(--brain-text-tertiary)] hidden md:inline font-mono">
        {totalCommands} operational commands
      </span>
    </div>

    <!-- Right: Metadata and Quick Actions -->
    <div class="flex items-center gap-4 text-xs font-mono">
      <button
        id="header-palette-btn"
        type="button"
        class="hidden sm:flex items-center gap-2 px-2.5 py-1 rounded border border-[var(--brain-border-subtle)] hover:border-[var(--brain-border-default)] text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] bg-[var(--brain-surface-secondary)] transition-colors cursor-pointer"
      >
        <span>Search</span>
        <kbd class="text-[10px] text-[var(--brain-text-tertiary)] border border-[var(--brain-border-subtle)] px-1 rounded">⌘K</kbd>
      </button>

      <button
        id="export-trigger-btn"
        type="button"
        class="text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] transition-colors cursor-pointer"
      >
        Export
      </button>

      <span class="text-[var(--brain-border-default)] hidden sm:inline">|</span>

      <a
        href="https://github.com/gni/cmds"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[var(--brain-text-secondary)] hover:text-[var(--brain-text-primary)] transition-colors"
      >
        gni/cmds
      </a>
    </div>
  </div>
</header>
