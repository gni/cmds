---
interface Props {
  totalCount: number;
}

const { totalCount } = Astro.props;
---

<section class="border-b border-[var(--brain-border-subtle)] bg-[var(--brain-surface-primary)] pt-10 pb-12 subtle-grid">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Top Context Row -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono text-[var(--brain-text-secondary)] mb-3">
          <span class="font-medium text-[var(--brain-text-primary)]">Brain</span>
          <span>/</span>
          <span>loop.brain.fr/cmds</span>
          <span>/</span>
          <span>Linux, macOS & Windows</span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-[var(--brain-text-primary)] leading-tight mb-3">
          Curated terminal commands for systems & development
        </h1>

        <p class="text-sm sm:text-base text-[var(--brain-text-secondary)] max-w-2xl leading-relaxed">
          A verified operational catalog of {totalCount} terminal commands with live parameter customization, native OS alternatives, and one-click execution.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2.5 shrink-0">
        <button
          type="button"
          onclick="document.getElementById('search-input')?.focus();"
          class="btn-primary px-3.5 py-2 rounded-md font-mono text-xs font-medium transition-all active:scale-[0.98] cursor-pointer shadow-sm flex items-center gap-2"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Find command (/)</span>
        </button>

        <button
          type="button"
          onclick="window.openPalette && window.openPalette();"
          class="btn-secondary px-3.5 py-2 rounded-md font-mono text-xs font-medium transition-all active:scale-[0.98] cursor-pointer flex items-center gap-1.5"
        >
          <span>Palette</span>
          <kbd class="text-[10px] px-1 py-0.5 rounded border border-[var(--brain-border-default)] bg-[var(--brain-surface-subtle)] text-[var(--brain-text-secondary)]">⌘K</kbd>
        </button>
      </div>
    </div>

    <!-- Live Interactive Terminal Window -->
    <div class="rounded-lg border border-[var(--brain-terminal-border)] bg-[var(--brain-terminal-bg)] text-[var(--brain-terminal-text)] shadow-2xl overflow-hidden font-mono">
      <!-- Terminal Titlebar with Window Controls -->
      <div class="flex items-center justify-between px-4 py-2.5 bg-[var(--brain-terminal-header)] border-b border-[var(--brain-terminal-border)] select-none">
        <div class="flex items-center gap-2">
          <!-- Terminal Window Buttons -->
          <span class="w-3 h-3 rounded-full bg-[#ff5f56] inline-block shadow-2xs"></span>
          <span class="w-3 h-3 rounded-full bg-[#ffbd2e] inline-block shadow-2xs"></span>
          <span class="w-3 h-3 rounded-full bg-[#27c93f] inline-block shadow-2xs"></span>
          <span class="ml-2.5 text-xs text-slate-300 font-medium">terminal@loop.brain.fr ~ zsh</span>
        </div>
        <div class="flex items-center gap-2 text-[11px] text-slate-400">
          <span>INTERACTIVE PREVIEW</span>
        </div>
      </div>

      <!-- Terminal Body -->
      <div id="terminal-screen" class="p-4 sm:p-5 text-xs sm:text-sm min-h-[140px] flex flex-col justify-between">
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-slate-200 font-semibold">user@brain</span>
            <span class="text-slate-500">:</span>
            <span class="text-sky-400">~</span>
            <span class="text-slate-400">$</span>
            <span id="terminal-typed-cmd" class="text-white font-medium">kill -9 $(lsof -t -i:3000)</span>
            <span class="w-2 h-4 bg-slate-400 inline-block align-middle ml-0.5"></span>
          </div>
          <pre id="terminal-output" class="text-slate-300 text-xs pl-4 border-l-2 border-slate-700 whitespace-pre-wrap leading-relaxed">[process 48102 killed: node /workspace/server.js listening on port 3000]
port 3000 is now free.</pre>
        </div>

        <!-- Quick Simulator Presets -->
        <div class="pt-3 mt-3 border-t border-slate-800/80 flex flex-wrap items-center gap-2 text-xs">
          <span class="text-slate-400 text-[11px]">Test in preview:</span>
          <button
            type="button"
            class="terminal-sim-btn px-2.5 py-1 rounded border border-slate-700 bg-slate-800/80 hover:bg-slate-700 hover:text-white text-slate-200 transition-colors cursor-pointer text-xs"
            data-cmd="kill -9 $(lsof -t -i:3000)"
            data-output="[process 48102 killed: node /workspace/server.js listening on port 3000]&#10;port 3000 is now free."
          >
            Kill Port 3000
          </button>
          <button
            type="button"
            class="terminal-sim-btn px-2.5 py-1 rounded border border-slate-700 bg-slate-800/80 hover:bg-slate-700 hover:text-white text-slate-200 transition-colors cursor-pointer text-xs"
            data-cmd="curl -s https://ifconfig.me"
            data-output="198.51.100.42&#10;[HTTP 200 OK - 38ms]"
          >
            Check Public IP
          </button>
          <button
            type="button"
            class="terminal-sim-btn px-2.5 py-1 rounded border border-slate-700 bg-slate-800/80 hover:bg-slate-700 hover:text-white text-slate-200 transition-colors cursor-pointer text-xs"
            data-cmd="git reset --soft HEAD~1"
            data-output="HEAD is now at 8f3d10c feat(api): prepare clean endpoint&#10;Staged changes preserved."
          >
            Undo Git Commit
          </button>
          <button
            type="button"
            class="terminal-sim-btn px-2.5 py-1 rounded border border-slate-700 bg-slate-800/80 hover:bg-slate-700 hover:text-white text-slate-200 transition-colors cursor-pointer text-xs"
            data-cmd="docker system prune -af --volumes"
            data-output="Deleted Containers: 14&#10;Deleted Images: 28&#10;Total reclaimed space: 14.82GB"
          >
            Docker Prune
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const typedEl = document.getElementById('terminal-typed-cmd');
  const outputEl = document.getElementById('terminal-output');
  const simButtons = document.querySelectorAll('.terminal-sim-btn');
  let activeTimeout = null;

  function simulateCommand(cmd, output) {
    if (activeTimeout) clearTimeout(activeTimeout);
    if (!typedEl || !outputEl) return;

    typedEl.textContent = '';
    outputEl.textContent = 'executing...';
    outputEl.style.opacity = '0.4';

    let charIndex = 0;
    const speed = Math.max(10, Math.min(22, Math.floor(600 / Math.max(cmd.length, 1))));

    function typeNextChar() {
      if (charIndex < cmd.length) {
        typedEl.textContent += cmd.charAt(charIndex);
        charIndex++;
        activeTimeout = setTimeout(typeNextChar, speed + (Math.random() * 8 - 4));
      } else {
        activeTimeout = setTimeout(() => {
          outputEl.textContent = output;
          outputEl.style.opacity = '1';
        }, 140);
      }
    }

    typeNextChar();
  }

  simButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-cmd') || '';
      const output = btn.getAttribute('data-output') || '';
      simulateCommand(cmd, output);
    });
  });

  window.runInTerminal = function(cmd, output) {
    const defaultOutput = output && output.trim() ? output.trim() : `Process exited with code 0.\nDone.`;
    const terminal = document.getElementById('terminal-screen');
    if (terminal && window.scrollY > 280) {
      terminal.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    simulateCommand(cmd, defaultOutput);
  };
</script>
