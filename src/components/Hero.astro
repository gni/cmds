---
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden">
  <!-- Subtle ambient background gradients -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] ambient-glow-1 blur-3xl pointer-events-none opacity-40"></div>
  <div class="absolute top-1/3 left-1/4 w-[400px] h-[300px] ambient-glow-2 blur-3xl pointer-events-none opacity-20"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <!-- Top Tagline Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.1] text-zinc-300 font-mono text-xs mb-6 backdrop-blur-md shadow-lg shadow-black/40">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="text-zinc-400">HOSTED AT</span>
        <span class="text-white font-semibold">loop.brain.fr/cmds</span>
        <span class="text-zinc-500">•</span>
        <span class="text-indigo-400">UNIFIED TERMINAL BIBLE</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white mb-6 leading-[1.1]">
        Every Terminal Superpower. <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">
          One Instant Command Hub.
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-zinc-400 leading-relaxed font-light mb-8 max-w-2xl mx-auto">
        Stop digging through 20-year-old forum threads and bloated manuals. 
        Curated, battle-tested terminal commands for <span class="text-zinc-200 font-medium">Linux</span>, <span class="text-zinc-200 font-medium">macOS</span>, and <span class="text-zinc-200 font-medium">Windows</span> with live parameter builders.
      </p>

      <!-- Quick Action Jumpers -->
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-mono">
        <button
          type="button"
          onclick="document.getElementById('search-input')?.focus(); window.cmdAudio?.playClick();"
          class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white text-black font-semibold hover:bg-zinc-200 transition-all shadow-lg shadow-white/10 hover:shadow-white/20 active:scale-95 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Find Any Command (/)</span>
        </button>

        <button
          type="button"
          onclick="window.openPalette && window.openPalette(); window.cmdAudio?.playWhoosh();"
          class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/[0.06] hover:bg-white/[0.1] border border-white/[0.12] text-zinc-200 font-medium transition-all active:scale-95 cursor-pointer backdrop-blur-md"
        >
          <span class="text-zinc-400">Press</span>
          <kbd class="px-1.5 py-0.5 rounded bg-white/[0.1] text-white border border-white/[0.15]">⌘K</kbd>
          <span>for Command Palette</span>
        </button>
      </div>
    </div>

    <!-- Interactive Live Terminal Playground -->
    <div class="max-w-4xl mx-auto mt-4">
      <div class="relative rounded-2xl border border-white/[0.12] bg-[#0a0c14]/90 backdrop-blur-xl shadow-2xl shadow-indigo-950/30 overflow-hidden">
        <!-- Terminal Titlebar -->
        <div class="flex items-center justify-between px-4 py-3 bg-[#0d0f1a] border-b border-white/[0.08] select-none">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#ff5f56] inline-block shadow-sm"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e] inline-block shadow-sm"></span>
            <span class="w-3 h-3 rounded-full bg-[#27c93f] inline-block shadow-sm"></span>
            <span class="ml-3 font-mono text-xs text-zinc-400 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>terminal@loop.brain.fr ~ zsh</span>
            </span>
          </div>
          <div class="flex items-center gap-2 text-[11px] font-mono text-zinc-500">
            <span class="hidden sm:inline">LIVE SIMULATION</span>
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          </div>
        </div>

        <!-- Terminal Body -->
        <div class="p-4 sm:p-6 font-mono text-xs sm:text-sm text-zinc-200 min-h-[160px] flex flex-col justify-between">
          <div id="terminal-screen" class="space-y-2">
            <div class="text-zinc-500"># Welcome to cmds simulation terminal. Click any quick shortcut below:</div>
            <div class="flex items-center gap-2 text-indigo-300">
              <span class="text-emerald-400 font-bold">user@brain</span><span class="text-zinc-500">:</span><span class="text-cyan-400">~</span><span class="text-zinc-400">$</span>
              <span id="terminal-typed-cmd" class="text-white font-semibold">kill -9 $(lsof -t -i:3000)</span>
              <span class="w-2 h-4 bg-indigo-400 animate-pulse inline-block align-middle"></span>
            </div>
            <div id="terminal-output" class="text-zinc-400 whitespace-pre-wrap pl-4 border-l-2 border-indigo-500/30 font-light text-xs pt-1">
[process 48102 killed: node /workspace/server.js listening on port 3000]
port 3000 is now free.
            </div>
          </div>

          <!-- Quick interactive presets to type into terminal -->
          <div class="pt-4 mt-4 border-t border-white/[0.06] flex flex-wrap items-center gap-2 text-[11px]">
            <span class="text-zinc-500">Simulate:</span>
            <button
              type="button"
              class="terminal-sim-btn px-2.5 py-1 rounded bg-white/[0.05] hover:bg-indigo-500/20 hover:text-indigo-300 border border-white/[0.08] hover:border-indigo-500/40 text-zinc-300 transition-all cursor-pointer"
              data-cmd="kill -9 $(lsof -t -i:3000)"
              data-output="[process 48102 killed: node /workspace/server.js listening on port 3000]&#10;port 3000 is now free."
            >
              Kill Port 3000
            </button>
            <button
              type="button"
              class="terminal-sim-btn px-2.5 py-1 rounded bg-white/[0.05] hover:bg-emerald-500/20 hover:text-emerald-300 border border-white/[0.08] hover:border-emerald-500/40 text-zinc-300 transition-all cursor-pointer"
              data-cmd="curl -s https://ifconfig.me"
              data-output="198.51.100.42&#10;[HTTP 200 OK - 42ms]"
            >
              Check Public IP
            </button>
            <button
              type="button"
              class="terminal-sim-btn px-2.5 py-1 rounded bg-white/[0.05] hover:bg-purple-500/20 hover:text-purple-300 border border-white/[0.08] hover:border-purple-500/40 text-zinc-300 transition-all cursor-pointer"
              data-cmd="git reset --soft HEAD~1"
              data-output="HEAD is now at 8f3d10c feat(api): prepare clean endpoint&#10;Staged changes preserved."
            >
              Undo Git Commit
            </button>
            <button
              type="button"
              class="terminal-sim-btn px-2.5 py-1 rounded bg-white/[0.05] hover:bg-pink-500/20 hover:text-pink-300 border border-white/[0.08] hover:border-pink-500/40 text-zinc-300 transition-all cursor-pointer"
              data-cmd="docker system prune -af --volumes"
              data-output="Deleted Containers: 14&#10;Deleted Images: 28&#10;Total reclaimed space: 14.82GB"
            >
              Docker Prune
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Interactive terminal typing simulator
  const typedEl = document.getElementById('terminal-typed-cmd');
  const outputEl = document.getElementById('terminal-output');
  const simButtons = document.querySelectorAll('.terminal-sim-btn');

  let typingTimeout = null;

  function simulateCommand(cmd, output) {
    if (typingTimeout) clearTimeout(typingTimeout);
    if (!typedEl || !outputEl) return;

    window.cmdAudio?.playClick();
    typedEl.textContent = '';
    outputEl.textContent = 'executing...';
    outputEl.classList.add('opacity-50');

    let i = 0;
    function typeChar() {
      if (i < cmd.length) {
        typedEl.textContent += cmd.charAt(i);
        i++;
        typingTimeout = setTimeout(typeChar, 18 + Math.random() * 20);
      } else {
        setTimeout(() => {
          outputEl.textContent = output;
          outputEl.classList.remove('opacity-50');
          window.cmdAudio?.playSuccess();
        }, 120);
      }
    }
    typeChar();
  }

  simButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-cmd') || '';
      const output = btn.getAttribute('data-output') || '';
      simulateCommand(cmd, output);
    });
  });

  // Global function so any card can simulate in the hero terminal!
  window.runInTerminal = function(cmd, output) {
    const defaultOutput = `Command executed successfully: [exit code 0]\n` + (output || `Output received.`);
    simulateCommand(cmd, defaultOutput);
    // Smooth scroll to top terminal if not in view
    const terminal = document.getElementById('terminal-screen');
    if (terminal && window.scrollY > 400) {
      terminal.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  };
</script>
