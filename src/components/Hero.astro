---
interface Props {
  totalCount: number;
}

const { totalCount } = Astro.props;
---

<section class="border-b border-[var(--brain-border-subtle)] bg-[var(--brain-surface-primary)] pt-10 pb-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Context metadata -->
    <div class="flex items-center gap-3 text-xs font-mono text-[var(--brain-text-secondary)] mb-4">
      <span>Operational reference</span>
      <span class="text-[var(--brain-border-default)]">/</span>
      <span>loop.brain.fr/cmds</span>
      <span class="text-[var(--brain-border-default)]">/</span>
      <span>POSIX and Windows</span>
    </div>

    <!-- Page Title -->
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-[var(--brain-text-primary)] mb-4 leading-tight">
      Terminal commands for systems engineering and development
    </h1>

    <!-- Lede -->
    <p class="text-sm sm:text-base text-[var(--brain-text-secondary)] max-w-3xl leading-relaxed mb-8">
      A verified operational index of {totalCount} terminal commands covering process management, network diagnostics, storage, container runtimes, and system inspection across Linux, macOS, and Windows.
    </p>

    <!-- Stat Strip (restrained, aligned, honest metrics) -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-6 border-t border-[var(--brain-border-subtle)]">
      <div>
        <dt class="text-xs font-mono text-[var(--brain-text-secondary)] mb-1">Indexed commands</dt>
        <dd class="text-2xl font-semibold text-[var(--brain-text-primary)] tracking-tight font-mono">{totalCount}</dd>
      </div>
      <div>
        <dt class="text-xs font-mono text-[var(--brain-text-secondary)] mb-1">Target environments</dt>
        <dd class="text-2xl font-semibold text-[var(--brain-text-primary)] tracking-tight">Linux, macOS, Windows</dd>
      </div>
      <div>
        <dt class="text-xs font-mono text-[var(--brain-text-secondary)] mb-1">Functional categories</dt>
        <dd class="text-2xl font-semibold text-[var(--brain-text-primary)] tracking-tight font-mono">13</dd>
      </div>
      <div>
        <dt class="text-xs font-mono text-[var(--brain-text-secondary)] mb-1">Execution basis</dt>
        <dd class="text-2xl font-semibold text-[var(--brain-text-primary)] tracking-tight">Zero runtime, client-side</dd>
      </div>
    </div>
  </div>
</section>
