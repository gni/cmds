---
interface Props {
  totalCount: number;
  linuxCount: number;
  macosCount: number;
  windowsCount: number;
}

const { totalCount } = Astro.props;
---

<div class="border-b border-[var(--border)] bg-[var(--bg)] pt-8 pb-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl mb-5">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)] mb-2 font-mono">
        cmds
      </h1>
      <p class="text-xs sm:text-sm text-[var(--text-secondary)] font-mono leading-relaxed">
        Curated terminal commands reference for Linux, macOS, and Windows. Search by keyword, filter by platform, and click to copy.
      </p>
    </div>

    <!-- Clean, Focused Search Bar -->
    <div class="max-w-2xl">
      <div class="relative flex items-center">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[var(--text-muted)]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          id="main-search-input"
          type="search"
          placeholder="Search commands, tools, or flags (e.g. ls, grep, git reset, ufw, tar)..."
          class="w-full pl-10 pr-24 py-2.5 rounded-lg border border-[var(--border)] focus:border-[var(--text-primary)] bg-[var(--bg-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] text-sm font-mono outline-none transition-colors"
        />
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center gap-2">
          <button
            id="main-clear-search-btn"
            type="button"
            class="hidden text-[var(--text-muted)] hover:text-[var(--text-primary)] text-xs font-mono px-1.5 py-0.5 rounded cursor-pointer"
          >
            Clear
          </button>
          <kbd class="px-1.5 py-0.5 text-[10px] font-mono text-[var(--text-muted)] border border-[var(--border)] rounded bg-[var(--bg)]">
            /
          </kbd>
        </div>
      </div>
    </div>
  </div>
</div>
