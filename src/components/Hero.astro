---
interface Props {
  totalCount: number;
  linuxCount: number;
  macosCount: number;
  windowsCount: number;
}

const { totalCount, linuxCount, macosCount, windowsCount } = Astro.props;
---

<div class="border-b border-[var(--border)] bg-[var(--bg)] pt-8 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)] mb-2">
        Terminal Commands Reference
      </h1>
      <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
        A verified index of {totalCount} terminal commands for Linux, macOS, and Windows. Search by keyword, tune variables in place, and inspect platform-specific alternatives.
      </p>
    </div>

    <!-- Search Input -->
    <div class="max-w-2xl mb-4">
      <div class="relative flex items-center">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[var(--text-muted)]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          id="main-search-input"
          type="search"
          placeholder="Filter commands by name, flag, or tool (e.g. port, git reset, ffmpeg, lsof)..."
          class="w-full pl-10 pr-24 py-2.5 rounded-lg border border-[var(--border)] focus:border-[var(--text-primary)] bg-[var(--bg-subtle)] text-[var(--text-primary)] placeholder-[var(--text-muted)] text-sm font-mono outline-none transition-colors"
        />
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center gap-2">
          <button
            id="main-clear-search-btn"
            type="button"
            class="hidden text-[var(--text-muted)] hover:text-[var(--text-primary)] text-xs font-mono px-1.5 py-0.5 rounded cursor-pointer"
          >
            Clear
          </button>
          <kbd class="px-1.5 py-0.5 text-[10px] font-mono text-[var(--text-muted)] border border-[var(--border)] rounded bg-[var(--bg)]">
            /
          </kbd>
        </div>
      </div>
    </div>

    <!-- OS Filter Pills -->
    <div class="flex items-center gap-1.5 font-mono text-xs overflow-x-auto pb-1 scrollbar-none">
      <button
        type="button"
        class="os-filter-pill active px-3 py-1 rounded-md border border-[var(--accent)] bg-[var(--accent)] text-[var(--accent-text)] font-medium cursor-pointer transition-colors"
        data-platform="all"
      >
        All ({totalCount})
      </button>
      <button
        type="button"
        class="os-filter-pill px-3 py-1 rounded-md border border-[var(--border)] bg-[var(--bg-subtle)] hover:border-[var(--text-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-medium cursor-pointer transition-colors"
        data-platform="linux"
      >
        Linux ({linuxCount})
      </button>
      <button
        type="button"
        class="os-filter-pill px-3 py-1 rounded-md border border-[var(--border)] bg-[var(--bg-subtle)] hover:border-[var(--text-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-medium cursor-pointer transition-colors"
        data-platform="macos"
      >
        macOS ({macosCount})
      </button>
      <button
        type="button"
        class="os-filter-pill px-3 py-1 rounded-md border border-[var(--border)] bg-[var(--bg-subtle)] hover:border-[var(--text-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-medium cursor-pointer transition-colors"
        data-platform="windows"
      >
        Windows ({windowsCount})
      </button>
      <button
        type="button"
        id="favorites-filter-pill"
        class="os-filter-pill px-3 py-1 rounded-md border border-[var(--border)] bg-[var(--bg-subtle)] hover:border-[var(--text-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-medium cursor-pointer transition-colors"
        data-platform="favorites"
      >
        Saved (<span id="saved-count-text">0</span>)
      </button>
    </div>
  </div>
</div>
