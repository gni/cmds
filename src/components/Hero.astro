---
import { CATEGORIES } from '../data/categories';

interface Props {
  totalCount: number;
  linuxCount: number;
  macosCount: number;
  windowsCount: number;
}

const { totalCount, linuxCount, macosCount, windowsCount } = Astro.props;
---

<section class="border-b border-[var(--c-border-subtle)] bg-[var(--c-bg)] pt-12 pb-10 technical-grid">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Top Editorial Metadata Tag -->
    <div class="flex items-center gap-3 text-xs font-mono text-[var(--c-text-muted)] mb-4">
      <span class="text-[var(--c-text-primary)] font-semibold uppercase tracking-wider">Brain Reference Architecture</span>
      <span class="text-[var(--c-border-default)]">/</span>
      <span>loop.brain.fr/cmds</span>
      <span class="text-[var(--c-border-default)]">/</span>
      <span>Production Grade</span>
    </div>

    <!-- Editorial Hero Title -->
    <div class="max-w-4xl mb-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--c-text-primary)] leading-[1.08] mb-4">
        Every terminal command.<br class="hidden sm:inline" />
        Engineered with surgical precision.
      </h1>
      <p class="text-sm sm:text-base text-[var(--c-text-secondary)] max-w-2xl leading-relaxed font-light">
        A verified index of {totalCount} production-grade terminal commands for Linux, macOS, and Windows. Real-time parameter synthesis, flag matrices, and instant simulation without AI hallucinations.
      </p>
    </div>

    <!-- Spotlight Search Bar -->
    <div class="max-w-3xl mb-6">
      <div class="relative flex items-center">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[var(--c-text-muted)]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          id="hero-search-input"
          type="search"
          placeholder="Filter commands by keyword, tool name, or flag (press / to focus)..."
          class="w-full pl-10 pr-24 py-3 rounded-lg border border-[var(--c-border-default)] focus:border-[var(--c-text-primary)] bg-[var(--c-surface)] text-[var(--c-text-primary)] placeholder-[var(--c-text-muted)] text-sm font-mono transition-all outline-none shadow-xs"
        />
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center gap-2">
          <button
            id="hero-clear-search-btn"
            type="button"
            class="hidden text-[var(--c-text-muted)] hover:text-[var(--c-text-primary)] text-xs font-mono px-1.5 py-0.5 rounded cursor-pointer"
          >
            Clear
          </button>
          <kbd class="keycap">/</kbd>
        </div>
      </div>
    </div>

    <!-- Quick Platform Filters & System Stats -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
      <!-- OS Platform Selectors -->
      <div class="flex items-center gap-1.5 font-mono text-xs overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
        <button
          type="button"
          class="platform-pill active px-3 py-1 rounded-md border border-[var(--c-accent)] bg-[var(--c-accent)] text-[var(--c-accent-fg)] font-medium cursor-pointer transition-colors"
          data-platform="all"
        >
          All Systems ({totalCount})
        </button>
        <button
          type="button"
          class="platform-pill px-3 py-1 rounded-md border border-[var(--c-border-default)] bg-[var(--c-surface)] hover:border-[var(--c-border-strong)] text-[var(--c-text-secondary)] hover:text-[var(--c-text-primary)] font-medium cursor-pointer transition-colors"
          data-platform="linux"
        >
          Linux ({linuxCount})
        </button>
        <button
          type="button"
          class="platform-pill px-3 py-1 rounded-md border border-[var(--c-border-default)] bg-[var(--c-surface)] hover:border-[var(--c-border-strong)] text-[var(--c-text-secondary)] hover:text-[var(--c-text-primary)] font-medium cursor-pointer transition-colors"
          data-platform="macos"
        >
          macOS ({macosCount})
        </button>
        <button
          type="button"
          class="platform-pill px-3 py-1 rounded-md border border-[var(--c-border-default)] bg-[var(--c-surface)] hover:border-[var(--c-border-strong)] text-[var(--c-text-secondary)] hover:text-[var(--c-text-primary)] font-medium cursor-pointer transition-colors"
          data-platform="windows"
        >
          Windows ({windowsCount})
        </button>
        <button
          type="button"
          id="favorites-pill"
          class="platform-pill px-3 py-1 rounded-md border border-[var(--c-border-default)] bg-[var(--c-surface)] hover:border-[var(--c-border-strong)] text-[var(--c-text-secondary)] hover:text-[var(--c-text-primary)] font-medium cursor-pointer transition-colors flex items-center gap-1"
          data-platform="favorites"
        >
          <span>Saved</span>
          <span class="text-[var(--c-warning)] font-bold">(<span id="fav-count-pill">0</span>)</span>
        </button>
      </div>

      <!-- Live Shortcuts Hint -->
      <div class="hidden lg:flex items-center gap-3 text-xs font-mono text-[var(--c-text-muted)]">
        <span><kbd class="keycap">J</kbd> <kbd class="keycap">K</kbd> navigate</span>
        <span><kbd class="keycap">C</kbd> copy</span>
        <span><kbd class="keycap">↵</kbd> simulate</span>
      </div>
    </div>
  </div>
</section>
