---
import { COMMANDS } from '../data/commands';
import { CATEGORIES } from '../data/categories';

const platformLabel = {
  all: 'Universal',
  linux: 'Linux',
  macos: 'macOS',
  windows: 'Windows'
};

const linuxCount = COMMANDS.filter(c => c.platforms.includes('linux') || c.platforms.includes('all')).length;
const macosCount = COMMANDS.filter(c => c.platforms.includes('macos') || c.platforms.includes('all')).length;
const windowsCount = COMMANDS.filter(c => c.platforms.includes('windows') || c.platforms.includes('all')).length;
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Navigation Sidebar (Sticky) -->
    <aside class="hidden lg:block lg:col-span-3 sticky top-20 space-y-5 text-xs font-mono">
      <!-- Filters on top of Categories -->
      <div class="space-y-1.5 pb-4 border-b border-[var(--border)]">
        <div class="text-xs font-semibold text-[var(--text-muted)] mb-2 px-1 flex items-center justify-between">
          <span>Filters</span>
          <button
            id="sidebar-reset-btn"
            type="button"
            class="hidden text-[10px] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer underline"
          >
            Reset
          </button>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <button
            type="button"
            class="os-filter-pill active"
            data-platform="all"
          >
            All (<span class="platform-count" data-count-platform="all">{COMMANDS.length}</span>)
          </button>
          <button
            type="button"
            class="os-filter-pill"
            data-platform="linux"
          >
            Linux (<span class="platform-count" data-count-platform="linux">{linuxCount}</span>)
          </button>
          <button
            type="button"
            class="os-filter-pill"
            data-platform="macos"
          >
            macOS (<span class="platform-count" data-count-platform="macos">{macosCount}</span>)
          </button>
          <button
            type="button"
            class="os-filter-pill"
            data-platform="windows"
          >
            Windows (<span class="platform-count" data-count-platform="windows">{windowsCount}</span>)
          </button>
          <button
            type="button"
            id="favorites-filter-pill"
            class="os-filter-pill flex items-center gap-1"
            data-platform="favorites"
          >
            <svg class="w-3 h-3 text-amber-500 fill-amber-500 shrink-0" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
            </svg>
            <span>Saved</span>
            (<span id="saved-count-text">0</span>)
          </button>
        </div>
      </div>

      <!-- Categories Section -->
      <div class="space-y-1">
        <div class="text-xs font-semibold text-[var(--text-muted)] mb-2 px-1">
          Categories
        </div>
        <button
          type="button"
          class="category-nav-btn active w-full text-left px-2.5 py-1.5 rounded-md font-medium bg-[var(--bg-muted)] text-[var(--text-primary)] cursor-pointer transition-colors flex items-center justify-between"
          data-category="all"
        >
          <span>All Commands</span>
          <span class="category-count text-[var(--text-muted)] text-[10px]" data-count-category="all">
            {COMMANDS.length}
          </span>
        </button>

        {CATEGORIES.map(cat => (
          <button
            type="button"
            class="category-nav-btn w-full text-left px-2.5 py-1.5 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] cursor-pointer transition-colors flex items-center justify-between"
            data-category={cat.id}
          >
            <span class="truncate pr-1">{cat.name}</span>
            <span class="category-count text-[var(--text-muted)] text-[10px] shrink-0" data-count-category={cat.id}>
              {COMMANDS.filter(c => c.category === cat.id).length}
            </span>
          </button>
        ))}
      </div>
    </aside>

    <!-- Main Content Area: Commands List -->
    <main class="lg:col-span-9 space-y-6" id="commands-container">
      <!-- Mobile Filters & Categories Bar (lg:hidden) -->
      <div class="lg:hidden space-y-3 font-mono text-xs pb-4 border-b border-[var(--border)]">
        <div>
          <div class="text-xs font-semibold text-[var(--text-muted)] mb-2">
            Filters
          </div>
          <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none">
            <button type="button" class="os-filter-pill active" data-platform="all">
              All (<span class="platform-count" data-count-platform="all">{COMMANDS.length}</span>)
            </button>
            <button type="button" class="os-filter-pill" data-platform="linux">
              Linux (<span class="platform-count" data-count-platform="linux">{linuxCount}</span>)
            </button>
            <button type="button" class="os-filter-pill" data-platform="macos">
              macOS (<span class="platform-count" data-count-platform="macos">{macosCount}</span>)
            </button>
            <button type="button" class="os-filter-pill" data-platform="windows">
              Windows (<span class="platform-count" data-count-platform="windows">{windowsCount}</span>)
            </button>
            <button type="button" class="os-filter-pill mobile-fav-pill flex items-center gap-1" data-platform="favorites">
              <svg class="w-3 h-3 text-amber-500 fill-amber-500 shrink-0" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
              </svg>
              <span>Saved</span>
              (<span class="mobile-saved-count">0</span>)
            </button>
          </div>
        </div>

        <div>
          <div class="text-xs font-semibold text-[var(--text-muted)] mb-1.5">
            Categories
          </div>
          <select id="mobile-category-select" class="w-full px-3 py-2 rounded-md border border-[var(--border)] bg-[var(--bg-subtle)] text-[var(--text-primary)] font-mono text-xs outline-none">
            <option value="all">All Commands ({COMMANDS.length})</option>
            {CATEGORIES.map(cat => (
              <option value={cat.id}>
                {cat.name} ({COMMANDS.filter(c => c.category === cat.id).length})
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Active Filter Status Indicator -->
      <div id="active-filter-indicator" class="hidden flex items-center justify-between gap-2 p-3 rounded-md bg-[var(--bg-subtle)] border border-[var(--border)] font-mono text-xs">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-[var(--text-muted)] text-[11px]">Active:</span>
          <span id="active-filter-pill-label" class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-[var(--bg-muted)] text-[var(--text-primary)] text-xs font-medium"></span>
          <span id="active-filter-count-badge" class="text-[var(--text-muted)] text-[11px]"></span>
        </div>
        <button
          id="clear-filter-indicator-btn"
          type="button"
          class="text-[11px] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer underline"
        >
          Reset filters
        </button>
      </div>
      {COMMANDS.map((cmd) => (
        <article
          id={cmd.id}
          class="command-entry border border-[var(--border)] bg-[var(--bg)] rounded-lg p-5 transition-colors"
          data-id={cmd.id}
          data-platforms={JSON.stringify(cmd.platforms)}
          data-category={cmd.category}
          data-title={cmd.title.toLowerCase()}
          data-description={cmd.description.toLowerCase()}
          data-command-raw={cmd.command}
          data-tags={JSON.stringify(cmd.tags)}
          data-danger={cmd.dangerLevel}
        >
          <!-- Entry Header -->
          <div class="flex items-center justify-between gap-3 mb-2 text-xs font-mono text-[var(--text-muted)]">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-[var(--text-primary)] font-medium">{cmd.category}</span>
              <span>/</span>
              <span>{cmd.platforms.map(p => platformLabel[p] || p).join(', ')}</span>

              {cmd.dangerLevel === 'dangerous' && (
                <>
                  <span>/</span>
                  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-red-950/60 border border-red-800/80 text-red-400 font-semibold text-[10px]">
                    <svg class="w-3 h-3 text-red-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span>Dangerous</span>
                  </span>
                </>
              )}
              {cmd.dangerLevel === 'caution' && (
                <>
                  <span>/</span>
                  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-amber-950/40 border border-amber-800/60 text-amber-400 font-medium text-[10px]">
                    Caution
                  </span>
                </>
              )}
            </div>

            <!-- Save Bookmark Button -->
            <button
              type="button"
              class="entry-save-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-[var(--border)] hover:border-[var(--text-muted)] bg-[var(--bg-subtle)] hover:bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs font-mono transition-all cursor-pointer active:scale-95 select-none group"
              data-id={cmd.id}
              title="Bookmark command (or press S while hovering)"
              aria-label="Bookmark command"
            >
              <svg class="save-icon-outline w-3.5 h-3.5 text-current transition-transform duration-150 group-hover:scale-110 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
              </svg>
              <svg class="save-icon-filled hidden w-3.5 h-3.5 text-amber-500 fill-amber-500 transition-transform duration-150 group-hover:scale-110 shrink-0" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
              </svg>
              <span class="save-label font-medium">Save</span>
              <kbd class="hidden sm:inline-block text-[9px] px-1 py-0.2 rounded border border-[var(--border)] text-[var(--text-muted)] opacity-60 group-hover:opacity-100 transition-opacity">S</kbd>
            </button>
          </div>

          <!-- Title and Description -->
          <h2 class="text-base font-semibold text-[var(--text-primary)] tracking-tight mb-1.5">
            <a href={`#${cmd.id}`} class="hover:underline">
              {cmd.title}
            </a>
          </h2>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
            {cmd.description}
          </p>

          <!-- Alternative OS Syntax Switcher (if available) -->
          {cmd.alternatives && cmd.alternatives.length > 0 && (
            <div class="flex items-center gap-1.5 mb-2.5 text-xs font-mono">
              <span class="text-[var(--text-muted)]">Variant:</span>
              <button
                type="button"
                class="variant-tab active px-2 py-0.5 rounded border border-[var(--border)] bg-[var(--bg-muted)] text-[var(--text-primary)] font-medium cursor-pointer"
                data-type="default"
              >
                Default
              </button>
              {cmd.alternatives.map((alt, idx) => (
                <button
                  type="button"
                  class="variant-tab px-2 py-0.5 rounded border border-transparent hover:border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-colors"
                  data-type={`alt-${idx}`}
                  data-alt-command={alt.command}
                  data-alt-platform={alt.platform}
                >
                  {alt.platform === 'windows' ? 'PowerShell' : alt.platform === 'macos' ? 'macOS BSD' : alt.platform}
                </button>
              ))}
            </div>
          )}

          <!-- Danger Notice Banner -->
          {cmd.dangerLevel === 'dangerous' && (
            <div class="danger-warning-banner mb-3 px-3 py-2 rounded-md bg-red-950/40 border border-red-800/60 text-red-200 text-xs font-mono flex items-start gap-2.5">
              <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="leading-relaxed">
                <span class="font-semibold text-red-400">Dangerous command:</span> This command can cause irreversible data deletion, process termination, or network interruption. A 2-step confirmation is required before copying or simulating.
              </div>
            </div>
          )}

          <!-- Code Box -->
          <div class="code-box rounded-md p-3.5 font-mono text-xs mb-3">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 select-all overflow-x-auto whitespace-pre-wrap break-all leading-relaxed">
                <span class="text-slate-400 select-none mr-2 font-bold">$</span>
                <span class="command-text-content" data-template={cmd.command}>
                  {cmd.command}
                </span>
              </div>

              <div class="flex items-center gap-1 shrink-0">
                <button
                  type="button"
                  class="entry-simulate-btn px-2 py-1 rounded text-slate-400 hover:text-sky-300 hover:bg-slate-800/60 text-xs font-mono transition-colors cursor-pointer flex items-center gap-1.5"
                  title={cmd.dangerLevel === 'dangerous' ? 'Dangerous command: 2-step confirmation required' : 'Simulate command in terminal preview'}
                  data-output={cmd.outputExample || ''}
                  data-danger={cmd.dangerLevel}
                >
                  <svg class="w-3 h-3 text-sky-400 fill-current opacity-80" viewBox="0 0 24 24">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                  <span class="sim-text">Simulate</span>
                </button>

                <button
                  type="button"
                  class="entry-copy-btn p-1.5 rounded text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 transition-colors cursor-pointer inline-flex items-center justify-center relative"
                  title={cmd.dangerLevel === 'dangerous' ? 'Dangerous command: 2-step confirmation required to copy' : 'Copy command to clipboard'}
                  aria-label="Copy command"
                  data-danger={cmd.dangerLevel}
                >
                  <svg class="copy-icon w-3.5 h-3.5 text-slate-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <svg class="danger-warn-icon hidden w-3.5 h-3.5 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  <svg class="check-icon hidden w-3.5 h-3.5 text-emerald-400 transition-transform duration-150" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span class="danger-confirm-pill hidden absolute -top-8 right-0 bg-red-950 text-red-200 text-[10px] font-mono px-2 py-0.5 rounded border border-red-700 shadow-lg whitespace-nowrap z-10">
                    Click to confirm copy
                  </span>
                </button>

                <button
                  type="button"
                  class="entry-quick-save-btn p-1.5 rounded text-slate-400 hover:text-amber-400 hover:bg-slate-800/60 transition-colors cursor-pointer inline-flex items-center justify-center"
                  title="Bookmark command (or press S)"
                  aria-label="Bookmark command"
                >
                  <svg class="quick-save-outline w-3.5 h-3.5 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                  </svg>
                  <svg class="quick-save-filled hidden w-3.5 h-3.5 text-amber-400 fill-amber-400 transition-transform duration-150" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Parameters Inputs -->
            {cmd.params && cmd.params.length > 0 && (
              <div class="mt-3 pt-2.5 border-t border-slate-800 flex flex-wrap items-center gap-2 text-xs">
                <span class="text-slate-400 text-[11px] select-none">Variables:</span>
                {cmd.params.map(p => (
                  <div class="flex items-center gap-1.5 bg-slate-900 border border-slate-700 px-2 py-0.5 rounded">
                    <label for={`p-${cmd.id}-${p.name}`} class="text-slate-400 text-[11px]">{p.label}:</label>
                    <input
                      id={`p-${cmd.id}-${p.name}`}
                      type="text"
                      class="param-input bg-transparent text-white font-mono text-xs outline-none w-24 font-medium"
                      data-param-name={p.name}
                      value={p.default}
                      placeholder={p.placeholder || p.default}
                    />
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Minimalist Inline Output Console -->
          <div class="inline-terminal-drawer hidden mt-2 mb-3 rounded-md bg-slate-950/90 border border-slate-800/80 p-3 font-mono text-xs overflow-hidden">
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-800/80 text-[11px] text-slate-400 select-none">
              <div class="flex items-center gap-2">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span class="text-slate-300 font-medium">Terminal Output</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="inline-exit-code text-[10px] text-emerald-400 font-medium">✓ exit 0</span>
                <button
                  type="button"
                  class="inline-term-close-btn text-slate-400 hover:text-slate-200 text-[11px] px-1.5 py-0.5 rounded hover:bg-slate-800 transition-colors cursor-pointer"
                  title="Close output"
                >
                  Close
                </button>
              </div>
            </div>
            <div class="inline-term-stream text-slate-300 leading-relaxed whitespace-pre-wrap overflow-x-auto max-h-48 text-[11px]"></div>
          </div>

          <!-- Note / Pro-tip -->
          {cmd.proTip && (
            <div class="text-xs font-mono text-[var(--text-secondary)] mb-3 leading-relaxed">
              <span class="font-medium text-[var(--text-primary)]">Note:</span> {cmd.proTip}
            </div>
          )}

          <!-- Example output disclosure -->
          {cmd.outputExample && (
            <details class="text-xs font-mono mb-2 group">
              <summary class="text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer select-none inline-flex items-center gap-1.5 py-0.5 transition-colors">
                <svg class="w-3 h-3 transition-transform duration-150 group-open:rotate-90 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <span>View example output</span>
              </summary>
              <pre class="mt-2 p-3 bg-[var(--bg-subtle)] rounded text-[var(--text-secondary)] overflow-x-auto whitespace-pre leading-relaxed">{cmd.outputExample}</pre>
            </details>
          )}

          <!-- Tags -->
          <div class="pt-2 flex items-center gap-2 text-[11px] font-mono text-[var(--text-muted)]">
            {cmd.tags.map(tag => (
              <button
                type="button"
                class="tag-link hover:text-[var(--text-primary)] transition-colors cursor-pointer"
                data-tag={tag}
              >
                #{tag}
              </button>
            ))}
          </div>
        </article>
      ))}

      <!-- Empty State -->
      <div id="empty-results-state" class="hidden py-16 text-center border border-[var(--border)] rounded-lg p-6 bg-[var(--bg-subtle)]">
        <p class="text-sm font-semibold text-[var(--text-primary)] mb-1">No matching commands found</p>
        <p class="text-xs text-[var(--text-muted)] mb-4">Try checking your spelling or clearing active filters.</p>
        <button
          id="clear-all-filters-btn"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-slate-900 hover:bg-slate-800 text-white dark:bg-sky-500 dark:hover:bg-sky-400 dark:text-slate-950 font-medium text-xs font-mono transition-all shadow-sm cursor-pointer active:scale-95"
        >
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
          <span>Reset all filters</span>
        </button>
      </div>
    </main>
  </div>

  <!-- Toast Notification -->
  <div
    id="cmds-toast"
    class="fixed bottom-5 right-5 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-200 ease-out flex items-center gap-3 px-4 py-3 rounded-lg border border-[var(--border)] bg-[var(--bg)] shadow-2xl text-xs font-mono select-none"
    role="status"
    aria-live="polite"
  >
    <div id="cmds-toast-icon-box" class="w-7 h-7 rounded-md bg-amber-500/15 text-amber-500 flex items-center justify-center shrink-0">
      <svg class="w-4 h-4 fill-amber-500 text-amber-500" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
      </svg>
    </div>
    <div class="flex flex-col min-w-0 max-w-xs">
      <span id="cmds-toast-title" class="font-medium text-[var(--text-primary)] truncate"></span>
      <span id="cmds-toast-msg" class="text-[11px] text-[var(--text-secondary)] truncate"></span>
    </div>
    <button
      id="cmds-toast-action"
      type="button"
      class="ml-2 px-2.5 py-1 rounded bg-[var(--bg-muted)] hover:bg-[var(--border)] text-[var(--text-primary)] text-[11px] font-medium transition-colors cursor-pointer shrink-0"
    >
      View Saved
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    let currentQuery = '';
    let currentPlatform = 'all';
    let currentCategory = 'all';
    let favorites = [];

    try {
      favorites = JSON.parse(localStorage.getItem('cmds_favorites') || localStorage.getItem('brain_cmds_favorites') || '[]');
    } catch (e) {
      favorites = [];
    }

    const platformLabel = {
      all: 'Universal',
      linux: 'Linux',
      macos: 'macOS',
      windows: 'Windows'
    };

    const entries = Array.from(document.querySelectorAll('.command-entry'));
    const searchInput = document.getElementById('main-search-input');
    const clearBtn = document.getElementById('main-clear-search-btn');
    const osPills = document.querySelectorAll('.os-filter-pill');
    const catNavBtns = document.querySelectorAll('.category-nav-btn');
    const mobileCatSelect = document.getElementById('mobile-category-select');
    const emptyState = document.getElementById('empty-results-state');
    const clearFiltersBtn = document.getElementById('clear-all-filters-btn');
    const sidebarResetBtn = document.getElementById('sidebar-reset-btn');
    const filterIndicator = document.getElementById('active-filter-indicator');
    const filterIndicatorLabel = document.getElementById('active-filter-pill-label');
    const filterIndicatorCount = document.getElementById('active-filter-count-badge');
    const clearIndicatorBtn = document.getElementById('clear-filter-indicator-btn');
    const savedCountText = document.getElementById('saved-count-text');

    const toastEl = document.getElementById('cmds-toast');
    const toastTitle = document.getElementById('cmds-toast-title');
    const toastMsg = document.getElementById('cmds-toast-msg');
    const toastAction = document.getElementById('cmds-toast-action');
    let toastTimeout = null;

    function showToast(title, subtitle, showAction = true) {
      if (!toastEl || !toastTitle || !toastMsg) return;
      if (toastTimeout) clearTimeout(toastTimeout);

      toastTitle.textContent = title;
      toastMsg.textContent = subtitle;
      if (toastAction) {
        if (showAction) toastAction.classList.remove('hidden');
        else toastAction.classList.add('hidden');
      }

      toastEl.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
      toastEl.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');

      toastTimeout = setTimeout(() => {
        toastEl.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
        toastEl.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }, 2600);
    }

    toastAction?.addEventListener('click', () => {
      if (toastTimeout) clearTimeout(toastTimeout);
      toastEl?.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
      toastEl?.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');

      currentPlatform = 'favorites';
      osPills.forEach(p => {
        if (p.getAttribute('data-platform') === 'favorites') p.classList.add('active');
        else p.classList.remove('active');
      });
      applyFilters();
      const container = document.getElementById('commands-container');
      if (container) {
        container.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    function updateFavorites() {
      const savedCount = favorites.length;
      if (savedCountText) savedCountText.textContent = String(savedCount);
      document.querySelectorAll('.mobile-saved-count').forEach(el => {
        el.textContent = String(savedCount);
      });

      entries.forEach(entry => {
        const id = entry.getAttribute('data-id');
        const isFav = favorites.includes(id);

        const saveBtn = entry.querySelector('.entry-save-btn');
        const saveLabel = entry.querySelector('.save-label');
        const outlineIcon = entry.querySelector('.save-icon-outline');
        const filledIcon = entry.querySelector('.save-icon-filled');

        const quickSaveBtn = entry.querySelector('.entry-quick-save-btn');
        const quickOutline = entry.querySelector('.quick-save-outline');
        const quickFilled = entry.querySelector('.quick-save-filled');

        if (saveBtn && saveLabel) {
          if (isFav) {
            saveLabel.textContent = 'Saved';
            if (outlineIcon) outlineIcon.classList.add('hidden');
            if (filledIcon) filledIcon.classList.remove('hidden');
            saveBtn.classList.add('bg-amber-500/10', 'border-amber-500/40', 'text-amber-600', 'dark:text-amber-400');
            saveBtn.classList.remove('bg-[var(--bg-subtle)]', 'border-[var(--border)]', 'text-[var(--text-secondary)]');
            saveBtn.setAttribute('title', 'Remove from favorites (or press S)');
            saveBtn.setAttribute('aria-pressed', 'true');
          } else {
            saveLabel.textContent = 'Save';
            if (outlineIcon) outlineIcon.classList.remove('hidden');
            if (filledIcon) filledIcon.classList.add('hidden');
            saveBtn.classList.remove('bg-amber-500/10', 'border-amber-500/40', 'text-amber-600', 'dark:text-amber-400');
            saveBtn.classList.add('bg-[var(--bg-subtle)]', 'border-[var(--border)]', 'text-[var(--text-secondary)]');
            saveBtn.setAttribute('title', 'Save to favorites (or press S)');
            saveBtn.setAttribute('aria-pressed', 'false');
          }
        }

        if (quickSaveBtn) {
          if (isFav) {
            if (quickOutline) quickOutline.classList.add('hidden');
            if (quickFilled) quickFilled.classList.remove('hidden');
            quickSaveBtn.classList.add('text-amber-400');
            quickSaveBtn.classList.remove('text-slate-400');
            quickSaveBtn.setAttribute('title', 'Remove from favorites (or press S)');
          } else {
            if (quickOutline) quickOutline.classList.remove('hidden');
            if (quickFilled) quickFilled.classList.add('hidden');
            quickSaveBtn.classList.remove('text-amber-400');
            quickSaveBtn.classList.add('text-slate-400');
            quickSaveBtn.setAttribute('title', 'Bookmark command (or press S)');
          }
        }
      });
    }

    function toggleSave(id, sourceCard) {
      const isFav = favorites.includes(id);
      const title = sourceCard?.querySelector('h2 a')?.textContent?.trim() || 'Command';

      if (isFav) {
        favorites = favorites.filter(f => f !== id);
        showToast('Removed from favorites', title, false);
      } else {
        favorites.push(id);
        showToast('Saved to favorites', title, true);

        const filledIcon = sourceCard?.querySelector('.save-icon-filled');
        if (filledIcon) {
          filledIcon.classList.add('scale-125');
          setTimeout(() => filledIcon.classList.remove('scale-125'), 180);
        }
        const quickFilled = sourceCard?.querySelector('.quick-save-filled');
        if (quickFilled) {
          quickFilled.classList.add('scale-125');
          setTimeout(() => quickFilled.classList.remove('scale-125'), 180);
        }
      }

      try {
        localStorage.setItem('cmds_favorites', JSON.stringify(favorites));
      } catch (e) {}

      updateFavorites();

      if (currentPlatform === 'favorites') {
        applyFilters();
      } else {
        updateCounts();
      }

      window.dispatchEvent(new CustomEvent('cmds_fav_updated', { detail: { id, isFav: !isFav } }));
      window.dispatchEvent(new CustomEvent('brain_cmds_fav_updated', { detail: { id, isFav: !isFav } }));
    }

    const onFavUpdated = () => {
      try {
        favorites = JSON.parse(localStorage.getItem('cmds_favorites') || localStorage.getItem('brain_cmds_favorites') || '[]');
      } catch (e) {}
      updateFavorites();
      if (currentPlatform === 'favorites') {
        applyFilters();
      } else {
        updateCounts();
      }
    };
    window.addEventListener('cmds_fav_updated', onFavUpdated);
    window.addEventListener('brain_cmds_fav_updated', onFavUpdated);

    updateFavorites();

    function updateCounts() {
      // 1. Dynamic platform counts matching current category
      let categoryEntries = entries;
      if (currentCategory !== 'all') {
        categoryEntries = entries.filter(e => e.getAttribute('data-category') === currentCategory);
      }

      const allPlatformCount = categoryEntries.length;
      const linuxCount = categoryEntries.filter(e => {
        const p = JSON.parse(e.getAttribute('data-platforms') || '[]');
        return p.includes('linux') || p.includes('all');
      }).length;
      const macosCount = categoryEntries.filter(e => {
        const p = JSON.parse(e.getAttribute('data-platforms') || '[]');
        return p.includes('macos') || p.includes('all');
      }).length;
      const windowsCount = categoryEntries.filter(e => {
        const p = JSON.parse(e.getAttribute('data-platforms') || '[]');
        return p.includes('windows') || p.includes('all');
      }).length;
      const savedCount = categoryEntries.filter(e => favorites.includes(e.getAttribute('data-id'))).length;

      document.querySelectorAll('[data-count-platform="all"]').forEach(el => el.textContent = String(allPlatformCount));
      document.querySelectorAll('[data-count-platform="linux"]').forEach(el => el.textContent = String(linuxCount));
      document.querySelectorAll('[data-count-platform="macos"]').forEach(el => el.textContent = String(macosCount));
      document.querySelectorAll('[data-count-platform="windows"]').forEach(el => el.textContent = String(windowsCount));

      const savedDisplay = currentCategory === 'all' ? favorites.length : savedCount;
      if (savedCountText) savedCountText.textContent = String(savedDisplay);
      document.querySelectorAll('.mobile-saved-count').forEach(el => el.textContent = String(savedDisplay));

      // 2. Dynamic category counts matching current platform
      let platformEntries = entries;
      if (currentPlatform === 'favorites') {
        platformEntries = entries.filter(e => favorites.includes(e.getAttribute('data-id')));
      } else if (currentPlatform !== 'all') {
        platformEntries = entries.filter(e => {
          const p = JSON.parse(e.getAttribute('data-platforms') || '[]');
          return p.includes('all') || p.includes(currentPlatform);
        });
      }

      const allCatCount = platformEntries.length;
      document.querySelectorAll('[data-count-category="all"]').forEach(el => el.textContent = String(allCatCount));

      catNavBtns.forEach(btn => {
        const catId = btn.getAttribute('data-category');
        if (catId && catId !== 'all') {
          const count = platformEntries.filter(e => e.getAttribute('data-category') === catId).length;
          const countEl = btn.querySelector('.category-count');
          if (countEl) countEl.textContent = String(count);
        }
      });

      if (mobileCatSelect) {
        Array.from(mobileCatSelect.options).forEach(opt => {
          if (opt.value === 'all') {
            opt.textContent = `All Commands (${allCatCount})`;
          } else {
            const count = platformEntries.filter(e => e.getAttribute('data-category') === opt.value).length;
            const originalName = opt.getAttribute('data-name') || opt.textContent.split(' (')[0];
            opt.setAttribute('data-name', originalName);
            opt.textContent = `${originalName} (${count})`;
          }
        });
      }
    }

    function applyFilters() {
      const q = currentQuery.toLowerCase().trim();
      let visibleCount = 0;

      entries.forEach(entry => {
        const id = entry.getAttribute('data-id');
        const title = entry.getAttribute('data-title') || '';
        const desc = entry.getAttribute('data-description') || '';
        const rawCmd = entry.getAttribute('data-command-raw') || '';
        const tags = JSON.parse(entry.getAttribute('data-tags') || '[]');
        const platforms = JSON.parse(entry.getAttribute('data-platforms') || '[]');
        const category = entry.getAttribute('data-category');

        const matchQuery = !q || title.includes(q) || desc.includes(q) || rawCmd.toLowerCase().includes(q) || tags.some(t => t.includes(q));

        let matchPlatform = false;
        if (currentPlatform === 'all') matchPlatform = true;
        else if (currentPlatform === 'favorites') matchPlatform = favorites.includes(id);
        else matchPlatform = platforms.includes('all') || platforms.includes(currentPlatform);

        const matchCategory = (currentCategory === 'all') || (category === currentCategory);

        if (matchQuery && matchPlatform && matchCategory) {
          entry.classList.remove('hidden');
          visibleCount++;
        } else {
          entry.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }

      updateCounts();

      // Update active filter indicator
      const isFiltered = currentQuery !== '' || currentPlatform !== 'all' || currentCategory !== 'all';
      if (isFiltered) {
        sidebarResetBtn?.classList.remove('hidden');
        if (filterIndicator) {
          filterIndicator.classList.remove('hidden');
          const labels = [];
          if (currentCategory !== 'all') {
            const catBtn = Array.from(catNavBtns).find(b => b.getAttribute('data-category') === currentCategory);
            const catName = catBtn?.querySelector('span')?.textContent?.trim() || currentCategory;
            labels.push(`Category: ${catName}`);
          }
          if (currentPlatform !== 'all') {
            const platName = currentPlatform === 'favorites' ? 'Saved' : (platformLabel[currentPlatform] || currentPlatform);
            labels.push(`Platform: ${platName}`);
          }
          if (currentQuery) {
            labels.push(`Search: "${currentQuery}"`);
          }
          if (filterIndicatorLabel) filterIndicatorLabel.textContent = labels.join(' · ');
          if (filterIndicatorCount) filterIndicatorCount.textContent = `(${visibleCount} command${visibleCount === 1 ? '' : 's'})`;
        }
      } else {
        sidebarResetBtn?.classList.add('hidden');
        filterIndicator?.classList.add('hidden');
      }
    }

    // Search Input
    searchInput?.addEventListener('input', (e) => {
      currentQuery = e.target.value;
      if (clearBtn) {
        if (currentQuery) clearBtn.classList.remove('hidden');
        else clearBtn.classList.add('hidden');
      }
      applyFilters();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentQuery = '';
      clearBtn.classList.add('hidden');
      searchInput?.focus();
      applyFilters();
    });

    // OS Filter Pills
    osPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const platform = pill.getAttribute('data-platform') || 'all';

        // If user clicked 'all' when platform is ALREADY 'all' and a category was selected,
        // reset category to 'all' so all commands are displayed!
        if (platform === 'all' && currentPlatform === 'all' && currentCategory !== 'all') {
          currentCategory = 'all';
          catNavBtns.forEach(b => {
            if (b.getAttribute('data-category') === 'all') b.classList.add('active');
            else b.classList.remove('active');
          });
          if (mobileCatSelect) mobileCatSelect.value = 'all';
        } else {
          currentPlatform = platform;
          osPills.forEach(p => {
            if (p.getAttribute('data-platform') === platform) p.classList.add('active');
            else p.classList.remove('active');
          });
        }
        applyFilters();
      });
    });

    // Category Nav Buttons
    catNavBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category') || 'all';
        currentCategory = category;
        catNavBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        if (mobileCatSelect) mobileCatSelect.value = category;
        applyFilters();
      });
    });

    // Mobile Category Select
    mobileCatSelect?.addEventListener('change', (e) => {
      currentCategory = e.target.value;
      catNavBtns.forEach(b => {
        if (b.getAttribute('data-category') === currentCategory) b.classList.add('active');
        else b.classList.remove('active');
      });
      applyFilters();
    });

    // Reset all
    function resetAllFilters() {
      if (searchInput) searchInput.value = '';
      currentQuery = '';
      currentPlatform = 'all';
      currentCategory = 'all';
      clearBtn?.classList.add('hidden');

      osPills.forEach(p => {
        if (p.getAttribute('data-platform') === 'all') p.classList.add('active');
        else p.classList.remove('active');
      });

      catNavBtns.forEach(b => {
        if (b.getAttribute('data-category') === 'all') b.classList.add('active');
        else b.classList.remove('active');
      });

      if (mobileCatSelect) mobileCatSelect.value = 'all';

      applyFilters();
    }

    clearFiltersBtn?.addEventListener('click', resetAllFilters);
    sidebarResetBtn?.addEventListener('click', resetAllFilters);
    clearIndicatorBtn?.addEventListener('click', resetAllFilters);

    // Tag links click
    document.querySelectorAll('.tag-link').forEach(link => {
      link.addEventListener('click', () => {
        const tag = link.getAttribute('data-tag');
        if (tag && searchInput) {
          searchInput.value = tag;
          currentQuery = tag;
          clearBtn?.classList.remove('hidden');
          searchInput.focus();
          applyFilters();
        }
      });
    });

    function generateOutputFor(cmd, defaultOutput) {
      if (defaultOutput && defaultOutput.trim()) {
        return defaultOutput.trim();
      }
      const c = cmd.trim().toLowerCase();
      if (c.startsWith('git status')) {
        return "On branch main\nYour branch is up to date with 'origin/main'.\n\nnothing to commit, working tree clean";
      }
      if (c.startsWith('git log')) {
        return "* 6378fc3 (HEAD -> main) feat: complete human-crafted documentation\n* d117a22 feat: add multi-stage docker compose for dev and test\n* 6458d57 feat: complete cmds terminal catalog";
      }
      if (c.startsWith('git diff')) {
        return "diff --git a/server.js b/server.js\n--- a/server.js\n+++ b/server.js\n@@ -12,3 +12,3 @@\n-const PORT = 3000;\n+const PORT = 8080;";
      }
      if (c.startsWith('git push')) {
        return "Enumerating objects: 7, done.\nWriting objects: 100% (4/4), 620 bytes | 620.00 KiB/s, done.\nTo github.com:gni/cmds.git\n   6378fc3..9fa210b  main -> main";
      }
      if (c.startsWith('git checkout') || c.startsWith('git switch')) {
        return "Switched to branch 'feature/streamlined-terminal'";
      }
      if (c.startsWith('docker ps')) {
        return "CONTAINER ID   IMAGE          COMMAND                  CREATED         STATUS         PORTS                    NAMES\n7f820c4e1a09   nginx:alpine   \"/docker-entrypoint.…\"   5 minutes ago   Up 5 minutes   0.0.0.0:8080->80/tcp   cmds-preview";
