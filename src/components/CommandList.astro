      }
      if (c.startsWith('whisper')) {
        return "[00:00.000 --> 00:04.200] Audio transcription complete.\nSaved transcript output.";
      }
      if (c.startsWith('aider')) {
        return "Aider v0.70.0\nGit repo: .git with 48 files\nUse /help to see commands, run /add <file> to add files to the chat.";
      }
      if (c.startsWith('ffprobe')) {
        return "{\n  \"streams\": [\n    {\n      \"codec_name\": \"h264\",\n      \"width\": 1920,\n      \"height\": 1080,\n      \"bit_rate\": \"4821000\"\n    }\n  ],\n  \"format\": {\n    \"duration\": \"124.500000\",\n    \"size\": \"75024180\"\n  }\n}";
      }
      if (c.startsWith('ffmpeg')) {
        return "frame= 3600 fps= 74 q=23.0 size=   42800kB time=00:02:00.00 bitrate=2920.1kbits/s speed=2.45x\nvideo:41200kB audio:1500kB subtitle:0kB global headers:0kB muxing overhead: 0.12%\n[ffmpeg] Encoding complete with exit code 0";
      }
      return `✓ Process exited with code 0\nDone in 0.12s.`;
    }

    function escapeHtml(str) {
      return (str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    // Command Entry Logic: Parameters, Copy, Save, Variants
    entries.forEach(entry => {
      const renderEl = entry.querySelector('.command-text-content');
      const rawTemplate = renderEl?.getAttribute('data-template') || '';
      const paramInputs = entry.querySelectorAll('.param-input');
      const copyBtn = entry.querySelector('.entry-copy-btn');
      const copyText = entry.querySelector('.copy-text');
      const simBtn = entry.querySelector('.entry-simulate-btn');
      const simText = entry.querySelector('.sim-text');
      const defaultOutput = simBtn?.getAttribute('data-output') || '';
      const saveBtn = entry.querySelector('.entry-save-btn');
      const variantTabs = entry.querySelectorAll('.variant-tab');
      const id = entry.getAttribute('data-id');

      let activeTemplate = rawTemplate;

      function computeCommand() {
        let cmd = activeTemplate;
        paramInputs.forEach(input => {
          const name = input.getAttribute('data-param-name');
          const val = input.value || input.placeholder || '';
          const regex = new RegExp(`\\{\\{${name}\\}\\}`, 'g');
          cmd = cmd.replace(regex, val);
        });
        return cmd;
      }

      function updateText() {
        if (renderEl) {
          renderEl.textContent = computeCommand();
        }
      }

      paramInputs.forEach(input => {
        input.addEventListener('input', updateText);
      });

      // Simulate Action (with Danger Protection)
      let simConfirmTimer = null;
      simBtn?.addEventListener('click', () => {
        const isDangerous = entry.getAttribute('data-danger') === 'dangerous';

        if (isDangerous && !simBtn.hasAttribute('data-confirmed')) {
          simBtn.setAttribute('data-confirmed', 'true');
          if (simText) simText.textContent = 'Confirm? ⚠️';
          simBtn.classList.add('bg-red-950/80', 'text-red-300', 'border', 'border-red-600');
          simBtn.classList.remove('text-slate-400');

          simConfirmTimer = setTimeout(() => {
            simBtn.removeAttribute('data-confirmed');
            if (simText) simText.textContent = 'Simulate';
            simBtn.classList.remove('bg-red-950/80', 'text-red-300', 'border', 'border-red-600');
            simBtn.classList.add('text-slate-400');
          }, 3500);
          return;
        }

        if (simConfirmTimer) {
          clearTimeout(simConfirmTimer);
          simConfirmTimer = null;
        }
        simBtn.removeAttribute('data-confirmed');
        simBtn.classList.remove('bg-red-950/80', 'text-red-300', 'border', 'border-red-600');

        const finalCmd = computeCommand();
        const output = generateOutputFor(finalCmd, defaultOutput);

        if (simText) simText.textContent = 'Running...';
        simBtn.classList.add('text-sky-300');
        simBtn.classList.remove('text-slate-400');

        let ranInHero = false;
        if (window.runInTerminal) {
          ranInHero = window.runInTerminal(finalCmd, output);
        }

        if (!ranInHero) {
          const drawer = entry.querySelector('.inline-terminal-drawer');
          const stream = entry.querySelector('.inline-term-stream');
          const closeBtn = entry.querySelector('.inline-term-close-btn');

          if (drawer && stream) {
            drawer.classList.remove('hidden');
            stream.innerHTML = `<div class="text-slate-400 select-none mb-1 font-mono">$ <span class="text-slate-100 font-medium">${escapeHtml(finalCmd)}</span></div><pre class="text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${escapeHtml(output)}</pre>`;

            if (closeBtn) {
              closeBtn.onclick = () => {
                drawer.classList.add('hidden');
              };
            }
          }
        }

        setTimeout(() => {
          if (simText) simText.textContent = 'Done ✓';
          setTimeout(() => {
            if (simText) simText.textContent = 'Simulate';
            simBtn.classList.remove('text-sky-300');
            simBtn.classList.add('text-slate-400');
          }, 1400);
        }, 500);
      });

      // Copy Action (with Danger Protection)
      let copyConfirmTimer = null;
      copyBtn?.addEventListener('click', () => {
        const isDangerous = entry.getAttribute('data-danger') === 'dangerous';
        const copyIcon = copyBtn.querySelector('.copy-icon');
        const warnIcon = copyBtn.querySelector('.danger-warn-icon');
        const checkIcon = copyBtn.querySelector('.check-icon');
        const confirmPill = copyBtn.querySelector('.danger-confirm-pill');

        if (isDangerous && !copyBtn.hasAttribute('data-confirmed')) {
          copyBtn.setAttribute('data-confirmed', 'true');
          if (copyIcon) copyIcon.classList.add('hidden');
          if (warnIcon) warnIcon.classList.remove('hidden');
          if (confirmPill) confirmPill.classList.remove('hidden');
          copyBtn.classList.add('bg-red-950/80', 'text-red-300', 'border', 'border-red-600');
          copyBtn.classList.remove('text-slate-400');

          copyConfirmTimer = setTimeout(() => {
            copyBtn.removeAttribute('data-confirmed');
            if (copyIcon) copyIcon.classList.remove('hidden');
            if (warnIcon) warnIcon.classList.add('hidden');
            if (confirmPill) confirmPill.classList.add('hidden');
            copyBtn.classList.remove('bg-red-950/80', 'text-red-300', 'border', 'border-red-600');
            copyBtn.classList.add('text-slate-400');
          }, 3500);
          return;
        }

        if (copyConfirmTimer) {
          clearTimeout(copyConfirmTimer);
          copyConfirmTimer = null;
        }
        copyBtn.removeAttribute('data-confirmed');
        if (warnIcon) warnIcon.classList.add('hidden');
        if (confirmPill) confirmPill.classList.add('hidden');
        copyBtn.classList.remove('bg-red-950/80', 'text-red-300', 'border', 'border-red-600');

        const finalCmd = computeCommand();
        navigator.clipboard.writeText(finalCmd).then(() => {
          if (copyIcon) copyIcon.classList.add('hidden');
          if (checkIcon) checkIcon.classList.remove('hidden');
          copyBtn.classList.add('text-emerald-400');
          copyBtn.classList.remove('text-slate-400');

          setTimeout(() => {
            if (copyIcon) copyIcon.classList.remove('hidden');
            if (checkIcon) checkIcon.classList.add('hidden');
            copyBtn.classList.remove('text-emerald-400');
            copyBtn.classList.add('text-slate-400');
          }, 1400);
        });
      });

      // Save Action (Header button & Code box quick button)
      saveBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleSave(id, entry);
      });

      const quickSaveBtn = entry.querySelector('.entry-quick-save-btn');
      quickSaveBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleSave(id, entry);
      });

      // Variant Tab Switcher
      variantTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          variantTabs.forEach(t => {
            t.classList.remove('active', 'border-[var(--border)]', 'bg-[var(--bg-muted)]', 'text-[var(--text-primary)]', 'font-medium');
            t.classList.add('border-transparent', 'text-[var(--text-secondary)]');
          });
          tab.classList.add('active', 'border-[var(--border)]', 'bg-[var(--bg-muted)]', 'text-[var(--text-primary)]', 'font-medium');
          tab.classList.remove('border-transparent', 'text-[var(--text-secondary)]');

          const type = tab.getAttribute('data-type');
          if (type === 'default') {
            activeTemplate = rawTemplate;
          } else {
            activeTemplate = tab.getAttribute('data-alt-command') || rawTemplate;
          }
          updateText();
        });
      });
    });

    // Global Keyboard Shortcut: S to toggle save on currently hovered card
    let hoveredEntry = null;
    entries.forEach(entry => {
      entry.addEventListener('mouseenter', () => { hoveredEntry = entry; });
      entry.addEventListener('mouseleave', () => { if (hoveredEntry === entry) hoveredEntry = null; });
    });

    window.addEventListener('keydown', (e) => {
      const isInput = document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'TEXTAREA';
      if (isInput) return;

      if (e.key.toLowerCase() === 's' && !e.ctrlKey && !e.metaKey && hoveredEntry) {
        e.preventDefault();
        const id = hoveredEntry.getAttribute('data-id');
        if (id) {
          toggleSave(id, hoveredEntry);
        }
      }
    });
  })();
</script>
