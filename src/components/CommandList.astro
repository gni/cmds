---
import { COMMANDS } from '../data/commands';
import { CATEGORIES } from '../data/categories';

const platformLabel = {
  all: 'Universal',
  linux: 'Linux',
  macos: 'macOS',
  windows: 'Windows'
};
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Navigation Sidebar (Sticky) -->
    <aside class="hidden lg:block lg:col-span-3 sticky top-20 space-y-1 text-xs font-mono">
      <div class="text-[11px] font-semibold text-[var(--text-muted)] uppercase tracking-wider mb-2 px-2">
        Categories
      </div>
      <button
        type="button"
        class="category-nav-btn active w-full text-left px-2.5 py-1.5 rounded-md font-medium bg-[var(--bg-muted)] text-[var(--text-primary)] cursor-pointer transition-colors"
        data-category="all"
      >
        All Commands ({COMMANDS.length})
      </button>

      {CATEGORIES.map(cat => (
        <button
          type="button"
          class="category-nav-btn w-full text-left px-2.5 py-1.5 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] cursor-pointer transition-colors flex items-center justify-between"
          data-category={cat.id}
        >
          <span>{cat.name}</span>
          <span class="text-[var(--text-muted)] text-[10px]">
            {COMMANDS.filter(c => c.category === cat.id).length}
          </span>
        </button>
      ))}
    </aside>

    <!-- Main Content Area: Commands List -->
    <main class="lg:col-span-9 space-y-6" id="commands-container">
      {COMMANDS.map((cmd) => (
        <article
          id={cmd.id}
          class="command-entry border border-[var(--border)] bg-[var(--bg)] rounded-lg p-5 transition-colors"
          data-id={cmd.id}
          data-platforms={JSON.stringify(cmd.platforms)}
          data-category={cmd.category}
          data-title={cmd.title.toLowerCase()}
          data-description={cmd.description.toLowerCase()}
          data-command-raw={cmd.command}
          data-tags={JSON.stringify(cmd.tags)}
          data-danger={cmd.dangerLevel}
        >
          <!-- Entry Header -->
          <div class="flex items-center justify-between gap-3 mb-2 text-xs font-mono text-[var(--text-muted)]">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-[var(--text-primary)] font-medium">{cmd.category}</span>
              <span>/</span>
              <span>{cmd.platforms.map(p => platformLabel[p] || p).join(', ')}</span>

              {cmd.dangerLevel !== 'safe' && (
                <>
                  <span>/</span>
                  <span class="text-amber-600 dark:text-amber-400 font-medium">
                    {cmd.dangerLevel === 'dangerous' ? 'Root required' : 'Caution'}
                  </span>
                </>
              )}
            </div>

            <!-- Save Bookmark Button -->
            <button
              type="button"
              class="entry-save-btn text-xs font-mono text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-colors"
              data-id={cmd.id}
            >
              <span class="save-label">Save</span>
            </button>
          </div>

          <!-- Title and Description -->
          <h2 class="text-base font-semibold text-[var(--text-primary)] tracking-tight mb-1.5">
            <a href={`#${cmd.id}`} class="hover:underline">
              {cmd.title}
            </a>
          </h2>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
            {cmd.description}
          </p>

          <!-- Alternative OS Syntax Switcher (if available) -->
          {cmd.alternatives && cmd.alternatives.length > 0 && (
            <div class="flex items-center gap-1.5 mb-2.5 text-xs font-mono">
              <span class="text-[var(--text-muted)]">Variant:</span>
              <button
                type="button"
                class="variant-tab active px-2 py-0.5 rounded border border-[var(--border)] bg-[var(--bg-muted)] text-[var(--text-primary)] font-medium cursor-pointer"
                data-type="default"
              >
                Default
              </button>
              {cmd.alternatives.map((alt, idx) => (
                <button
                  type="button"
                  class="variant-tab px-2 py-0.5 rounded border border-transparent hover:border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-colors"
                  data-type={`alt-${idx}`}
                  data-alt-command={alt.command}
                  data-alt-platform={alt.platform}
                >
                  {alt.platform === 'windows' ? 'PowerShell' : alt.platform === 'macos' ? 'macOS BSD' : alt.platform}
                </button>
              ))}
            </div>
          )}

          <!-- Code Box -->
          <div class="code-box rounded-md p-3.5 font-mono text-xs mb-3">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 select-all overflow-x-auto whitespace-pre-wrap break-all leading-relaxed">
                <span class="text-slate-400 select-none mr-2 font-bold">$</span>
                <span class="command-text-content" data-template={cmd.command}>
                  {cmd.command}
                </span>
              </div>

              <button
                type="button"
                class="entry-copy-btn shrink-0 px-2.5 py-1 rounded border border-slate-700 hover:border-slate-500 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-mono transition-colors cursor-pointer"
                title="Copy command to clipboard"
              >
                <span class="copy-text">Copy</span>
              </button>
            </div>

            <!-- Parameters Inputs -->
            {cmd.params && cmd.params.length > 0 && (
              <div class="mt-3 pt-2.5 border-t border-slate-800 flex flex-wrap items-center gap-2 text-xs">
                <span class="text-slate-400 text-[11px] select-none">Variables:</span>
                {cmd.params.map(p => (
                  <div class="flex items-center gap-1.5 bg-slate-900 border border-slate-700 px-2 py-0.5 rounded">
                    <label for={`p-${cmd.id}-${p.name}`} class="text-slate-400 text-[11px]">{p.label}:</label>
                    <input
                      id={`p-${cmd.id}-${p.name}`}
                      type="text"
                      class="param-input bg-transparent text-white font-mono text-xs outline-none w-24 font-medium"
                      data-param-name={p.name}
                      value={p.default}
                      placeholder={p.placeholder || p.default}
                    />
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Note / Pro-tip -->
          {cmd.proTip && (
            <div class="text-xs font-mono text-[var(--text-secondary)] mb-3 pl-3 border-l-2 border-[var(--border-focus)]">
              <span class="font-semibold text-[var(--text-primary)]">Note:</span> {cmd.proTip}
            </div>
          )}

          <!-- Example output disclosure -->
          {cmd.outputExample && (
            <details class="text-xs font-mono mb-2">
              <summary class="text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer select-none">
                View example output
              </summary>
              <pre class="mt-2 p-3 bg-[var(--bg-subtle)] border border-[var(--border)] rounded text-[var(--text-secondary)] overflow-x-auto whitespace-pre leading-relaxed">{cmd.outputExample}</pre>
            </details>
          )}

          <!-- Tags -->
          <div class="pt-2 flex items-center gap-2 text-[11px] font-mono text-[var(--text-muted)]">
            {cmd.tags.map(tag => (
              <button
                type="button"
                class="tag-link hover:text-[var(--text-primary)] transition-colors cursor-pointer"
                data-tag={tag}
              >
                #{tag}
              </button>
            ))}
          </div>
        </article>
      ))}

      <!-- Empty State -->
      <div id="empty-results-state" class="hidden py-16 text-center border border-[var(--border)] rounded-lg p-6 bg-[var(--bg-subtle)]">
        <p class="text-sm font-semibold text-[var(--text-primary)] mb-1">No matching commands found</p>
        <p class="text-xs text-[var(--text-muted)] mb-4">Try checking your spelling or clearing active filters.</p>
        <button
          id="clear-all-filters-btn"
          type="button"
          class="px-3 py-1.5 rounded bg-[var(--accent)] text-[var(--accent-text)] text-xs font-mono cursor-pointer"
        >
          Reset all filters
        </button>
      </div>
    </main>
  </div>
</div>

<script is:inline>
  (function() {
    let currentQuery = '';
    let currentPlatform = 'all';
    let currentCategory = 'all';
    let favorites = [];

    try {
      favorites = JSON.parse(localStorage.getItem('brain_cmds_favorites') || '[]');
    } catch (e) {
      favorites = [];
    }

    const entries = Array.from(document.querySelectorAll('.command-entry'));
    const searchInput = document.getElementById('main-search-input');
    const clearBtn = document.getElementById('main-clear-search-btn');
    const osPills = document.querySelectorAll('.os-filter-pill');
    const catNavBtns = document.querySelectorAll('.category-nav-btn');
    const emptyState = document.getElementById('empty-results-state');
    const clearFiltersBtn = document.getElementById('clear-all-filters-btn');
    const savedCountText = document.getElementById('saved-count-text');

    function updateFavorites() {
      if (savedCountText) savedCountText.textContent = String(favorites.length);
      entries.forEach(entry => {
        const id = entry.getAttribute('data-id');
        const saveLabel = entry.querySelector('.save-label');
        if (saveLabel) {
          if (favorites.includes(id)) {
            saveLabel.textContent = 'Saved ★';
            saveLabel.classList.add('font-semibold', 'text-amber-600', 'dark:text-amber-400');
          } else {
            saveLabel.textContent = 'Save';
            saveLabel.classList.remove('font-semibold', 'text-amber-600', 'dark:text-amber-400');
          }
        }
      });
    }
    updateFavorites();

    function applyFilters() {
      const q = currentQuery.toLowerCase().trim();
      let visibleCount = 0;

      entries.forEach(entry => {
        const id = entry.getAttribute('data-id');
        const title = entry.getAttribute('data-title') || '';
        const desc = entry.getAttribute('data-description') || '';
        const rawCmd = entry.getAttribute('data-command-raw') || '';
        const tags = JSON.parse(entry.getAttribute('data-tags') || '[]');
        const platforms = JSON.parse(entry.getAttribute('data-platforms') || '[]');
        const category = entry.getAttribute('data-category');

        const matchQuery = !q || title.includes(q) || desc.includes(q) || rawCmd.toLowerCase().includes(q) || tags.some(t => t.includes(q));

        let matchPlatform = false;
        if (currentPlatform === 'all') matchPlatform = true;
        else if (currentPlatform === 'favorites') matchPlatform = favorites.includes(id);
        else matchPlatform = platforms.includes('all') || platforms.includes(currentPlatform);

        const matchCategory = (currentCategory === 'all') || (category === currentCategory);

        if (matchQuery && matchPlatform && matchCategory) {
          entry.classList.remove('hidden');
          visibleCount++;
        } else {
          entry.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    }

    // Search Input
    searchInput?.addEventListener('input', (e) => {
      currentQuery = e.target.value;
      if (clearBtn) {
        if (currentQuery) clearBtn.classList.remove('hidden');
        else clearBtn.classList.add('hidden');
      }
      applyFilters();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentQuery = '';
      clearBtn.classList.add('hidden');
      searchInput?.focus();
      applyFilters();
    });

    // OS Filter Pills
    osPills.forEach(pill => {
      pill.addEventListener('click', () => {
        osPills.forEach(p => {
          p.classList.remove('active', 'bg-[var(--accent)]', 'text-[var(--accent-text)]', 'border-[var(--accent)]');
          p.classList.add('bg-[var(--bg-subtle)]', 'text-[var(--text-secondary)]', 'border-[var(--border)]');
        });
        pill.classList.add('active', 'bg-[var(--accent)]', 'text-[var(--accent-text)]', 'border-[var(--accent)]');
        pill.classList.remove('bg-[var(--bg-subtle)]', 'text-[var(--text-secondary)]', 'border-[var(--border)]');
        currentPlatform = pill.getAttribute('data-platform') || 'all';
        applyFilters();
      });
    });

    // Category Nav Buttons
    catNavBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catNavBtns.forEach(b => {
          b.classList.remove('active', 'bg-[var(--bg-muted)]', 'text-[var(--text-primary)]', 'font-medium');
          b.classList.add('text-[var(--text-secondary)]');
        });
        btn.classList.add('active', 'bg-[var(--bg-muted)]', 'text-[var(--text-primary)]', 'font-medium');
        btn.classList.remove('text-[var(--text-secondary)]');
        currentCategory = btn.getAttribute('data-category') || 'all';
        applyFilters();
      });
    });

    // Reset all
    function resetAllFilters() {
      if (searchInput) searchInput.value = '';
      currentQuery = '';
      currentPlatform = 'all';
      currentCategory = 'all';
      clearBtn?.classList.add('hidden');

      osPills.forEach((p, i) => {
        if (i === 0) {
          p.classList.add('active', 'bg-[var(--accent)]', 'text-[var(--accent-text)]', 'border-[var(--accent)]');
          p.classList.remove('bg-[var(--bg-subtle)]', 'text-[var(--text-secondary)]', 'border-[var(--border)]');
        } else {
          p.classList.remove('active', 'bg-[var(--accent)]', 'text-[var(--accent-text)]', 'border-[var(--accent)]');
          p.classList.add('bg-[var(--bg-subtle)]', 'text-[var(--text-secondary)]', 'border-[var(--border)]');
        }
      });

      catNavBtns.forEach((b, i) => {
        if (i === 0) {
          b.classList.add('active', 'bg-[var(--bg-muted)]', 'text-[var(--text-primary)]', 'font-medium');
          b.classList.remove('text-[var(--text-secondary)]');
        } else {
          b.classList.remove('active', 'bg-[var(--bg-muted)]', 'text-[var(--text-primary)]', 'font-medium');
          b.classList.add('text-[var(--text-secondary)]');
        }
      });

      applyFilters();
    }

    clearFiltersBtn?.addEventListener('click', resetAllFilters);

    // Tag links click
    document.querySelectorAll('.tag-link').forEach(link => {
      link.addEventListener('click', () => {
        const tag = link.getAttribute('data-tag');
        if (tag && searchInput) {
          searchInput.value = tag;
          currentQuery = tag;
          clearBtn?.classList.remove('hidden');
          searchInput.focus();
          applyFilters();
        }
      });
    });

    // Command Entry Logic: Parameters, Copy, Save, Variants
    entries.forEach(entry => {
      const renderEl = entry.querySelector('.command-text-content');
      const rawTemplate = renderEl?.getAttribute('data-template') || '';
      const paramInputs = entry.querySelectorAll('.param-input');
      const copyBtn = entry.querySelector('.entry-copy-btn');
      const copyText = entry.querySelector('.copy-text');
      const saveBtn = entry.querySelector('.entry-save-btn');
      const variantTabs = entry.querySelectorAll('.variant-tab');
      const id = entry.getAttribute('data-id');

      let activeTemplate = rawTemplate;

      function computeCommand() {
        let cmd = activeTemplate;
        paramInputs.forEach(input => {
          const name = input.getAttribute('data-param-name');
          const val = input.value || input.placeholder || '';
          const regex = new RegExp(`\\{\\{${name}\\}\\}`, 'g');
          cmd = cmd.replace(regex, val);
        });
        return cmd;
      }

      function updateText() {
        if (renderEl) {
          renderEl.textContent = computeCommand();
        }
      }

      paramInputs.forEach(input => {
        input.addEventListener('input', updateText);
      });

      // Copy Action
      copyBtn?.addEventListener('click', () => {
        const finalCmd = computeCommand();
        navigator.clipboard.writeText(finalCmd).then(() => {
          if (copyText) copyText.textContent = 'Copied!';
          copyBtn.classList.add('bg-emerald-700', 'border-emerald-600', 'text-white');

          setTimeout(() => {
            if (copyText) copyText.textContent = 'Copy';
            copyBtn.classList.remove('bg-emerald-700', 'border-emerald-600', 'text-white');
          }, 1400);
        });
      });

      // Save Action
      saveBtn?.addEventListener('click', () => {
        const isFav = favorites.includes(id);
        if (isFav) {
          favorites = favorites.filter(f => f !== id);
        } else {
          favorites.push(id);
        }
        try {
          localStorage.setItem('brain_cmds_favorites', JSON.stringify(favorites));
        } catch (e) {}
        updateFavorites();
        if (currentPlatform === 'favorites') {
          applyFilters();
        }
      });

      // Variant Tab Switcher
      variantTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          variantTabs.forEach(t => {
            t.classList.remove('active', 'border-[var(--border)]', 'bg-[var(--bg-muted)]', 'text-[var(--text-primary)]', 'font-medium');
            t.classList.add('border-transparent', 'text-[var(--text-secondary)]');
          });
          tab.classList.add('active', 'border-[var(--border)]', 'bg-[var(--bg-muted)]', 'text-[var(--text-primary)]', 'font-medium');
          tab.classList.remove('border-transparent', 'text-[var(--text-secondary)]');

          const type = tab.getAttribute('data-type');
          if (type === 'default') {
            activeTemplate = rawTemplate;
          } else {
            activeTemplate = tab.getAttribute('data-alt-command') || rawTemplate;
          }
          updateText();
        });
      });
    });
  })();
</script>
