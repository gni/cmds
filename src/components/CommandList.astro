---
import { COMMANDS } from '../data/commands';
import { CATEGORIES } from '../data/categories';

const platformLabel = {
  all: 'Universal',
  linux: 'Linux',
  macos: 'macOS',
  windows: 'Windows'
};
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Navigation Sidebar (Sticky) -->
    <aside class="hidden lg:block lg:col-span-3 sticky top-20 space-y-1 text-xs font-mono">
      <div class="text-[11px] font-semibold text-[var(--text-muted)] uppercase tracking-wider mb-2 px-2">
        Categories
      </div>
      <button
        type="button"
        class="category-nav-btn active w-full text-left px-2.5 py-1.5 rounded-md font-medium bg-[var(--bg-muted)] text-[var(--text-primary)] cursor-pointer transition-colors"
        data-category="all"
      >
        All Commands ({COMMANDS.length})
      </button>

      {CATEGORIES.map(cat => (
        <button
          type="button"
          class="category-nav-btn w-full text-left px-2.5 py-1.5 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] cursor-pointer transition-colors flex items-center justify-between"
          data-category={cat.id}
        >
          <span>{cat.name}</span>
          <span class="text-[var(--text-muted)] text-[10px]">
            {COMMANDS.filter(c => c.category === cat.id).length}
          </span>
        </button>
      ))}
    </aside>

    <!-- Main Content Area: Commands List -->
    <main class="lg:col-span-9 space-y-6" id="commands-container">
      {COMMANDS.map((cmd) => (
        <article
          id={cmd.id}
          class="command-entry border border-[var(--border)] bg-[var(--bg)] rounded-lg p-5 transition-colors"
          data-id={cmd.id}
          data-platforms={JSON.stringify(cmd.platforms)}
          data-category={cmd.category}
          data-title={cmd.title.toLowerCase()}
          data-description={cmd.description.toLowerCase()}
          data-command-raw={cmd.command}
          data-tags={JSON.stringify(cmd.tags)}
          data-danger={cmd.dangerLevel}
        >
          <!-- Entry Header -->
          <div class="flex items-center justify-between gap-3 mb-2 text-xs font-mono text-[var(--text-muted)]">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-[var(--text-primary)] font-medium">{cmd.category}</span>
              <span>/</span>
              <span>{cmd.platforms.map(p => platformLabel[p] || p).join(', ')}</span>

              {cmd.dangerLevel !== 'safe' && (
                <>
                  <span>/</span>
                  <span class="text-amber-600 dark:text-amber-400 font-medium">
                    {cmd.dangerLevel === 'dangerous' ? 'Root required' : 'Caution'}
                  </span>
                </>
              )}
            </div>

            <!-- Save Bookmark Button -->
            <button
              type="button"
              class="entry-save-btn text-xs font-mono text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-colors"
              data-id={cmd.id}
            >
              <span class="save-label">Save</span>
            </button>
          </div>

          <!-- Title and Description -->
          <h2 class="text-base font-semibold text-[var(--text-primary)] tracking-tight mb-1.5">
            <a href={`#${cmd.id}`} class="hover:underline">
              {cmd.title}
            </a>
          </h2>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
            {cmd.description}
          </p>

          <!-- Alternative OS Syntax Switcher (if available) -->
          {cmd.alternatives && cmd.alternatives.length > 0 && (
            <div class="flex items-center gap-1.5 mb-2.5 text-xs font-mono">
              <span class="text-[var(--text-muted)]">Variant:</span>
              <button
                type="button"
                class="variant-tab active px-2 py-0.5 rounded border border-[var(--border)] bg-[var(--bg-muted)] text-[var(--text-primary)] font-medium cursor-pointer"
                data-type="default"
              >
                Default
              </button>
              {cmd.alternatives.map((alt, idx) => (
                <button
                  type="button"
                  class="variant-tab px-2 py-0.5 rounded border border-transparent hover:border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-colors"
                  data-type={`alt-${idx}`}
                  data-alt-command={alt.command}
                  data-alt-platform={alt.platform}
                >
                  {alt.platform === 'windows' ? 'PowerShell' : alt.platform === 'macos' ? 'macOS BSD' : alt.platform}
                </button>
              ))}
            </div>
          )}

          <!-- Code Box -->
          <div class="code-box rounded-md p-3.5 font-mono text-xs mb-3">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 select-all overflow-x-auto whitespace-pre-wrap break-all leading-relaxed">
                <span class="text-slate-400 select-none mr-2 font-bold">$</span>
                <span class="command-text-content" data-template={cmd.command}>
                  {cmd.command}
                </span>
              </div>

              <div class="flex items-center gap-1.5 shrink-0">
                <button
                  type="button"
                  class="entry-simulate-btn px-2.5 py-1 rounded-md border border-slate-700/80 hover:border-sky-500/80 bg-slate-800/90 hover:bg-slate-700/90 text-slate-200 hover:text-sky-300 text-xs font-mono transition-all cursor-pointer flex items-center gap-1.5 shadow-xs active:scale-[0.96]"
                  title="Simulate command execution in terminal preview"
                  data-output={cmd.outputExample || ''}
                >
                  <svg class="w-3 h-3 text-sky-400 fill-current" viewBox="0 0 24 24">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                  <span class="sim-text">Simulate ↵</span>
                </button>

                <button
                  type="button"
                  class="entry-copy-btn px-2.5 py-1 rounded-md border border-slate-700/80 hover:border-slate-500 bg-slate-800/90 hover:bg-slate-700/90 text-slate-200 hover:text-white text-xs font-mono transition-all cursor-pointer flex items-center gap-1.5 shadow-xs active:scale-[0.96]"
                  title="Copy command to clipboard"
                >
                  <svg class="copy-icon w-3.5 h-3.5 text-slate-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <svg class="check-icon hidden w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span class="copy-text">Copy</span>
                </button>
              </div>
            </div>

            <!-- Parameters Inputs -->
            {cmd.params && cmd.params.length > 0 && (
              <div class="mt-3 pt-2.5 border-t border-slate-800 flex flex-wrap items-center gap-2 text-xs">
                <span class="text-slate-400 text-[11px] select-none">Variables:</span>
                {cmd.params.map(p => (
                  <div class="flex items-center gap-1.5 bg-slate-900 border border-slate-700 px-2 py-0.5 rounded">
                    <label for={`p-${cmd.id}-${p.name}`} class="text-slate-400 text-[11px]">{p.label}:</label>
                    <input
                      id={`p-${cmd.id}-${p.name}`}
                      type="text"
                      class="param-input bg-transparent text-white font-mono text-xs outline-none w-24 font-medium"
                      data-param-name={p.name}
                      value={p.default}
                      placeholder={p.placeholder || p.default}
                    />
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Note / Pro-tip -->
          {cmd.proTip && (
            <div class="text-xs font-mono text-[var(--text-secondary)] mb-3 pl-3 border-l-2 border-[var(--border-focus)]">
              <span class="font-semibold text-[var(--text-primary)]">Note:</span> {cmd.proTip}
            </div>
          )}

          <!-- Example output disclosure -->
          {cmd.outputExample && (
            <details class="text-xs font-mono mb-2 group">
              <summary class="text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer select-none inline-flex items-center gap-1.5 py-0.5 transition-colors">
                <svg class="w-3 h-3 transition-transform duration-150 group-open:rotate-90 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <span>View example output</span>
              </summary>
              <pre class="mt-2 p-3 bg-[var(--bg-subtle)] border border-[var(--border)] rounded text-[var(--text-secondary)] overflow-x-auto whitespace-pre leading-relaxed">{cmd.outputExample}</pre>
            </details>
          )}

          <!-- Tags -->
          <div class="pt-2 flex items-center gap-2 text-[11px] font-mono text-[var(--text-muted)]">
            {cmd.tags.map(tag => (
              <button
                type="button"
                class="tag-link hover:text-[var(--text-primary)] transition-colors cursor-pointer"
                data-tag={tag}
              >
                #{tag}
              </button>
            ))}
          </div>
        </article>
      ))}

      <!-- Empty State -->
      <div id="empty-results-state" class="hidden py-16 text-center border border-[var(--border)] rounded-lg p-6 bg-[var(--bg-subtle)]">
        <p class="text-sm font-semibold text-[var(--text-primary)] mb-1">No matching commands found</p>
        <p class="text-xs text-[var(--text-muted)] mb-4">Try checking your spelling or clearing active filters.</p>
        <button
          id="clear-all-filters-btn"
          type="button"
          class="px-3 py-1.5 rounded bg-[var(--accent)] text-[var(--accent-text)] text-xs font-mono cursor-pointer"
        >
          Reset all filters
        </button>
      </div>
    </main>
  </div>
</div>

<script is:inline>
  (function() {
    let currentQuery = '';
    let currentPlatform = 'all';
    let currentCategory = 'all';
    let favorites = [];

    try {
      favorites = JSON.parse(localStorage.getItem('brain_cmds_favorites') || '[]');
    } catch (e) {
      favorites = [];
    }

    const entries = Array.from(document.querySelectorAll('.command-entry'));
    const searchInput = document.getElementById('main-search-input');
    const clearBtn = document.getElementById('main-clear-search-btn');
    const osPills = document.querySelectorAll('.os-filter-pill');
    const catNavBtns = document.querySelectorAll('.category-nav-btn');
    const emptyState = document.getElementById('empty-results-state');
    const clearFiltersBtn = document.getElementById('clear-all-filters-btn');
    const savedCountText = document.getElementById('saved-count-text');

    function updateFavorites() {
      if (savedCountText) savedCountText.textContent = String(favorites.length);
      entries.forEach(entry => {
        const id = entry.getAttribute('data-id');
        const saveLabel = entry.querySelector('.save-label');
        if (saveLabel) {
          if (favorites.includes(id)) {
            saveLabel.textContent = 'Saved ★';
            saveLabel.classList.add('font-semibold', 'text-amber-600', 'dark:text-amber-400');
          } else {
            saveLabel.textContent = 'Save';
            saveLabel.classList.remove('font-semibold', 'text-amber-600', 'dark:text-amber-400');
          }
        }
      });
    }
    updateFavorites();

    function applyFilters() {
      const q = currentQuery.toLowerCase().trim();
      let visibleCount = 0;

      entries.forEach(entry => {
        const id = entry.getAttribute('data-id');
        const title = entry.getAttribute('data-title') || '';
        const desc = entry.getAttribute('data-description') || '';
        const rawCmd = entry.getAttribute('data-command-raw') || '';
        const tags = JSON.parse(entry.getAttribute('data-tags') || '[]');
        const platforms = JSON.parse(entry.getAttribute('data-platforms') || '[]');
        const category = entry.getAttribute('data-category');

        const matchQuery = !q || title.includes(q) || desc.includes(q) || rawCmd.toLowerCase().includes(q) || tags.some(t => t.includes(q));

        let matchPlatform = false;
        if (currentPlatform === 'all') matchPlatform = true;
        else if (currentPlatform === 'favorites') matchPlatform = favorites.includes(id);
        else matchPlatform = platforms.includes('all') || platforms.includes(currentPlatform);

        const matchCategory = (currentCategory === 'all') || (category === currentCategory);

        if (matchQuery && matchPlatform && matchCategory) {
          entry.classList.remove('hidden');
          visibleCount++;
        } else {
          entry.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    }

    // Search Input
    searchInput?.addEventListener('input', (e) => {
      currentQuery = e.target.value;
      if (clearBtn) {
        if (currentQuery) clearBtn.classList.remove('hidden');
        else clearBtn.classList.add('hidden');
      }
      applyFilters();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentQuery = '';
      clearBtn.classList.add('hidden');
      searchInput?.focus();
      applyFilters();
    });

    // OS Filter Pills
    osPills.forEach(pill => {
      pill.addEventListener('click', () => {
        osPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentPlatform = pill.getAttribute('data-platform') || 'all';
        applyFilters();
      });
    });

    // Category Nav Buttons
    catNavBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catNavBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategory = btn.getAttribute('data-category') || 'all';
        applyFilters();
      });
    });

    // Reset all
    function resetAllFilters() {
      if (searchInput) searchInput.value = '';
      currentQuery = '';
      currentPlatform = 'all';
      currentCategory = 'all';
      clearBtn?.classList.add('hidden');

      osPills.forEach((p, i) => {
        if (i === 0) p.classList.add('active');
        else p.classList.remove('active');
      });

      catNavBtns.forEach((b, i) => {
        if (i === 0) b.classList.add('active');
        else b.classList.remove('active');
      });

      applyFilters();
    }

    clearFiltersBtn?.addEventListener('click', resetAllFilters);

    // Tag links click
    document.querySelectorAll('.tag-link').forEach(link => {
      link.addEventListener('click', () => {
        const tag = link.getAttribute('data-tag');
        if (tag && searchInput) {
          searchInput.value = tag;
          currentQuery = tag;
          clearBtn?.classList.remove('hidden');
          searchInput.focus();
          applyFilters();
        }
      });
    });

    function generateOutputFor(cmd, defaultOutput) {
      if (defaultOutput && defaultOutput.trim()) {
        return defaultOutput.trim();
      }
      const c = cmd.trim().toLowerCase();
      if (c.startsWith('git status')) {
        return "On branch main\nYour branch is up to date with 'origin/main'.\n\nnothing to commit, working tree clean";
      }
      if (c.startsWith('git log')) {
        return "* 6378fc3 (HEAD -> main) feat: complete human-crafted documentation\n* d117a22 feat: add multi-stage docker compose for dev and test\n* 6458d57 feat: complete cmds terminal catalog";
      }
      if (c.startsWith('git diff')) {
        return "diff --git a/server.js b/server.js\n--- a/server.js\n+++ b/server.js\n@@ -12,3 +12,3 @@\n-const PORT = 3000;\n+const PORT = 8080;";
      }
      if (c.startsWith('git push')) {
        return "Enumerating objects: 7, done.\nWriting objects: 100% (4/4), 620 bytes | 620.00 KiB/s, done.\nTo github.com:gni/cmds.git\n   6378fc3..9fa210b  main -> main";
      }
      if (c.startsWith('git checkout') || c.startsWith('git switch')) {
        return "Switched to branch 'feature/streamlined-terminal'";
      }
      if (c.startsWith('docker ps')) {
        return "CONTAINER ID   IMAGE          COMMAND                  CREATED         STATUS         PORTS                    NAMES\n7f820c4e1a09   nginx:alpine   \"/docker-entrypoint.…\"   5 minutes ago   Up 5 minutes   0.0.0.0:8080->80/tcp   cmds-preview";
      }
      if (c.startsWith('docker logs')) {
        return "2026-09-10 22:30:00 [notice] 1#1: using the \"epoll\" event method\n2026-09-10 22:30:00 [notice] 1#1: nginx/1.27.0\n2026-09-10 22:30:00 [notice] 1#1: start worker processes\n2026-09-10 22:30:01 [info] GET /cmds HTTP/1.1 200 - 1.2ms";
      }
      if (c.startsWith('kubectl get pods') || c.startsWith('kubectl get po')) {
        return "NAME                           READY   STATUS    RESTARTS   AGE\ncmds-frontend-674bb8c5f-x9l2k  1/1     Running   0          42m\ncmds-frontend-674bb8c5f-z4m8p  1/1     Running   0          42m\ncmds-api-5d7594dfc4-v7b1q      1/1     Running   0          1h";
      }
      if (c.startsWith('curl') || c.startsWith('wget')) {
        return "HTTP/2 200 OK\ncontent-type: application/json; charset=utf-8\ncache-control: public, max-age=3600\ndate: Thu, 10 Sep 2026 22:30:00 GMT\n\n{\"status\":\"healthy\",\"region\":\"cdg1\",\"latency\":\"14ms\"}";
      }
      if (c.startsWith('ping')) {
        return "PING brain.fr (198.51.100.42): 56 data bytes\n64 bytes from 198.51.100.42: icmp_seq=0 ttl=57 time=14.2 ms\n64 bytes from 198.51.100.42: icmp_seq=1 ttl=57 time=13.8 ms\n64 bytes from 198.51.100.42: icmp_seq=2 ttl=57 time=14.0 ms\n--- brain.fr ping statistics ---\n3 packets transmitted, 3 packets received, 0.0% packet loss";
      }
      if (c.startsWith('df') || c.startsWith('du')) {
        return "Filesystem      Size  Used Avail Use% Mounted on\n/dev/nvme0n1p2  468G  142G  303G  32% /\ntmpfs            16G  1.2M   16G   1% /run";
      }
      if (c.startsWith('free') || c.startsWith('top') || c.startsWith('htop')) {
        return "               total        used        free      shared  buff/cache   available\nMem:        32768Mi      8192Mi     21456Mi       128Mi      3120Mi     24128Mi\nSwap:        8192Mi           0      8192Mi";
      }
      if (c.startsWith('tar') || c.startsWith('zip') || c.startsWith('unzip')) {
        return "a archive.tar.gz\na dist/index.html\na dist/assets/index.css\na dist/favicon.svg\nCompleted in 0.18s";
      }
      if (c.startsWith('find') || c.startsWith('grep') || c.startsWith('rg')) {
        return "src/components/Hero.astro:14: <div id=\"terminal-simulator-anchor\">\nsrc/components/CommandList.astro:48: <button class=\"entry-simulate-btn\">\nsrc/styles/global.css:82: .terminal-window { background: #0b0f17; }\n3 matches across 3 files";
      }
      if (c.startsWith('chmod') || c.startsWith('chown') || c.startsWith('mkdir') || c.startsWith('rm') || c.startsWith('mv') || c.startsWith('cp')) {
        return "✓ Command executed successfully with exit code 0.";
      }
      return `✓ Process exited with code 0\nDone in 0.12s.`;
    }

    // Command Entry Logic: Parameters, Copy, Save, Variants
    entries.forEach(entry => {
      const renderEl = entry.querySelector('.command-text-content');
      const rawTemplate = renderEl?.getAttribute('data-template') || '';
      const paramInputs = entry.querySelectorAll('.param-input');
      const copyBtn = entry.querySelector('.entry-copy-btn');
      const copyText = entry.querySelector('.copy-text');
      const simBtn = entry.querySelector('.entry-simulate-btn');
      const simText = entry.querySelector('.sim-text');
      const defaultOutput = simBtn?.getAttribute('data-output') || '';
      const saveBtn = entry.querySelector('.entry-save-btn');
      const variantTabs = entry.querySelectorAll('.variant-tab');
      const id = entry.getAttribute('data-id');

      let activeTemplate = rawTemplate;

      function computeCommand() {
        let cmd = activeTemplate;
        paramInputs.forEach(input => {
          const name = input.getAttribute('data-param-name');
          const val = input.value || input.placeholder || '';
          const regex = new RegExp(`\\{\\{${name}\\}\\}`, 'g');
          cmd = cmd.replace(regex, val);
        });
        return cmd;
      }

      function updateText() {
        if (renderEl) {
          renderEl.textContent = computeCommand();
        }
      }

      paramInputs.forEach(input => {
        input.addEventListener('input', updateText);
      });

      // Simulate Action
      simBtn?.addEventListener('click', () => {
        const finalCmd = computeCommand();
        const output = generateOutputFor(finalCmd, defaultOutput);

        if (simText) simText.textContent = 'Simulating...';
        simBtn.classList.add('border-sky-500', 'text-sky-300');

        if (window.runInTerminal) {
          window.runInTerminal(finalCmd, output, true);
        }

        setTimeout(() => {
          if (simText) simText.textContent = 'Executed ✓';
          setTimeout(() => {
            if (simText) simText.textContent = 'Simulate ↵';
            simBtn.classList.remove('border-sky-500', 'text-sky-300');
          }, 1400);
        }, 500);
      });

      // Copy Action
      copyBtn?.addEventListener('click', () => {
        const finalCmd = computeCommand();
        navigator.clipboard.writeText(finalCmd).then(() => {
          const copyIcon = copyBtn.querySelector('.copy-icon');
          const checkIcon = copyBtn.querySelector('.check-icon');

          if (copyText) copyText.textContent = 'Copied!';
          if (copyIcon) copyIcon.classList.add('hidden');
          if (checkIcon) checkIcon.classList.remove('hidden');
          copyBtn.classList.add('bg-emerald-950/80', 'border-emerald-500/80', 'text-emerald-300');

          setTimeout(() => {
            if (copyText) copyText.textContent = 'Copy';
            if (copyIcon) copyIcon.classList.remove('hidden');
            if (checkIcon) checkIcon.classList.add('hidden');
            copyBtn.classList.remove('bg-emerald-950/80', 'border-emerald-500/80', 'text-emerald-300');
          }, 1400);
        });
      });

      // Save Action
      saveBtn?.addEventListener('click', () => {
        const isFav = favorites.includes(id);
        if (isFav) {
          favorites = favorites.filter(f => f !== id);
        } else {
          favorites.push(id);
        }
        try {
          localStorage.setItem('brain_cmds_favorites', JSON.stringify(favorites));
        } catch (e) {}
        updateFavorites();
        if (currentPlatform === 'favorites') {
          applyFilters();
        }
      });

      // Variant Tab Switcher
      variantTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          variantTabs.forEach(t => {
            t.classList.remove('active', 'border-[var(--border)]', 'bg-[var(--bg-muted)]', 'text-[var(--text-primary)]', 'font-medium');
            t.classList.add('border-transparent', 'text-[var(--text-secondary)]');
          });
          tab.classList.add('active', 'border-[var(--border)]', 'bg-[var(--bg-muted)]', 'text-[var(--text-primary)]', 'font-medium');
          tab.classList.remove('border-transparent', 'text-[var(--text-secondary)]');

          const type = tab.getAttribute('data-type');
          if (type === 'default') {
            activeTemplate = rawTemplate;
          } else {
            activeTemplate = tab.getAttribute('data-alt-command') || rawTemplate;
          }
          updateText();
        });
      });
    });
  })();
</script>
