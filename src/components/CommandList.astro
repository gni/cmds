        return "2026-09-10 22:30:00 [notice] 1#1: using the \"epoll\" event method\n2026-09-10 22:30:00 [notice] 1#1: nginx/1.27.0\n2026-09-10 22:30:00 [notice] 1#1: start worker processes\n2026-09-10 22:30:01 [info] GET /cmds HTTP/1.1 200 - 1.2ms";
