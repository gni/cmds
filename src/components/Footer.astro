<footer class="w-full border-t border-[var(--brain-border-subtle)] bg-[var(--brain-surface-primary)] py-8 mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[var(--brain-text-secondary)]">
    <!-- Left: Brain Logo -->
    <div class="flex items-center gap-2 text-[var(--brain-text-primary)]">
      <svg class="w-3.5 h-3.5 text-current" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 3v18" />
        <path d="M3 12h18" />
        <circle cx="12" cy="12" r="4" />
      </svg>
      <span class="font-medium">Brain</span>
      <span class="text-[var(--brain-border-default)]">/</span>
      <span class="text-[var(--brain-text-secondary)]">brain.fr</span>
    </div>

    <!-- Right: Context and Source -->
    <div class="flex items-center gap-4 text-[var(--brain-text-tertiary)]">
      <span>Operational commands for Linux, macOS, and Windows</span>
      <span class="text-[var(--brain-border-default)] hidden sm:inline">|</span>
      <a href="https://github.com/gni/cmds" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--brain-text-primary)] transition-colors">
        github.com/gni/cmds
      </a>
    </div>
  </div>
</footer>
