    <!-- Left: Brain Branding -->
    <div class="flex items-center gap-2 text-[var(--text-primary)]">
      <svg class="w-4 h-4 text-current shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z" />
        <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z" />
        <path d="M12 5v13" />
        <path d="M12 7h1.5a2 2 0 0 1 2 2v.5" />
        <path d="M12 12h2a2 2 0 0 1 2 2v.5" />
        <path d="M12 7h-1.5a2 2 0 0 0-2 2v.5" />
